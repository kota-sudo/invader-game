// scrap=🔩スクラップ core=⚡エネルギーコア crystal=💎量子結晶 composite=🔷コンポジットコア
let materials=readStoredObject('invader_materials','{"scrap":0,"core":0,"crystal":0,"composite":0}');
function saveMaterials(){ localStorage.setItem('invader_materials',JSON.stringify(materials)); }
function addMaterial(type,n=1){
  materials[type]=(materials[type]||0)+n; saveMaterials();
  if(state==='playing'&&player){
    const icons={scrap:'🔩',core:'⚡',crystal:'💎',composite:'🔷'};
    matPopups.push({x:player.x+player.w/2+(Math.random()-0.5)*50, y:player.y, text:`+${n}${icons[type]||type}`, timer:55, vy:-0.9});
  }
}
let shopUpgrades=readStoredObject('invader_shop','{}');
SHOP_ITEMS.forEach(s=>{ if(shopUpgrades[s.id]===undefined) shopUpgrades[s.id]=0; });
let shopCursor=0, shopTab=0; // tab 0=upgrade 1=compose
function saveShop(){ localStorage.setItem('invader_shop',JSON.stringify(shopUpgrades)); }

function getUpgradeLvCost(lv){ return UPGRADE_LV_COSTS[Math.min(lv,UPGRADE_LV_COSTS.length-1)]; }
function canUpgradeShopItem(item){
  const lv=shopUpgrades[item.id]||0;
  if(lv>=SHOP_MAX_LV) return false;
  const [cost,mats,stReq]=getUpgradeLvCost(lv);
  if(highestStage<stReq) return false;
  if(coins<cost) return false;
  for(const [k,v] of Object.entries(mats)){
    if(k==='gems'){ if(gems<v) return false; }
    else if((materials[k]||0)<v) return false;
  }
  return true;
}
function applyShopUpgrade(idx){
  const item=SHOP_ITEMS[idx];
  if(!item) return;
  const lv=shopUpgrades[item.id]||0;
  if(lv>=SHOP_MAX_LV) return;
  const [cost,mats,stReq]=getUpgradeLvCost(lv);
  if(highestStage<stReq) return;
  if(coins<cost) return;
  for(const [k,v] of Object.entries(mats)){
    if(k==='gems'){ if(gems<v) return; }
    else if((materials[k]||0)<v) return;
  }
  coins-=cost; saveCoins();
  for(const [k,v] of Object.entries(mats)){
    if(k==='gems'){ gems-=v; saveGems(); }
    else{ materials[k]-=v; }
  }
  saveMaterials();
  shopUpgrades[item.id]++;
  saveShop();
  playSound('upgrade_pick');
  updateHUD();
}
function tryCompose(){
  if((materials.scrap||0)>=5&&(materials.core||0)>=3){
    materials.scrap-=5; materials.core-=3; materials.composite=(materials.composite||0)+1;
    saveMaterials(); playSound('powerup');
    lifeGainDisplay={text:'🔷 コンポジット合成完了!',timer:120,color:'#ffaa44'};
  }
}
function dropMaterial(){
  const p=getPlanet(stage).name;
  const r=Math.random();
  if(p==='MARS'){
    if(r<0.30) addMaterial('scrap');
  } else if(p==='VENUS'||p==='JUPITER'){
    if(r<0.15) addMaterial('scrap');
    if(r>=0.15&&r<0.40) addMaterial('core');
  } else { // SATURN
    if(r<0.20) addMaterial('crystal');
    if(r>=0.20&&r<0.35) addMaterial('core',Math.random()<0.3?2:1);
  }
}


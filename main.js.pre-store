}

// ===== ボタン定義 (state → [{x,y,w,h,action}]) =====
const BACK_BTN={id:'back', x:14, y:558, w:196, h:34, label:'◀  MISSION  SELECT', action:()=>{ state='customize'; }};
const UI_BUTTONS={
  gacha:        [BACK_BTN],
  gacha_rates:  [{id:'close', x:14, y:558, w:160, h:34, label:'◀  ガチャに戻る', action:()=>{ state='gacha'; }}],
  stage_select: [BACK_BTN],
  loadout:      [BACK_BTN],
  map:          [BACK_BTN],
  shop:         [BACK_BTN],
  stardust_shop:[{id:'back', x:14, y:558, w:196, h:34, label:'◀  ガチャに戻る', action:()=>{ state='gacha'; }}],
};
let hoveredBtn=null;

function drawUIButtons(){
  const btns=UI_BUTTONS[state];
  if(!btns) return;
  btns.forEach(b=>{
    const hov=hoveredBtn===b;
    const isBack=b.id==='back';
    const col=isBack?'#ff8844':'#0cf';
    ctx.shadowColor=col; ctx.shadowBlur=hov?18:8;
    ctx.fillStyle=hov?(isBack?'rgba(80,30,0,0.97)':'rgba(0,80,120,0.97)'):(isBack?'rgba(40,12,0,0.92)':'rgba(0,40,70,0.92)');
    ctx.strokeStyle=hov?col:(isBack?'rgba(180,80,0,0.7)':'#0a6080');
    ctx.lineWidth=hov?2:1;
    ctx.beginPath(); ctx.roundRect(b.x,b.y,b.w,b.h,8); ctx.fill(); ctx.stroke();
    ctx.shadowBlur=0;
    ctx.fillStyle=hov?'#fff':col;
    ctx.font=`bold 11px Orbitron,Courier New`;
    ctx.textAlign='center';
    ctx.fillText(b.label,b.x+b.w/2,b.y+b.h/2+4);
    ctx.textAlign='left';
  });
}

function handleKey(code){
  // ポーズ
  if(code==='Escape'){
    if(state==='playing'){ paused=!paused; return; }
    if(state==='paused'){ paused=false; state='playing'; return; }
    if(state==='stage_select'){ state='customize'; return; }
    if(state==='map'){ state='customize'; return; }
    if(state==='loadout'){ state='customize'; return; }
    if(state==='shop'){ state='customize'; return; }
    if(state==='gacha'||state==='gacha_result'){ state='customize'; return; }
    if(state==='gacha_rates'){ state='gacha'; return; }
    if(state==='stardust_shop'){ state='gacha'; return; }
  }
  if(paused) return;
  // ステージ選択
  if(state==='stage_select'){
    const maxIdx=highestStage-1;
    if(code==='ArrowLeft'||code==='KeyA') stageSelectIdx=Math.max(0,stageSelectIdx-1);
    else if(code==='ArrowRight'||code==='KeyD') stageSelectIdx=Math.min(maxIdx,stageSelectIdx+1);
    else if(code==='ArrowUp'||code==='KeyW') stageSelectIdx=Math.max(0,stageSelectIdx-5);
    else if(code==='ArrowDown'||code==='KeyS') stageSelectIdx=Math.min(maxIdx,stageSelectIdx+5);
    else if(code==='Space'||code==='Enter'){ startStage=stageSelectIdx+1; startGame(); }
    stageMapScrollOffset=Math.floor(stageSelectIdx/10)*270;
    const pos=getStageNodePos(stageSelectIdx+1,stageMapScrollOffset);
    stageCharTX=pos.x; stageCharTY=pos.y;
    return;
  }
  if(state==='gacha'){
    if(code==='KeyQ') gachaTab=0;
    else if(code==='KeyE') gachaTab=1;
    else if(code==='KeyD'&&gachaTab===0) doDailyGacha();
    else if(code==='Digit1') gachaTab===0?doGachaPull(1):doPremiumPull(1);
    else if(code==='Digit2') gachaTab===0?doGachaPull(10):doPremiumPull(10);
    else if(code==='KeyR') state='gacha_rates';
    else if(code==='KeyS'){ stardustShopCursor=0; state='stardust_shop'; }
    return;
  }
  if(state==='stardust_shop'){
    if(code==='Escape'){ state='gacha'; return; }
    if(code==='ArrowUp'||code==='KeyW') stardustShopCursor=Math.max(0,stardustShopCursor-1);
    else if(code==='ArrowDown'||code==='KeyS') stardustShopCursor=Math.min(2,stardustShopCursor+1);
    else if(code==='Space'||code==='Enter') applyStardustShop(stardustShopCursor);
    return;
  }
  if(state==='gacha_result'){
    if(code==='Digit1'){ doGachaPull(1); return; }
    if(code==='Digit2'){ doGachaPull(10); return; }
    if(code==='Space'||code==='Enter'){
      const now=Date.now();
      if(gachaResults.length>=10&&now-lastGachaKeyTime<450){
        state='gacha_summary'; lastGachaKeyTime=0; return;
      }
      lastGachaKeyTime=now;
      const item=gachaResults[gachaCurrentIdx];
      const total=item?gateTotal(item.rarity):999;
      if(gachaAnimFrame<total){ gachaAnimFrame=total; return; }
      if(gachaCurrentIdx<gachaResults.length-1){ gachaCurrentIdx++; gachaAnimFrame=0; }
      else { state=gachaResults.length>=10?'gacha_summary':'gacha'; }
    }
    return;
  }
  if(state==='gacha_summary'){
    if(code==='Digit1'){ gachaTab===0?doGachaPull(1):doPremiumPull(1); return; }
    if(code==='Digit2'){ gachaTab===0?doGachaPull(10):doPremiumPull(10); return; }
    if(code==='Space'||code==='Enter'||code==='Escape') state='gacha';
    return;
  }
  if(state==='stage_result'){
    if(stageResultTimer>30){
      if(code==='Escape'||code==='KeyS'||code==='Digit2'){
        stageResultData=null;
        stageSelectIdx=Math.min(stage,highestStage)-1;
        stageMapScrollOffset=Math.floor(stageSelectIdx/10)*270;
        const pos=getStageNodePos(stageSelectIdx+1,stageMapScrollOffset);
        stageCharX=pos.x; stageCharY=pos.y; stageCharTX=pos.x; stageCharTY=pos.y;
        state='stage_select';
      } else {
        stageResultData=null;
        genMapRoutes(); chooseRoute(Math.floor(Math.random()*2));
      }
    }
    return;
  }
  if(state==='gacha_rates'){
    if(code==='Escape') state='gacha';
    else if(code==='ArrowDown'||code==='KeyS') gachaRatesScroll=Math.min(gachaRatesScroll+1,Math.ceil(ALL_GACHA_POOL.length/2)-12);
    else if(code==='ArrowUp'||code==='KeyW') gachaRatesScroll=Math.max(0,gachaRatesScroll-1);
    return;
  }
  if(state==='loadout'){
    if(code==='Escape'){ state='customize'; return; }
    {
      const _pool=loadoutTab===0?CHAR_POOL.filter(c=>gachaInventory[c.id]||c.id==='char_basic'):
        loadoutTab===1?EQUIP_POOL.filter(e=>gachaInventory[e.id]):
        loadoutTab===2?PET_POOL.filter(p=>gachaInventory[p.id]):
        [{id:null},...WEAPON_GACHA_POOL.filter(w=>gachaInventory[w.id])];
      const COLS=4, maxIdx=_pool.length-1;
      if(code==='KeyQ'||code==='BracketLeft'){loadoutTab=Math.max(0,loadoutTab-1);loadoutCursor=0;}
      else if(code==='KeyE'||code==='BracketRight'){loadoutTab=Math.min(3,loadoutTab+1);loadoutCursor=0;}
      else if(code==='ArrowLeft'||code==='KeyA') loadoutCursor=Math.max(0,loadoutCursor-1);
      else if(code==='ArrowRight'||code==='KeyD') loadoutCursor=Math.min(maxIdx,loadoutCursor+1);
      else if(code==='ArrowUp'||code==='KeyW') loadoutCursor=Math.max(0,loadoutCursor-COLS);
      else if(code==='ArrowDown'||code==='KeyS') loadoutCursor=Math.min(maxIdx,loadoutCursor+COLS);
      else if(code==='Space'||code==='Enter') applyLoadoutSelection();
      else if(code==='KeyL'){
        const it=_pool[Math.min(loadoutCursor,_pool.length-1)];
        if(it) tryLevelUpItem(it);
      }
    }
    return;
  }
  if(state==='shop'){
    if(code==='Escape'){ state='customize'; return; }
    if(code==='KeyQ') shopTab=0;
    else if(code==='KeyE') shopTab=1;
    else if(code==='ArrowUp'||code==='KeyW'){
      if(shopTab===0) shopCursor=Math.max(0,shopCursor-1);
    }
    else if(code==='ArrowDown'||code==='KeyS'){
      if(shopTab===0) shopCursor=Math.min(SHOP_ITEMS.length-1,shopCursor+1);
    }
    else if(code==='Space'||code==='Enter'){
      if(shopTab===0) applyShopUpgrade(shopCursor);
      else tryCompose();
    }
    return;
  }
  if(state==='customize'){
    if(code==='ArrowUp'||code==='KeyW') customizeCursor=Math.max(0,customizeCursor-1);
    else if(code==='ArrowDown'||code==='KeyS') customizeCursor=Math.min(4,customizeCursor+1);
    else if(code==='Space'||code==='Enter'){
      if(customizeCursor===0){ loadoutTab=0; loadoutCursor=0; state='loadout'; return; }
      if(customizeCursor===1){ state='gacha'; return; }
      if(customizeCursor===2){ shopCursor=0; state='shop'; return; }
      if(customizeCursor===3){
        bossRushModeActive=false;
        stageSelectIdx=Math.min(startStage,highestStage)-1;
        stageMapScrollOffset=Math.floor(stageSelectIdx/10)*270;
        const pos=getStageNodePos(Math.min(startStage,highestStage),stageMapScrollOffset);
        stageCharX=pos.x; stageCharY=pos.y; stageCharTX=pos.x; stageCharTY=pos.y;
        state='stage_select'; return;
      }
      // cursor 4: ボスラッシュ
      bossRushModeActive=true; startGame();
    }
    else if(code==='KeyG'){ state='gacha'; return; }
    return;
  }
  if(state==='map'){
    if(code==='Digit1') chooseRoute(0);
    else if(code==='Digit2') chooseRoute(1);
    return;
  }
  if(code==='Space'||code==='Enter'){
    if(state==='title'){ initAudio(); startBGM(); customizeCursor=0; state='customize'; }
    else if(state==='gameover'){ showMessage(null); startBGM(); customizeCursor=0; bossRushModeActive=false; state='customize'; }
  if(code==='KeyR'&&state==='gameover'){ showMessage(null); startBGM(); stage=startStage; initMissions(); initStars(); updateHUD(); initStage(); state='playing'; }
    else if(state==='clear-stage'){ showMessage(null); nextStage(); }
  }
  if(state==='playing'&&skillChoices){
    if(code==='Digit1') applySkill(0);
    else if(code==='Digit2') applySkill(1);
    else if(code==='Digit3') applySkill(2);
    return;
  }
  if(code==='KeyQ'&&state==='playing') cycleWeapon();
  if(code==='ShiftLeft'&&state==='playing') tryDash();
  if((code==='KeyE'||code==='Enter')&&state==='playing') tryUltimate();
}

bindDocumentKeys({
  onKeyDown(code){ handleKey(code); },
  onKeyUp(code){
    if((code==='KeyZ'||code==='Space')&&state==='playing'){
      if(chargeTimer>=CHARGE_MAX){ fireChargedShot(); }
      chargeTimer=0; chargeReady=false;
    }
  },
});
bindCanvasPointer(canvas,{
  onMouseMove(e){
    const rect=canvas.getBoundingClientRect();
    const scaleX=canvas.width/rect.width, scaleY=canvas.height/rect.height;
    const mx=(e.clientX-rect.left)*scaleX, my=(e.clientY-rect.top)*scaleY;
    const btns=UI_BUTTONS[state]||[];
    hoveredBtn=btns.find(b=>mx>=b.x&&mx<=b.x+b.w&&my>=b.y&&my<=b.y+b.h)||null;
    canvas.style.cursor=hoveredBtn?'pointer':'default';
  },
  onClick(e){
    const rect=canvas.getBoundingClientRect();
    const scaleX=canvas.width/rect.width, scaleY=canvas.height/rect.height;
    const mx=(e.clientX-rect.left)*scaleX, my=(e.clientY-rect.top)*scaleY;
    const btns=UI_BUTTONS[state]||[];
    const btn=btns.find(b=>mx>=b.x&&mx<=b.x+b.w&&my>=b.y&&my<=b.y+b.h);
    if(btn) btn.action();
  },
});

// ===== ボス攻撃パターン =====
function pickBossPattern(){
  if(!boss) return 'triple';
  const p=boss.phase, ab=boss.ability;
  if(p===0) return Math.random()<0.55?'triple':'aimed';
  if(p===1){
    const sets={burst:['sweep','aimed','triple'],split:['spread','aimed','triple'],
                teleport:['aimed','circle','triple'],shield:['wall','aimed','spread']};
    const pool=sets[ab]||['spread','aimed'];
    return pool[Math.floor(Math.random()*pool.length)];
  }
  if(ab==='dasher') return p===0?'aimed':p===1?['aimed','sweep'][Math.floor(Math.random()*2)]:'circle';
  if(ab==='barrage') return p===0?'spread':p===1?['spread','circle'][Math.floor(Math.random()*2)]:'wall';
  // phase2: 全パターン
  const all={burst:['sweep','circle','aimed','spread'],split:['spread','circle','aimed','wall'],
             teleport:['aimed','circle','wall','sweep'],shield:['wall','circle','aimed','spread']};
  const pool=(all[ab]||['spread','circle','wall','aimed']);
  return pool[Math.floor(Math.random()*pool.length)];
}

function fireBossPattern(pattern){
  if(!boss) return;
  const cx=boss.x+boss.w/2, cy=boss.y+boss.h;
  const bspd=INVADER_BULLET_SPEED;
  const mk=(vx,vy,opts={})=>({x:cx-3,y:cy,w:6,h:14,vx,vy,...opts});
  switch(pattern){
    case 'triple':
      // 3方向・明確な隙間
      [-0.38,0,0.38].forEach(a=>invaderBullets.push(mk(Math.sin(a)*bspd*0.85,Math.cos(a)*bspd*0.72)));
      break;
    case 'aimed': {
      // プレイヤー狙い1発（やや遅い・大きい弾）
      const tx=boss.aimTarget?.x??player.x+player.w/2;
      const ty=boss.aimTarget?.y??player.y+player.h/2;
      const dx=tx-cx,dy=ty-cy,len=Math.sqrt(dx*dx+dy*dy)||1;
      invaderBullets.push({x:cx-4,y:cy,w:9,h:18,aimed:true,
        vx:(dx/len)*bspd*0.75,vy:(dy/len)*bspd*0.75});
      break;
    }
    case 'spread':
      // 5方向扇形・隙間あり
      [-0.55,-0.26,0,0.26,0.55].forEach(a=>invaderBullets.push(mk(Math.sin(a)*bspd,Math.cos(a)*bspd*0.68)));
      break;
    case 'circle':
      // 8方向全方位（隙間を縫える）
      for(let i=0;i<8;i++){
        const a=Math.PI*2*i/8+Math.PI/8;
        invaderBullets.push(mk(Math.cos(a)*bspd*0.82,Math.sin(a)*bspd*0.82));
      }
      break;
    case 'sweep':
      // 時間差掃射5発（左→右）
      [-0.55,-0.27,0,0.27,0.55].forEach((a,i)=>{
        setTimeout(()=>{
          if(!boss) return;
          const bx=boss.x+boss.w/2;
          invaderBullets.push({x:bx-3,y:boss.y+boss.h,w:6,h:14,
            vx:Math.sin(a)*bspd*0.9,vy:Math.cos(a)*bspd*0.65});
        },i*110);
      });
      break;
    case 'wall': {
      // 横一列・2か所に穴
      const gaps=new Set();
      while(gaps.size<2) gaps.add(Math.floor(Math.random()*7));
      for(let i=0;i<7;i++){
        if(gaps.has(i)) continue;
        invaderBullets.push({x:60+i*105-3,y:cy+8,w:7,h:14,vx:0,vy:bspd*0.72});
      }
      break;
    }
  }
  playSound('boss_hit');
}

function tryUltimate(){
  if(ultimateGauge<ULTIMATE_MAX||ultimateActive) return;
  ultimateGauge=0; ultimateActive=true; ultimateTimer=ULTIMATE_DURATION;
  sessionProgress.ultimateUses++; checkAndClaimMissions();
  unlockAchievement('ultimate');
  triggerFlash(255,200,50,0.7); triggerShake(14,25);
  playSound('boss_die');
  // 全敵にダメージ
  for(const inv of invaders){
    if(!inv.alive) continue;
    spawnExplosion(inv.x+inv.w/2,inv.y+inv.h/2,'#ff0',8);
    inv.alive=false; addCombo(inv.x+inv.w/2,inv.y,20); addExp(5);
  }
  for(const mb of miniBosses){
    if(!mb.alive) continue;
    mb.hp-=20;
    spawnExplosion(mb.x+mb.w/2,mb.y+mb.h/2,'#ff0',10);
    if(mb.hp<=0) killMiniBoss(mb);
  }
  if(boss&&boss.entryDone){
    const {val:dmg,isCrit:uc}=calcPlayerDmg(15*playerUpgrades.damage);
    boss.hp-=dmg; spawnDmgNum(boss.x+boss.w/2,boss.y,dmg,uc);
    spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#ff0',20);
    playSound('boss_hit');
    if(boss.hp<=0){killBoss();return;}
  }
  invaderBullets=[];
}

function addUltimateGauge(amount){
  if(ultimateGauge>=ULTIMATE_MAX) return;
  ultimateGauge=Math.min(ULTIMATE_MAX,ultimateGauge+amount);
  if(ultimateGauge>=ULTIMATE_MAX) playSound('charge_full');
}

function genMapRoutes(){
  const pool=stage<=2?['normal','survival']:['normal','survival','boss_rush','escort'];
  const a=pool[Math.floor(Math.random()*pool.length)];
  let b; do{ b=pool[Math.floor(Math.random()*pool.length)]; }while(b===a);
  mapRoutes=[a,b];
}
function chooseRoute(idx){
  if(idx>=mapRoutes.length) return;
  stageType=mapRoutes[idx];
  nextStage();
}
function calcRank(){
  const hitScore=stageStats.hits===0?40:stageStats.hits<=1?25:stageStats.hits<=3?10:0;
  const comboScore=stageStats.maxCombo>=8?30:stageStats.maxCombo>=5?20:stageStats.maxCombo>=3?10:0;
  const typeBonus=stageType==='boss_rush'?20:stageType==='survival'||stageType==='escort'?15:0;
  const total=hitScore+comboScore+typeBonus;
  return total>=75?'S':total>=50?'A':total>=25?'B':'C';
}

function saveLoadout(){localStorage.setItem('invader_loadout',JSON.stringify(playerLoadout));}

function applyLoadoutSelection(){
  if(loadoutTab===0){
    const owned=CHAR_POOL.filter(c=>gachaInventory[c.id]);
    if(owned.length===0){
      // RookieはデフォルトでOK
      playerLoadout.charId=null; saveLoadout(); return;
    }
    const c=owned[Math.min(loadoutCursor,owned.length-1)];
    playerLoadout.charId=c.id; saveLoadout();
  } else if(loadoutTab===1){
    const owned=EQUIP_POOL.filter(e=>gachaInventory[e.id]);
    if(loadoutCursor>=owned.length){
      // カーソルが末尾+1=スロットクリア: 選択中スロットをnullに
      const slot=playerLoadout._equipSlot||0;
      playerLoadout.equip[slot]=null; saveLoadout(); return;
    }
    const eq=owned[loadoutCursor];
    const slotMap={atk:0,def:1,sp:2};
    const slotIdx=slotMap[eq.slot]??0;
    playerLoadout.equip[slotIdx]=eq.id; saveLoadout();
  } else if(loadoutTab===2){
    const owned=PET_POOL.filter(p=>gachaInventory[p.id]);
    if(owned.length===0) return;
    const maxPetSlots=stage>=10?3:stage>=5?2:1;
    const pet=owned[Math.min(loadoutCursor,owned.length-1)];
    // 空いているスロットに設定、なければスロット0を上書き
    const emptySlot=playerLoadout.pets.slice(0,maxPetSlots).findIndex(p=>!p);
    const idx=emptySlot>=0?emptySlot:0;
    playerLoadout.pets[idx]=pet.id; saveLoadout();
  } else if(loadoutTab===3){
    const owned=[{id:null,rarity:'N',type:'weapon',label:'CLASSIC',desc:'通常弾・無限',color:'#aaa',weapon:'normal',ammo:0},...WEAPON_GACHA_POOL.filter(w=>gachaInventory[w.id])];
    const w=owned[Math.min(loadoutCursor,owned.length-1)];
    if(!w) return;
    playerLoadout.weaponId=w.id; saveLoadout();
  }
}

function computeBaseStats(){
  const charDef=CHAR_POOL.find(c=>c.id==='char_basic');
  const char=CHAR_POOL.find(c=>c.id===playerLoadout.charId&&gachaInventory[c.id])||charDef;
  let hp=char.hp,atk=char.atk,def=char.def,crit=char.crit,spd=char.spd;
  for(const eid of playerLoadout.equip){
    if(!eid) continue;
    const eq=EQUIP_POOL.find(e=>e.id===eid);
    if(!eq||!gachaInventory[eid]) continue;
    hp+=eq.hp; atk*=eq.atk; def+=eq.def; crit+=eq.crit; spd+=eq.spd;
  }
  playerStats={hp:Math.round(hp),maxHp:Math.round(hp),atk,def:Math.min(def,50),crit:Math.min(crit,40),spd};
}

function getPetEffect(eff){
  return playerLoadout.pets.some(pid=>{
    const p=PET_POOL.find(p=>p.id===pid);
    return p&&p.effect===eff&&gachaInventory[pid];
  });
}
function calcPlayerDmg(base){
  const isCrit=Math.random()*100<playerStats.crit;
  const berserk=(gachaInventory['passive_berserker']?.level>=1&&playerStats.hp<=playerStats.maxHp*0.5)?1.5:1;
  const val=Math.round(base*playerStats.atk*(isCrit?2:1)*berserk);
  return {val,isCrit};
}

// ===== ゲームフロー =====
function startGame(){
  initMissions();
  score=0; lives=1; stage=startStage;
  powerupActive=null; powerupTimer=0;
  playerShield=false; nextLifeScore=5000; lifeGainDisplay=null;
  passiveRegenTimer=0;
  weaponIdx=0; weaponAmmo={laser:0,homing:0,explosive:0};
  playerUpgrades={speed:0,firerate:0,damage:1,spread:false,invincibleBonus:0,bulletSpd:0};
  // ベースステータス計算（キャラ+装備）
  computeBaseStats();
  // ガチャパッシブ適用
  if(gachaInventory['passive_shield']?.level>=1) playerShield=true;
  if(gachaInventory['passive_ammo']?.level>=1)   weaponAmmo.laser+=5;
  // ガチャ武器適用
  if(playerLoadout.weaponId&&gachaInventory[playerLoadout.weaponId]){
    const wp=WEAPON_GACHA_POOL.find(w=>w.id===playerLoadout.weaponId);
    if(wp){ weaponAmmo[wp.weapon]=(weaponAmmo[wp.weapon]||0)+wp.ammo; weaponIdx=WEAPONS.indexOf(wp.weapon); }
  } else {
    // カスタマイズ武器適用
    const sw=SHIP_WEAPONS[shipWeaponIdx];
    if(sw.weapon){ weaponAmmo[sw.weapon]=sw.ammo; weaponIdx=WEAPONS.indexOf(sw.weapon); }
  }
  // ペット適用
  if(getPetEffect('fairy')) { /* coin boost handled in addCoins */ }
  petTimers={dragon:0,hawk:0,bomber:0,ghost:0,fenrir:0}; petBullets=[];
  switch(SHIP_TRAITS[shipTraitIdx].id){
    case 'speedy': playerUpgrades.speed=2; playerUpgrades.firerate=1; break;
    case 'tank':   playerStats.maxHp+=40; playerStats.hp+=40; playerUpgrades.invincibleBonus=60; break;
    case 'gunner': playerUpgrades.damage=2; playerUpgrades.bulletSpd=3; playerUpgrades.firerate=1; break;
  }
  // ショップ強化を適用
  playerUpgrades.speed+=shopUpgrades.speed||0;
  playerUpgrades.firerate+=shopUpgrades.firerate||0;
  playerUpgrades.bulletSpd+=(shopUpgrades.bulletspd||0)*3;
  playerStats.maxHp+=(shopUpgrades.maxhp||0)*20;
  playerStats.hp+=(shopUpgrades.maxhp||0)*20;
  playerStats.crit+=Math.min(50-playerStats.crit,(shopUpgrades.critrate||0)*5);
  if(shopUpgrades.dashcd) playerUpgrades.invincibleBonus+=(shopUpgrades.dashcd)*10;
  seenUpgradeIds=new Set();
  exp=0; playerLevel=1; levelUpDisplay=null;
  chargeTimer=0; chargeReady=false; dashTimer=0; dashCooldown=0; dashTrail=[];
  stageType=bossRushModeActive?'boss_rush':'normal'; stageRank=null; mapRoutes=[];
  stageStats={hits:0,maxCombo:0,kills:0};
  bossRushCount=0; bossRushDelay=0; escortShip=null; survivalTimer=0;
  ultimateGauge=0; ultimateActive=false; ultimateTimer=0;
  bossCutinTimer=0; gravityZones=[]; emFields=[]; blackHoles=[]; meteorRainTimer=0; meteorRainWarning=0;
  initStars(); updateHUD(); initStage();
  showMessage(null); state='playing';
}
function nextStage(){
  sessionProgress.stageClears++; checkAndClaimMissions();
  if(stageStats.hits===0) { sessionProgress.noDmgStages++; checkAndClaimMissions(); }
  stage++;
  if(stage>highestStage){ highestStage=stage; localStorage.setItem('invader_highest_stage',highestStage); }
  if(stage>=5) unlockAchievement('stage5');
  if(stage>=10) unlockAchievement('stage10');
  updateHUD(); initStage(); state='playing';
}

function initStage(){
  frameCount=0;
  bullets=[]; invaderBullets=[];
  invaders=[]; particles=[]; powerups=[]; ufo=null; boss=null; miniBosses=[];
  healers=[]; meteors=[];
  combo=0; comboTimer=0; comboDisplay=null;
  bossPhase=false;
  invaderSpawnTimer=0; lastShot=0;
  invaderSpawnInterval=Math.max(40,130-(stage-1)*8);
  maxInvaders=Math.min(15,4+stage*2);
  muzzleFlashes=[]; bossWarningTimer=0; stageBannerTimer=120;
  currentEvent=null; eventTimer=0; eventCooldown=300;
  formationTimer=500; healerSpawnTimer=0;
  chargeTimer=0; chargeReady=false; dashTrail=[];
  petTimers={dragon:0,hawk:0,bomber:0,ghost:0,fenrir:0}; petBullets=[];
  triggerFlash(0,100,255,0.3);
  const _dims=getShipDims();
  player={x:W/2-_dims.w/2,y:H-100,w:_dims.w,h:_dims.h,invincibleTimer:0,_valkyrieUsed:false};
  barriers=[];
  stageEl.textContent=stage;
  stageStats={hits:0,maxCombo:0,kills:0};
  bossRushCount=0; bossRushDelay=0; escortShip=null;
  survivalTimer=SURVIVAL_DURATION; minionSpawnTimer=0;
  bossCutinTimer=0; gravityZones=[]; emFields=[]; blackHoles=[]; meteorRainTimer=0; meteorRainWarning=0;
  waveNum=0; waveState='idle'; waveKills=0; waveTargetKills=0; waveDelay=0; waveBannerTimer=0;
  if(stageType==='normal'||stageType==='escort') initEnvGimmicks();

  // 小惑星ステージ判定
  isAsteroidStage=stage>=2&&stage%2===0&&stageType==='normal';
  asteroids=[];
  if(isAsteroidStage) initAsteroids();

  // ボス連戦: 即ボスフェーズ
  if(stageType==='boss_rush'){
    bossPhase=true; spawnBoss(); return;
  }
  // 護衛: 輸送船を配置
  if(stageType==='escort') initEscortShip();

  // ウェーブ1開始
  startWave(1);
}

function startWave(n){
  waveNum=n; waveState='active';
  waveTargetKills=getWaveSize(n);
  waveKills=0; waveBannerTimer=90;
  invaders=[]; invaderBullets=[];
  sessionProgress.maxWave=Math.max(sessionProgress.maxWave,n);
  // ウェーブサイズ分スポーン
  const count=waveTargetKills;
  for(let i=0;i<count;i++) spawnInvader();
  playSound('event_start');
}

function initEscortShip(){
  escortShip={x:W/2-35,y:H-170,w:70,h:28,hp:5,maxHp:5,vx:0.7,alive:true};
}

function respawn(){
  bullets=[]; invaderBullets=[]; particles=[];
  const _d=getShipDims(); player.w=_d.w; player.h=_d.h;
  player.x=W/2-player.w/2; player.y=H-100;
  player.invincibleTimer=180+playerUpgrades.invincibleBonus;
  showMessage(null); state='playing';
}

// ===== 小惑星 =====
function initAsteroids(){
  const count=2+Math.floor(stage/2);
  for(let i=0;i<count;i++){
    const sz=30+Math.random()*40;
    asteroids.push({
      x:Math.random()*(W-sz), y:30+Math.random()*(H*0.55-sz),
      w:sz, h:sz, vx:(Math.random()-0.5)*1.2, vy:(Math.random()-0.5)*0.8,
      hp:3, maxHp:3, angle:Math.random()*Math.PI*2, rotSpeed:(Math.random()-0.5)*0.02,
      alive:true,
    });
  }
}

// ===== スポーン =====
function spawnBoss(){
  const hp=12+stage*6;
  const ability=stage<=2?'burst':stage<=4?'split':stage<=6?'teleport':stage<=8?'shield':stage<=10?'dasher':'barrage';
  boss={
    x:W/2-60,y:-80,w:120,h:60,hp,maxHp:hp,dir:1,
    speed:ability==='dasher'?2.8+stage*0.2:ability==='barrage'?0.8+stage*0.15:1.5+stage*0.3,
    shootTimer:0,
    shootInterval:ability==='barrage'?Math.max(35,110-stage*5):Math.max(25,90-stage*5),
    frame:0,frameTimer:0,phase:0,entryDone:false,
    ability,
    teleportTimer:150,
    shieldHp:0,shieldMax:0,shielded:false,
    splitDone:false,
    attackCharge:0, nextPattern:null, aimTarget:null,
    dying:false, dyingTimer:0,
    // DASHER用
    dashTimer:Math.max(60,120-stage*5), _dashing:false, _dashVx:0, _dashDuration:0,
    // BARRAGE用
    barrageCharge:0,
  };
  if(ability==='shield'){
    boss.shieldMax=10+stage*2;
    boss.shieldHp=boss.shieldMax;
    boss.shielded=true;
  }
  bossWarningTimer=150; healerSpawnTimer=0;
}

function spawnMiniBoss(x,y,hp){
  miniBosses.push({
    x,y,w:70,h:36,hp,maxHp:hp,dir:Math.random()<0.5?1:-1,
    speed:2+stage*0.3, shootTimer:Math.floor(Math.random()*40),
    shootInterval:Math.max(25,50-stage*3),
    frame:0,frameTimer:0,alive:true,
  });
}

function pickInvaderType(){
  const r=Math.random();
  const p=getPlanet(stage).name;
  if(p==='MARS'){
    if(r<0.10) return 'tank';
    if(r<0.14) return stage>=3?'spider':'fast';
    if(r<0.18) return stage>=3?'ufo_drone':'normal';
    if(r<0.52) return 'fast';
    if(r<0.78) return 'normal';
    return stage>=6?'bomber':'normal';
  }
  if(p==='VENUS'){
    if(r<0.08) return 'crystal';
    if(r<0.16) return 'ufo_drone';
    if(r<0.46) return 'normal';
    if(r<0.68) return 'sniper';
    if(r<0.84) return 'fast';
    return 'bomber';
  }
  if(p==='JUPITER'){
    if(r<0.08) return stage>=22?'heavy':'tank';
    if(r<0.14) return 'spider';
    if(r<0.20) return 'ufo_drone';
    if(r<0.42) return 'tank';
    if(r<0.65) return 'bomber';
    if(r<0.82) return 'normal';
    return 'sniper';
  }
  // SATURN
  if(r<0.12) return 'heavy';
  if(r<0.22) return 'crystal';
  if(r<0.30) return 'ufo_drone';
  if(r<0.55) return 'sniper';
  if(r<0.70) return 'fast';
  if(r<0.84) return 'tank';
  return 'normal';
}
function getPlanetBehavior(invType){
  const p=getPlanet(stage).name;
  if(p==='MARS') return invType==='fast'?'rush':'charge';  // 積極的に突撃
  if(p==='VENUS') return invType==='normal'?'swarm':'snipe'; // 群れで動く
  if(p==='JUPITER') return invType==='tank'?'heavy':'bombard'; // 重く動く
  return invType==='sniper'?'orbital':'drift'; // 上空旋回
}
function spawnInvader(){
  const invType=pickInvaderType();
  const isPatrol=Math.random()<0.55;
  let baseSpeed=0.7+stage*0.25+Math.random()*0.4;
  let row=Math.floor(Math.random()*3), hp=1;
  if(invType==='fast'){baseSpeed*=1.9; row=0;}
  if(invType==='tank'){baseSpeed*=0.45; row=2; hp=3;}
  if(invType==='sniper'){baseSpeed*=0.7; row=1;}
  if(invType==='bomber'){baseSpeed*=0.8; row=0;}
  if(invType==='ufo_drone'){baseSpeed*=1.1; row=0; hp=2;}
  if(invType==='spider'){baseSpeed*=0.95; row=1; hp=2;}
  if(invType==='crystal'){baseSpeed*=0.35; row=1; hp=4;}
  if(invType==='heavy'){baseSpeed*=0.18; row=2; hp=8;}
  const speed=baseSpeed;
  let x,y,vx,vy;
  if(isPatrol){
    x=Math.random()<0.5?-INVADER_W-10:W+10;
    y=30+Math.random()*(H*0.28);
    vx=x<0?speed*(0.8+Math.random()*0.4):-speed*(0.8+Math.random()*0.4);
    vy=(Math.random()-0.5)*speed*0.4;
  } else {
    const side=Math.floor(Math.random()*3);
    if(side===0){x=Math.random()*(W-INVADER_W);y=-INVADER_H-10;vx=(Math.random()-0.5)*speed*1.2;vy=speed*(0.9+Math.random()*0.4);}
    else if(side===1){x=-INVADER_W-10;y=Math.random()*(H*0.55);vx=speed*(0.8+Math.random()*0.5);vy=speed*(0.2+Math.random()*0.4);}
    else{x=W+10;y=Math.random()*(H*0.55);vx=-speed*(0.8+Math.random()*0.5);vy=speed*(0.2+Math.random()*0.4);}
  }
  const behavior=invType==='ufo_drone'?'sine_wave':invType==='spider'?'zigzag':invType==='crystal'?'crystal_drift':invType==='heavy'?'advance':getPlanetBehavior(invType);
  const iw=invType==='heavy'?50:invType==='ufo_drone'?42:INVADER_W;
  const ih=invType==='heavy'?40:invType==='ufo_drone'?18:INVADER_H;
  invaders.push({x,y,vx,vy,w:iw,h:ih,
    row,hp,maxHp:hp,invType,behavior,alive:true,frame:0,frameTimer:0,
    shootTimer:Math.floor(Math.random()*120),
    shootInterval:invType==='heavy'?Math.max(80,200-stage*10):invType==='crystal'?Math.max(70,180-stage*8):Math.max(60,240-stage*15),
    isPatrol,behaviorTimer:0,sineOffset:Math.random()*Math.PI*2});
}

function spawnFormation(){
  const speed=1.5+stage*0.25;
  const cx=W/2-INVADER_W/2;
  const positions=[[cx,0],[cx-60,30],[cx+60,30],[cx-120,60],[cx+120,60]];
  const vx=(Math.random()-0.5)*speed*0.5, vy=speed*1.1;
  positions.forEach(([px,py])=>{
    invaders.push({x:px,y:-INVADER_H-py-20,vx,vy,w:INVADER_W,h:INVADER_H,
      row:0,alive:true,frame:0,frameTimer:0,
      shootTimer:60+Math.floor(Math.random()*60),
      shootInterval:Math.max(80,160-stage*10),
      isPatrol:false,formation:true});
  });
}

function spawnHealer(){
  const side=Math.random()<0.5?-1:1;
  healers.push({x:side<0?-30:W+30,y:80+Math.random()*100,w:24,h:24,
    vx:side<0?1.2:-1.2,vy:0.3+Math.random()*0.3,alive:true});
}

function spawnDmgNum(x,y,val,isCrit=false,isHeal=false){
  damageNumbers.push({x,y:y-10,val,isCrit,isHeal,timer:55,vy:-1.8});
}
function spawnExplosion(x,y,color,count=12){
  for(let i=0;i<count;i++){
    const angle=(Math.PI*2*i)/count+Math.random()*0.5;
    const spd=2+Math.random()*3;
    particles.push({x,y,vx:Math.cos(angle)*spd,vy:Math.sin(angle)*spd,
      life:1.0,decay:0.03+Math.random()*0.02,size:3+Math.random()*4,color});
  }
}

function trySpawnUFO(){
  if(!ufo&&!bossPhase&&Math.random()<0.003)
    ufo={x:-60,y:30,w:56,h:24,speed:2+Math.random(),
      points:[50,100,150,200,300][Math.floor(Math.random()*5)]};
}

function spawnPowerup(x,y){
  const r=Math.random();
  if(r<0.04) powerups.push({x:x-12,y,w:24,h:16,vy:1.5,type:'heal'});
  else if(r<0.07) powerups.push({x:x-12,y,w:24,h:16,vy:1.5,type:'shield'});
  else if(r<0.19){
    const types=['double','invincible','wide'];
    powerups.push({x:x-12,y,w:24,h:16,vy:1.5,type:types[Math.floor(Math.random()*3)]});
  }
}

// ===== コンボ =====
function addCombo(x,y,baseScore){
  combo++; comboTimer=90; stageStats.kills++;
  stageStats.maxCombo=Math.max(stageStats.maxCombo,combo);
  sessionProgress.maxCombo=Math.max(sessionProgress.maxCombo,combo);
  checkAndClaimMissions();
  if(combo>=10) unlockAchievement('combo10');
  addUltimateGauge(6);
  const mult=Math.min(combo,8);
  const bonus=baseScore*mult;
  score+=bonus;
  comboDisplay={x,y,text:combo>1?`x${mult} COMBO! +${bonus}`:`+${bonus}`,timer:60};
  if(combo>=5) triggerFlash(255,255,0,0.08+combo*0.02);
  if(score>=nextLifeScore){
    nextLifeScore+=5000; playerStats.hp=Math.min(playerStats.maxHp,playerStats.hp+20); updateHUD();
    lifeGainDisplay={text:'SCORE BONUS  HP +20',timer:120,color:'#ff0'};
    triggerFlash(255,200,0,0.2); playSound('stage_clear');
  }
  updateHUD();
}

// ===== ダッシュ =====
function tryDash(){
  if(dashCooldown>0||dashTimer>0) return;
  let dx=0,dy=0;
  if(keys['ArrowLeft']||keys['KeyA']) dx=-1;
  if(keys['ArrowRight']||keys['KeyD']) dx=1;
  if(keys['ArrowUp']||keys['KeyW']) dy=-1;
  if(keys['ArrowDown']||keys['KeyS']) dy=1;
  if(dx===0&&dy===0) dy=-1; // no direction → dash forward (up)
  const len=Math.sqrt(dx*dx+dy*dy)||1;
  player._dashVx=dx/len*DASH_SPEED; player._dashVy=dy/len*DASH_SPEED;
  const _shapeMod=SHIP_SHAPES[shipShapeIdx].id==='agile'?0.55:SHIP_SHAPES[shipShapeIdx].id==='heavy'?1.4:1;
  dashTimer=DASH_DURATION; dashCooldown=Math.floor(DASH_COOLDOWN*_shapeMod);
  player.invincibleTimer=Math.max(player.invincibleTimer,DASH_DURATION+4);
  playSound('dash');
  triggerFlash(100,200,255,0.1);
}

// ===== チャージ発射 =====
function fireChargedShot(){
  const cx=player.x+player.w/2;
  const isHeavy=SHIP_SHAPES[shipShapeIdx].id==='heavy';
  const cw=isHeavy?46:30, pierces=isHeavy?8:5;
  bullets.push({x:cx-cw/2,y:player.y-10,w:cw,h:cw,charged:true,
    bspd:BULLET_SPEED+playerUpgrades.bulletSpd,piercesLeft:pierces});
  muzzleFlashes.push({x:cx,y:player.y-10,timer:12,maxTimer:12});
  playSound('shoot_charge');
  triggerFlash(255,200,0,0.15);
}

// ===== 武器発射 =====
function fireBullet(){
  const w=currentWeapon();
  const bspd=BULLET_SPEED+playerUpgrades.bulletSpd;
  const cx=player.x+player.w/2;
  if(w==='laser'){
    weaponAmmo.laser--;
    if(weaponAmmo.laser<=0&&currentWeapon()==='laser') cycleWeapon();
    bullets.push({x:cx-3,y:player.y,w:6,h:14,laser:true,bspd});
    playSound('shoot_laser');
    for(const inv of invaders){
      if(!inv.alive) continue;
      if(cx>=inv.x&&cx<=inv.x+inv.w){
        inv.alive=false; addCombo(inv.x+inv.w/2,inv.y,(3-inv.row)*10);
        spawnExplosion(inv.x+inv.w/2,inv.y+inv.h/2,['#f55','#ff0','#0ff'][inv.row<=0?0:inv.row<=1?1:2]);
        spawnPowerup(inv.x+inv.w/2,inv.y+inv.h); addExp(12); playSound('explosion');
      }
    }
    if(boss&&boss.entryDone&&!boss.shielded&&cx>=boss.x&&cx<=boss.x+boss.w){
      const {val:bd,isCrit:bc}=calcPlayerDmg(playerUpgrades.damage); boss.hp-=bd; spawnDmgNum(cx,boss.y,bd,bc); spawnExplosion(cx,boss.y+boss.h/2,'#f80',4); playSound('boss_hit');
      if(boss.hp<=0){killBoss();}
    }
    return;
  }
  if(w==='homing'){
    weaponAmmo.homing--;
    if(weaponAmmo.homing<=0&&currentWeapon()==='homing') cycleWeapon();
    let target=null,minDist=Infinity;
    const cands=[...invaders.filter(i=>i.alive),...(boss?[boss]:[]),...miniBosses.filter(m=>m.alive),...healers.filter(h=>h.alive)];
    for(const t of cands){
      const dx=(t.x+t.w/2)-cx,dy=(t.y+t.h/2)-player.y;
      const dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<minDist){minDist=dist;target=t;}
    }
    bullets.push({x:cx-3,y:player.y-10,w:6,h:14,homing:true,target,bspd,vx:0,vy:-bspd});
    playSound('shoot_homing'); return;
  }
  if(w==='explosive'){
    weaponAmmo.explosive--;
    if(weaponAmmo.explosive<=0&&currentWeapon()==='explosive') cycleWeapon();
    bullets.push({x:cx-4,y:player.y,w:8,h:8,explosive:true,bspd});
    playSound('shoot_expl'); return;
  }
  if(playerUpgrades.spread){
    [[-0.25,0],[0,-0.1],[0.25,0]].forEach(([ax,ay])=>{
      bullets.push({x:cx-2,y:player.y,w:4,h:14,vx:ax*bspd,vy:-(bspd+ay*bspd),bspd});
    });
  } else {
    bullets.push({x:cx-2,y:player.y,w:4,h:14,bspd});
  }
  playSound('shoot');
}

// ===== ボス撃破 =====
function killBoss(){
  spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#ff0',30);
  triggerShake(10,20); triggerFlash(255,150,0,0.7);
  score+=500+stage*100; updateHUD(); addExp(150);
  addCoins(80+stage*8+Math.floor(Math.random()*40));
  addGems(3+Math.floor(stage/5));
  // ボス撃破 素材ドロップ (量子結晶確定 + ステージ素材)
  const bp=getPlanet(stage).name;
  if(bp==='SATURN') addMaterial('crystal',2);
  else if(bp==='JUPITER') addMaterial('crystal',1);
  else addMaterial('core',2);
  addMaterial('scrap',3);
  playSound('boss_die');
  bossKillTotal++; localStorage.setItem('invader_boss_kills',bossKillTotal);
  if(bossKillTotal>=5) unlockAchievement('boss5');
  sessionProgress.bossKills++; checkAndClaimMissions();
  if(stageStats.hits===0) unlockAchievement('nodamage');
  boss=null; miniBosses=[];
  // ボス連戦: まだ次のボスがいる
  if(stageType==='boss_rush'&&bossRushCount<bossRushMax-1){
    bossRushCount++;
    bossRushDelay=90;
    return;
  }
  stageRank=calcRank();
  const rankBonus={S:50,A:35,B:20,C:10}[stageRank]||10;
  const rankGems={S:5,A:3,B:1,C:0}[stageRank]||0;
  addCoins(rankBonus); if(rankGems>0) addGems(rankGems);
  stopBGM();
  if(bossRushModeActive){ stageType='boss_rush'; nextStage(); return; }
  stageResultData={stage,rank:stageRank,kills:stageStats.kills,hits:stageStats.hits,maxCombo:stageStats.maxCombo,rankBonus,rankGems,score};
  stageResultTimer=0;
  bullets=[]; invaderBullets=[]; stageClearAnimTimer=80;
}

function killMiniBoss(mb){
  spawnExplosion(mb.x+mb.w/2,mb.y+mb.h/2,'#f80',16);
  triggerShake(6,10); score+=200+stage*50; updateHUD(); addExp(60);
  addCoins(25+Math.floor(Math.random()*15));
  playSound('boss_die');
  mb.alive=false;
  if(miniBosses.every(m=>!m.alive)){
    miniBosses=[];
    stageRank=calcRank();
    const rankBonus={S:50,A:35,B:20,C:10}[stageRank]||10;
    addCoins(rankBonus); stopBGM();
    stageResultData={stage,rank:stageRank,kills:stageStats.kills,hits:stageStats.hits,maxCombo:stageStats.maxCombo,rankBonus,score};
    stageResultTimer=0; bullets=[]; invaderBullets=[]; stageClearAnimTimer=80;
  }
}

// ===== ボス更新 =====
function updateBoss(){
  if(!boss) return;
  // シネマティック撃破中
  if(boss.dying){
    boss.dyingTimer--;
    const prog=1-boss.dyingTimer/100;
    const freq=Math.max(1,7-Math.floor(prog*5));
    if(boss.dyingTimer%freq===0)
      spawnExplosion(boss.x+Math.random()*boss.w,boss.y+Math.random()*boss.h,
        ['#ff0','#f80','#f44'][Math.floor(Math.random()*3)],8);
    if(boss.dyingTimer===60){triggerShake(8,14);}
    if(boss.dyingTimer===30){triggerFlash(255,200,0,0.65);}
    if(boss.dyingTimer<=0) killBoss();
    return;
  }
  boss.frameTimer++;
  if(boss.frameTimer>=20){boss.frame^=1;boss.frameTimer=0;}
  if(!boss.entryDone){
    boss.y+=2;
    if(boss.y>=40){boss.y=40;boss.entryDone=true;bossCutinTimer=BOSS_CUTIN_DURATION;}
    return;
  }

  boss.phase=boss.hp<boss.maxHp*0.33?2:boss.hp<boss.maxHp*0.66?1:0;

  // シールド
  if(boss.ability==='shield'&&boss.shielded){
    for(let i=bullets.length-1;i>=0;i--){
      if(rectsOverlap(bullets[i],boss)&&!bullets[i].charged){
        spawnExplosion(bullets[i].x,bullets[i].y,'#4af',4);
        bullets.splice(i,1);
        boss.shieldHp-=1;
        playSound('boss_shield');
        if(boss.shieldHp<=0){boss.shielded=false;triggerFlash(50,150,255,0.3);}
      }
    }
    // フェーズ変化でシールド再生成
    if(boss.phase>0){boss.shielded=true;boss.shieldHp=boss.shieldMax;}
  }

  // テレポート
  if(boss.ability==='teleport'&&boss.entryDone){
    boss.teleportTimer--;
    if(boss.teleportTimer<=0){
      boss.x=Math.random()*(W-boss.w);
      boss.teleportTimer=Math.max(80,150-stage*10);
      triggerFlash(150,0,255,0.15);
      spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#f0f',12);
      playSound('boss_teleport');
    }
  }

  const spd=boss.speed*(boss.phase>=1?1.4:1)*(boss.phase>=2?1.3:1);
  boss.x+=boss.dir*spd;
  if(boss.x+boss.w>=W) boss.dir=-1;
  if(boss.x<=0) boss.dir=1;

  // 攻撃テレグラフ→発射
  const interval=boss.phase>=2?Math.floor(boss.shootInterval*0.5):boss.phase===1?Math.floor(boss.shootInterval*0.7):boss.shootInterval;
  if(boss.attackCharge>0){
    boss.attackCharge--;
    if(boss.attackCharge===0) fireBossPattern(boss.nextPattern);
  } else {
    boss.shootTimer++;
    if(boss.shootTimer>=interval){
      boss.shootTimer=0;
      boss.nextPattern=pickBossPattern();
      boss.attackCharge=28;
      if(boss.nextPattern==='aimed'){
        boss.aimTarget={x:player.x+player.w/2, y:player.y+player.h/2};
      }
    }
  }

  // DASHER: 高速ダッシュ
  if(boss.ability==='dasher'&&boss.entryDone){
    if(!boss._dashing){
      boss.dashTimer--;
      if(boss.dashTimer<=0){
        boss.dashTimer=Math.max(50,110-stage*5);
        boss._dashing=true;
        boss._dashVx=boss.dir*24;
        boss._dashDuration=16;
        spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#0cf',6);
        playSound('dash');
      }
    } else {
      boss._dashDuration--;
      boss.x=Math.max(0,Math.min(W-boss.w,boss.x+boss._dashVx));
      if(boss._dashDuration<=0||boss.x<=0||boss.x+boss.w>=W){
        boss._dashing=false; boss.dir*=-1;
        spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#0cf',8);
        triggerShake(4,5);
      }
    }
  }
  // BARRAGE: 定期的な全方位弾幕
  if(boss.ability==='barrage'&&boss.entryDone){
    boss.barrageCharge++;
    const bInt=Math.max(55,130-stage*6);
    if(boss.barrageCharge>=bInt){
      boss.barrageCharge=0;
      const cnt=10+boss.phase*4;
      const cx2=boss.x+boss.w/2, cy2=boss.y+boss.h/2;
      for(let i=0;i<cnt;i++){
        const a=Math.PI*2*i/cnt;
        invaderBullets.push({x:cx2-3,y:cy2,w:6,h:6,
          vx:Math.cos(a)*INVADER_BULLET_SPEED*0.85,vy:Math.sin(a)*INVADER_BULLET_SPEED*0.85});
      }
      triggerFlash(200,0,80,0.15); playSound('boss_split');
    }
  }
  // 分裂（フェーズ1移行時 1回）
  if(boss.ability==='split'&&boss.phase>=1&&!boss.splitDone){
    boss.splitDone=true;
    const halfHp=Math.floor(boss.hp/2);
    spawnMiniBoss(boss.x-30,boss.y,halfHp);
    spawnMiniBoss(boss.x+boss.w-40,boss.y,halfHp);
    spawnExplosion(boss.x+boss.w/2,boss.y+boss.h/2,'#f80',20);
    triggerFlash(255,100,0,0.35);
    playSound('boss_split');
    boss=null;
    return;
  }

  // ミニオン召喚（フェーズ1以降）
  if(boss.phase>=1){
    minionSpawnTimer++;
    const mInterval=boss.phase>=2?200:240;
    const mCap=6;
    if(minionSpawnTimer>=mInterval){
      minionSpawnTimer=0;
      const count=boss.phase>=2?2:1;
      for(let i=0;i<count&&bossMinions.length<mCap;i++) spawnBossMinion();
    }
  }

  if(!boss.shielded&&!boss.dying){
    for(let i=bullets.length-1;i>=0;i--){
      if(rectsOverlap(bullets[i],boss)){
        const {val:dmg,isCrit:dc}=calcPlayerDmg(bullets[i].charged?playerUpgrades.damage*4:playerUpgrades.damage);
        bullets.splice(i,1);
        spawnDmgNum(boss.x+boss.w/2,boss.y,dmg,dc);
        boss.hp=Math.max(0,boss.hp-dmg);
        addUltimateGauge(3);
        spawnExplosion(boss.x+Math.random()*boss.w,boss.y+Math.random()*boss.h,'#f80',5);
        playSound('boss_hit');
        if(boss.hp<=0){
          boss.dying=true; boss.dyingTimer=100;
          invaderBullets=[]; bossCutinTimer=0;
          triggerFlash(255,220,80,0.4);
          return;
        }
      }
    }
  }
}

function updateMiniBosses(){
  for(const mb of miniBosses){
    if(!mb.alive) continue;
    mb.frameTimer=(mb.frameTimer||0)+1;
    if(mb.frameTimer>=20){mb.frame^=1;mb.frameTimer=0;}
    mb.x+=mb.dir*mb.speed;
    if(mb.x+mb.w>=W) mb.dir=-1;
    if(mb.x<=0) mb.dir=1;
    mb.shootTimer++;
    if(mb.shootTimer>=mb.shootInterval){
      mb.shootTimer=0;
      invaderBullets.push({x:mb.x+mb.w/2-2,y:mb.y+mb.h,w:5,h:14,
        vx:(Math.random()-0.5)*2,vy:INVADER_BULLET_SPEED,zigzag:false});
    }
    for(let i=bullets.length-1;i>=0;i--){
      if(rectsOverlap(bullets[i],mb)){
        const {val:dmg,isCrit:mdc}=calcPlayerDmg(bullets[i].charged?playerUpgrades.damage*4:playerUpgrades.damage);
        bullets.splice(i,1);
        mb.hp-=dmg; spawnDmgNum(mb.x+mb.w/2,mb.y,dmg,mdc);
        spawnExplosion(mb.x+Math.random()*mb.w,mb.y+Math.random()*mb.h,'#f80',4);
        playSound('boss_hit');
        if(mb.hp<=0){killMiniBoss(mb);break;}
      }
    }
  }
}

function updateHealers(){
  if(!bossPhase) return;
  if((boss||miniBosses.some(m=>m.alive))){
    healerSpawnTimer++;
    if(healerSpawnTimer>=Math.max(180,360-stage*20)){healerSpawnTimer=0;spawnHealer();}
  }
  for(let i=healers.length-1;i>=0;i--){
    const h=healers[i];
    if(!h.alive){healers.splice(i,1);continue;}
    if(h.x<0) h.vx=Math.abs(h.vx);
    if(h.x+h.w>W) h.vx=-Math.abs(h.vx);
    h.x+=h.vx; h.y+=h.vy;
    const bossTgt=boss||(miniBosses.find(m=>m.alive));
    if(bossTgt&&rectsOverlap(h,bossTgt)){
      bossTgt.hp=Math.min(bossTgt.maxHp,bossTgt.hp+5);
      spawnExplosion(h.x+h.w/2,h.y+h.h/2,'#0f0',8);
      h.alive=false; triggerFlash(0,255,0,0.15); continue;
    }
    for(let j=bullets.length-1;j>=0;j--){
      if(rectsOverlap(bullets[j],h)){
        bullets.splice(j,1); h.alive=false;
        spawnExplosion(h.x+h.w/2,h.y+h.h/2,'#0f0',10);
        score+=80; updateHUD(); addExp(20); playSound('healer_die'); break;
      }
    }
    if(h.y>H) h.alive=false;
  }
}

// ===== ボスミニオン =====
let bossMinions=[];
function spawnBossMinion(){
  const side=Math.random()<0.5?-1:1;
  bossMinions.push({
    x:side<0?-36:W+36, y:boss?boss.y+boss.h*0.5+Math.random()*boss.h*0.3:60,
    w:32, h:26, hp:3, maxHp:3,
    vx:side<0?1.4:-1.4, vy:0.5, alive:true, frame:0, frameTimer:0,
  });
}
function updateBossMinions(){
  if(!bossPhase){bossMinions=[];return;}
  for(let i=bossMinions.length-1;i>=0;i--){
    const m=bossMinions[i];
    if(!m.alive){bossMinions.splice(i,1);continue;}
    m.frameTimer=(m.frameTimer||0)+1;
    if(m.frameTimer>=14){m.frame^=1;m.frameTimer=0;}
    // プレイヤーに向かう (速度を抑制)
    const px=player.x+player.w/2, py=player.y+player.h/2;
    const dx=px-(m.x+m.w/2), dy=py-(m.y+m.h/2);
    const len=Math.sqrt(dx*dx+dy*dy)||1;
    const spd=Math.min(2.4, 0.9+stage*0.06);
    m.x+=dx/len*spd; m.y+=dy/len*spd;
    if(m.y>H+60||m.x<-80||m.x>W+80){bossMinions.splice(i,1);continue;}
    // 弾との衝突 (レーザー対応)
    for(let j=bullets.length-1;j>=0;j--){
      if(!rectsOverlap(bullets[j],m)) continue;
      const b=bullets[j];
      const dmg=b.laser?999:b.charged?4:1;
      m.hp-=dmg;
      if(!b.laser) bullets.splice(j,1); // レーザーは消えない
      if(m.hp<=0){
        spawnExplosion(m.x+m.w/2,m.y+m.h/2,'#ff44ff',10);
        score+=50; addExp(12); addUltimateGauge(6); updateHUD();
        m.alive=false; playSound('explosion'); break;
      } else {
        spawnExplosion(m.x+m.w/2,m.y+m.h/2,'#aa00aa',3);
        if(!b.laser) break;
      }
    }
    // プレイヤーに当たる
    if(m.alive&&rectsOverlap(m,player)&&!(powerupActive==='invincible'||player.invincibleTimer>0)){
      m.alive=false;
      spawnExplosion(m.x+m.w/2,m.y+m.h/2,'#ff44ff',8);
      if(playerShield){absorbWithShield();}else{onPlayerHit();}
    }
  }
}
function drawBossMinions(){
  for(const m of bossMinions){
    if(!m.alive) continue;
    const hpRatio=m.hp/m.maxHp;
    const col=hpRatio>0.66?'#ff44ff':hpRatio>0.33?'#ff8800':'#ff2222';
    ctx.shadowColor=col; ctx.shadowBlur=14; ctx.fillStyle=col;
    // 胴体
    ctx.beginPath(); ctx.roundRect(m.x+4,m.y+4,m.w-8,m.h-8,4); ctx.fill();
    // 羽
    ctx.globalAlpha=0.75;
    ctx.beginPath(); ctx.moveTo(m.x,m.y+8); ctx.lineTo(m.x+8,m.y+4); ctx.lineTo(m.x+8,m.y+m.h-4); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(m.x+m.w,m.y+8); ctx.lineTo(m.x+m.w-8,m.y+4); ctx.lineTo(m.x+m.w-8,m.y+m.h-4); ctx.closePath(); ctx.fill();
    // 足 (アニメ)
    ctx.globalAlpha=1;
    const legY=m.y+m.h-2;
    if(m.frame===0){ ctx.fillRect(m.x+6,legY,5,6); ctx.fillRect(m.x+m.w-11,legY,5,6); }
    else { ctx.fillRect(m.x+10,legY,5,6); ctx.fillRect(m.x+m.w-15,legY,5,6); }
    // HPバー
    ctx.fillStyle='#300'; ctx.fillRect(m.x,m.y-7,m.w,4);
    ctx.fillStyle=col; ctx.shadowBlur=4;
    ctx.fillRect(m.x,m.y-7,m.w*hpRatio,4);
    ctx.shadowBlur=0;
  }
}

// ===== ペット更新 =====
function updatePets(){
  if(!player||state!=='playing') return;
  const activePets=playerLoadout.pets.map((pid,i)=>{
    if(!pid||!gachaInventory[pid]) return null;
    return {def:PET_POOL.find(p=>p.id===pid),idx:i};
  }).filter(Boolean);
  for(const {def,idx} of activePets){
    // dragon: 180フレーム(3秒)毎に前方に火球
    if(def.effect==='dragon'){
      petTimers.dragon=(petTimers.dragon||0)+1;
      if(petTimers.dragon>=180){
        petTimers.dragon=0;
        const cx=player.x+player.w/2;
        bullets.push({x:cx-5,y:player.y-10,w:10,h:10,explosive:true,bspd:BULLET_SPEED+2,petBullet:true});
        playSound('shoot_expl');
      }
    }
    // hawk: 180フレーム毎にホーミング
    if(def.effect==='hawk'){
      petTimers.hawk=(petTimers.hawk||0)+1;
      if(petTimers.hawk>=180){
        petTimers.hawk=0;
        let target=null,minDist=Infinity;
        const cands=[...invaders.filter(i=>i.alive),...(boss?[boss]:[]),...miniBosses.filter(m=>m.alive)];
        const cx=player.x+player.w/2;
        for(const t of cands){const d=Math.hypot((t.x+t.w/2)-cx,(t.y+t.h/2)-player.y);if(d<minDist){minDist=d;target=t;}}
        bullets.push({x:cx-3,y:player.y-10,w:6,h:14,homing:true,target,bspd:BULLET_SPEED,vx:0,vy:-BULLET_SPEED,petBullet:true});
        playSound('shoot_homing');
      }
    }
    // turtle: 被ダメージ軽減 (onPlayerHit側で処理)
    // coin: プレイヤー周辺のコインパワーアップを自動取得 (addCoins内でboostで対応)
    // bomber: 480フレーム毎に爆弾投下
    if(def.effect==='bomber'){
      petTimers.bomber=(petTimers.bomber||0)+1;
      if(petTimers.bomber>=480){
        petTimers.bomber=0;
        const cands=[...invaders.filter(i=>i.alive),...(boss?[boss]:[])];
        const tgt=cands.length>0?cands[Math.floor(Math.random()*cands.length)]:null;
        const tx=tgt?tgt.x+tgt.w/2:player.x+(Math.random()-0.5)*200;
        const ty=tgt?tgt.y:100;
        const cx=player.x+player.w/2;
        const dist=Math.sqrt((tx-cx)**2+(ty-player.y)**2)||1;
        bullets.push({x:cx-5,y:player.y-10,w:10,h:10,explosive:true,bspd:7,
          vx:(tx-cx)/dist*7,vy:(ty-player.y)/dist*7,petBullet:true});
        playSound('shoot_expl');
      }
    }
    // ghost: 600フレーム毎に1秒無敵
    if(def.effect==='ghost'){
      petTimers.ghost=(petTimers.ghost||0)+1;
      if(petTimers.ghost>=600){
        petTimers.ghost=0;
        player.invincibleTimer=Math.max(player.invincibleTimer||0,70);
        triggerFlash(180,180,255,0.25);
        lifeGainDisplay={text:'GHOST: 無敵発動!',timer:90,color:'#aaaaff'};
      }
    }
    // fenrir (LR): 180フレーム毎に8方向全弾幕
    if(def.effect==='fenrir'){
      petTimers.fenrir=(petTimers.fenrir||0)+1;
      if(petTimers.fenrir>=180){
        petTimers.fenrir=0;
        const cx=player.x+player.w/2, cy=player.y+player.h/2;
        for(let d=0;d<8;d++){
          const a=(d/8)*Math.PI*2;
          bullets.push({x:cx-4,y:cy-4,w:8,h:8,vx:Math.cos(a)*(BULLET_SPEED+3),vy:Math.sin(a)*(BULLET_SPEED+3),bspd:BULLET_SPEED+3,petBullet:true});
        }
        triggerFlash(255,34,102,0.2);
        playSound('shoot_expl');
      }
    }
  }
  // valkyrie (LR): HP0になった時に一度だけ復活 (onPlayerHit側で処理)
}
function drawPets(){
  if(!player||state!=='playing') return;
  const activePets=playerLoadout.pets.filter(pid=>pid&&gachaInventory[pid]).map(pid=>PET_POOL.find(p=>p.id===pid)).filter(Boolean);
  activePets.forEach((def,i)=>{
    const angle=frameCount*0.045+i*(Math.PI*2/Math.max(activePets.length,1));
    const orbitX=40, orbitY=22;
    const px=player.x+player.w/2+Math.cos(angle)*orbitX;
    const py=player.y+player.h/2+Math.sin(angle)*orbitY;
    ctx.save(); ctx.translate(px,py);
    ctx.shadowColor=def.color; ctx.shadowBlur=10;
    ctx.fillStyle=def.color; ctx.globalAlpha=0.9;

    switch(def.effect){
      case 'dragon':{// 炎ドラゴン: トゲ付き三角
        const s=8+Math.sin(frameCount*0.15+i)*1.5;
        ctx.rotate(angle*0.3);
        ctx.beginPath(); ctx.moveTo(0,-s); ctx.lineTo(s*0.55,s*0.4); ctx.lineTo(0,s*0.2); ctx.lineTo(-s*0.55,s*0.4); ctx.closePath(); ctx.fill();
        // 炎粒子
        ctx.globalAlpha=0.5+Math.sin(frameCount*0.2)*0.3;
        ctx.fillStyle='#ff6600';
        ctx.beginPath(); ctx.arc(0,s*0.6,2.5,0,Math.PI*2); ctx.fill();
        break;
      }
      case 'hawk':{// 鷹: 矢型
        ctx.rotate(-Math.PI/2+angle*0.2);
        ctx.beginPath(); ctx.moveTo(9,0); ctx.lineTo(-5,-5); ctx.lineTo(-2,0); ctx.lineTo(-5,5); ctx.closePath(); ctx.fill();
        // 翼
        ctx.globalAlpha=0.45; ctx.fillStyle='#99ccff';
        ctx.beginPath(); ctx.moveTo(0,-2); ctx.lineTo(-8,-7); ctx.lineTo(-5,0); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(0,2); ctx.lineTo(-8,7); ctx.lineTo(-5,0); ctx.closePath(); ctx.fill();
        break;
      }
      case 'heal':{// スライム: ブロブ
        const blob=6+Math.sin(frameCount*0.12+i)*2;
        ctx.beginPath(); ctx.ellipse(0,1,blob*0.8,blob,0,0,Math.PI*2); ctx.fill();
        ctx.globalAlpha=0.5; ctx.fillStyle='#fff';
        ctx.beginPath(); ctx.ellipse(-blob*0.22,-blob*0.3,blob*0.22,blob*0.2,0,0,Math.PI*2); ctx.fill();
        break;
      }
      case 'fairy':{// フェアリー: 4点星
        const r=7+Math.sin(frameCount*0.18+i)*1.5;
        ctx.rotate(frameCount*0.05+i);
        for(let p=0;p<4;p++){
          const a=p*Math.PI/2;
          ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(a)*r,Math.sin(a)*r); ctx.lineTo(Math.cos(a+Math.PI/4)*r*0.35,Math.sin(a+Math.PI/4)*r*0.35); ctx.closePath(); ctx.fill();
        }
        break;
      }
      case 'phoenix':{// フェニックス: 炎の翼シルエット
        const flare=6+Math.sin(frameCount*0.1+i)*2;
        ctx.rotate(-Math.PI/2);
        ctx.beginPath(); ctx.moveTo(flare,0); ctx.lineTo(-flare*0.5,-flare*0.8); ctx.lineTo(-flare*0.3,0); ctx.lineTo(-flare*0.5,flare*0.8); ctx.closePath(); ctx.fill();
        ctx.globalAlpha=0.5; ctx.fillStyle='#ffdd00';
        ctx.beginPath(); ctx.arc(flare*0.3,0,flare*0.35,0,Math.PI*2); ctx.fill();
        break;
      }
      case 'exp':{// ボット: 小さいロボ四角
        const sz=6;
        ctx.beginPath(); ctx.roundRect(-sz,-sz,sz*2,sz*2,2); ctx.fill();
        ctx.globalAlpha=0.8; ctx.fillStyle='#fff';
        ctx.beginPath(); ctx.arc(-sz*0.3,-sz*0.2,sz*0.22,0,Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(sz*0.3,-sz*0.2,sz*0.22,0,Math.PI*2); ctx.fill();
        // アンテナ
        ctx.strokeStyle=def.color; ctx.lineWidth=1.5;
        ctx.beginPath(); ctx.moveTo(0,-sz); ctx.lineTo(0,-sz-4); ctx.stroke();
        ctx.beginPath(); ctx.arc(0,-sz-4,2,0,Math.PI*2);
        ctx.globalAlpha=0.9; ctx.fillStyle=def.color; ctx.fill();
        break;
      }
      case 'coin':{// ネコ: 猫型
        const r=7;
        ctx.beginPath(); ctx.ellipse(0,1,r*0.75,r,0,0,Math.PI*2); ctx.fill();
        // 耳
        ctx.beginPath(); ctx.moveTo(-r*0.5,-r*0.6); ctx.lineTo(-r*0.8,-r*1.1); ctx.lineTo(-r*0.15,-r*0.7); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(r*0.5,-r*0.6); ctx.lineTo(r*0.8,-r*1.1); ctx.lineTo(r*0.15,-r*0.7); ctx.closePath(); ctx.fill();
        // 目
        ctx.globalAlpha=0.9; ctx.fillStyle='#000';
        ctx.beginPath(); ctx.ellipse(-r*0.28,-r*0.1,r*0.14,r*0.2,0,0,Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.ellipse(r*0.28,-r*0.1,r*0.14,r*0.2,0,0,Math.PI*2); ctx.fill();
        break;
      }
      case 'turtle':{// タートル: 亀甲紋シェル
        const ts=7+Math.sin(frameCount*0.05+i)*0.5;
        ctx.beginPath(); ctx.arc(0,0,ts,0,Math.PI*2); ctx.fill();
        ctx.globalAlpha=0.5; ctx.strokeStyle='#006600'; ctx.lineWidth=1.2;
        for(let h=0;h<6;h++){const a=h*Math.PI/3; ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(a)*ts*0.85,Math.sin(a)*ts*0.85); ctx.stroke();}
        ctx.globalAlpha=0.9; ctx.fillStyle='#88cc88';
        ctx.beginPath(); ctx.arc(-ts*0.45,-ts*0.4,ts*0.18,0,Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.arc(ts*0.45,-ts*0.4,ts*0.18,0,Math.PI*2); ctx.fill();
        ctx.lineWidth=1;
        break;
      }
      case 'bomber':{// ボンバービー: 縞模様の楕円体
        ctx.rotate(angle*0.15);
        ctx.beginPath(); ctx.ellipse(0,0,8,6,0,0,Math.PI*2); ctx.fill();
        ctx.globalAlpha=0.5; ctx.fillStyle='#000';
        ctx.fillRect(-7,-2,4,4); ctx.fillRect(-1,-2,4,4); ctx.fillRect(4,-2,4,4);
        ctx.globalAlpha=0.8; ctx.fillStyle='rgba(255,255,100,0.8)';
        ctx.beginPath(); ctx.moveTo(-5,-4); ctx.lineTo(5,-4); ctx.lineTo(5,-8); ctx.lineTo(-5,-8); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(-5,4); ctx.lineTo(5,4); ctx.lineTo(5,8); ctx.lineTo(-5,8); ctx.closePath(); ctx.fill();
        ctx.globalAlpha=0.9;
        break;
      }
      case 'ghost':{// ゴースト: 半透明の幽霊形
        ctx.globalAlpha*=0.7+Math.sin(frameCount*0.08+i)*0.25;
        const gs=7;
        ctx.beginPath(); ctx.arc(0,-2,gs,Math.PI,0); ctx.lineTo(gs,-2+gs*0.6);
        for(let w=0;w<3;w++){const wx=gs-(w*2/3*gs*2); ctx.quadraticCurveTo(wx*0.8,-2+gs*0.3,wx*0.5,-2+gs*0.5);}
        ctx.lineTo(-gs,-2+gs*0.6); ctx.closePath(); ctx.fill();
        ctx.globalAlpha=0.95; ctx.fillStyle='#000';
        ctx.beginPath(); ctx.ellipse(-2.5,-3,1.5,2,0,0,Math.PI*2); ctx.fill();
        ctx.beginPath(); ctx.ellipse(2.5,-3,1.5,2,0,0,Math.PI*2); ctx.fill();
        break;
      }
      case 'fenrir':{// LRフェンリル: 狼の牙型
        const fs=9+Math.sin(frameCount*0.1+i)*1.5;
        ctx.rotate(angle*0.4);
        // 体
        ctx.beginPath(); ctx.moveTo(0,-fs); ctx.lineTo(fs*0.7,fs*0.3); ctx.lineTo(0,fs*0.1); ctx.lineTo(-fs*0.7,fs*0.3); ctx.closePath(); ctx.fill();
        // 牙 (レインボーグロー)
        ctx.globalAlpha=0.8;
        ctx.fillStyle=getLRColor(frameCount*0.1+i*1.5);
        ctx.shadowColor=ctx.fillStyle; ctx.shadowBlur=12;
        ctx.beginPath(); ctx.moveTo(-fs*0.25,fs*0.05); ctx.lineTo(-fs*0.1,fs*0.45); ctx.lineTo(0,fs*0.05); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(fs*0.25,fs*0.05); ctx.lineTo(fs*0.1,fs*0.45); ctx.lineTo(0,fs*0.05); ctx.closePath(); ctx.fill();
        ctx.shadowBlur=0;
        break;
      }
      case 'valkyrie':{// LRヴァルキリー: 翼の盾型
        const vs=8+Math.sin(frameCount*0.08+i)*1;
        ctx.rotate(angle*0.15);
        // 盾本体
        ctx.fillStyle=def.color;
        ctx.beginPath(); ctx.arc(0,-vs*0.2,vs*0.55,0,Math.PI*2); ctx.fill();
        // レインボー翼
        const vc=getLRColor(frameCount*0.08+i*2);
        ctx.globalAlpha=0.75; ctx.fillStyle=vc;
        ctx.shadowColor=vc; ctx.shadowBlur=10;
        ctx.beginPath(); ctx.moveTo(0,-vs*0.4); ctx.lineTo(-vs*1.3,-vs*0.6); ctx.lineTo(-vs*0.8,vs*0.4); ctx.closePath(); ctx.fill();
        ctx.beginPath(); ctx.moveTo(0,-vs*0.4); ctx.lineTo(vs*1.3,-vs*0.6); ctx.lineTo(vs*0.8,vs*0.4); ctx.closePath(); ctx.fill();
        ctx.shadowBlur=0;
        break;
      }
      default:{// デフォルト: 菱形
        ctx.beginPath(); ctx.moveTo(0,-7); ctx.lineTo(5,0); ctx.lineTo(0,7); ctx.lineTo(-5,0); ctx.closePath(); ctx.fill();
      }
    }
    ctx.shadowBlur=0; ctx.globalAlpha=1;
    ctx.restore();
  });
}

// ===== 護衛艦更新 =====
function updateEscortShip(){
  if(!escortShip||!escortShip.alive) return;
  escortShip.x+=escortShip.vx;
  if(escortShip.x<=0||escortShip.x+escortShip.w>=W) escortShip.vx*=-1;
  for(let i=invaderBullets.length-1;i>=0;i--){
    if(rectsOverlap(invaderBullets[i],escortShip)){
      invaderBullets.splice(i,1);
      escortShip.hp--;
      spawnExplosion(escortShip.x+escortShip.w/2,escortShip.y+escortShip.h/2,'#f80',4);
      triggerFlash(255,120,0,0.2);
      if(escortShip.hp<=0){escortShip.alive=false;triggerShake(10,20);triggerGameOver();return;}
    }
  }
  for(const inv of invaders.filter(i=>i.alive)){
    if(rectsOverlap(inv,escortShip)){
      inv.alive=false;
      escortShip.hp=Math.max(0,escortShip.hp-2);
      spawnExplosion(escortShip.x+escortShip.w/2,escortShip.y+escortShip.h/2,'#f80',6);
      if(escortShip.hp<=0){escortShip.alive=false;triggerGameOver();return;}
    }
  }
}

// ===== イベント =====
function tryTriggerEvent(){
  if(currentEvent||bossPhase) return;
  eventCooldown--;
  if(eventCooldown>0) return;
  eventCooldown=600+Math.floor(Math.random()*400);
  currentEvent=EVENT_LIST[Math.floor(Math.random()*EVENT_LIST.length)];
  eventTimer=300; playSound('event_start');
  if(currentEvent.id==='supply'){
    const types=['double','invincible','wide'];
    for(let i=0;i<5;i++) powerups.push({x:Math.random()*(W-24),y:-20-i*60,w:24,h:16,vy:2,type:types[Math.floor(Math.random()*3)]});
  }
  if(currentEvent.id==='emp'){
    invaderBullets=[];
    invaders.filter(i=>i.alive).forEach(inv=>{inv._stunTimer=120;});
  }
}
function updateEvent(){
  if(!currentEvent) return;
  eventTimer--;
  if(currentEvent.id==='meteor'&&Math.random()<0.08)
    meteors.push({x:Math.random()*W,y:-20,w:16,h:16,vy:3+Math.random()*3,alive:true});
  if(eventTimer<=0) currentEvent=null;
}
function updateMeteors(){
  for(let i=meteors.length-1;i>=0;i--){
    const m=meteors[i]; m.y+=m.vy;
    if(m.y>H){meteors.splice(i,1);continue;}
    // 弾を消す
    for(let j=invaderBullets.length-1;j>=0;j--){
      if(rectsOverlap(m,invaderBullets[j])){invaderBullets.splice(j,1);}
    }
    if(rectsOverlap(m,player)&&!(powerupActive==='invincible'||player.invincibleTimer>0)){
      meteors.splice(i,1); if(playerShield){absorbWithShield();return;}
      playSound('meteor_hit'); onPlayerHit(); return;
    }
  }
}

// ===== 小惑星更新 =====
function updateAsteroids(){
  if(!isAsteroidStage) return;
  for(let i=asteroids.length-1;i>=0;i--){
    const a=asteroids[i];
    if(!a.alive){asteroids.splice(i,1);continue;}
    a.x+=a.vx; a.y+=a.vy; a.angle+=a.rotSpeed;
    if(a.x<0||a.x+a.w>W) a.vx*=-1;
    if(a.y<0||a.y+a.h>H*0.75) a.vy*=-1;
    // プレイヤー弾を消す
    for(let j=bullets.length-1;j>=0;j--){
      if(rectsOverlap(bullets[j],a)){
        bullets.splice(j,1);
        a.hp--;
        spawnExplosion(a.x+a.w/2,a.y+a.h/2,'#888',4);
        playSound('asteroid_hit');
        if(a.hp<=0){
          spawnExplosion(a.x+a.w/2,a.y+a.h/2,'#aaa',12);
          a.alive=false;
          addExp(15); score+=30; updateHUD();
        }
        break;
      }
    }
    // プレイヤーに当たる
    if(rectsOverlap(a,player)&&!(powerupActive==='invincible'||player.invincibleTimer>0)){
      if(playerShield){absorbWithShield();}else{onPlayerHit();}
      return;
    }
  }
}

// ===== 爆発弾 =====
function explodeBomb(cx,cy){
  const R=70;
  spawnExplosion(cx,cy,'#f0f',20); triggerFlash(255,0,255,0.15);
  for(const inv of invaders){
    if(!inv.alive) continue;
    const dx=(inv.x+inv.w/2)-cx,dy=(inv.y+inv.h/2)-cy;
    if(Math.sqrt(dx*dx+dy*dy)<R){
      inv.alive=false;
      addCombo(inv.x+inv.w/2,inv.y,(3-inv.row)*10);
      spawnExplosion(inv.x+inv.w/2,inv.y+inv.h/2,'#f0f'); addExp(10); playSound('explosion');
    }
  }
  if(boss&&boss.entryDone&&!boss.shielded){
    const dx=(boss.x+boss.w/2)-cx,dy=(boss.y+boss.h/2)-cy;
    if(Math.sqrt(dx*dx+dy*dy)<R+boss.w/2){
      const {val:ud,isCrit:uc2}=calcPlayerDmg(playerUpgrades.damage*2); boss.hp-=ud; spawnDmgNum(boss.x+boss.w/2,boss.y,ud,uc2); playSound('boss_hit');
      if(boss.hp<=0){killBoss();return;}
    }
  }
}

// ===== プレイヤー被弾 =====
function checkPlayerHit(){
  if(powerupActive==='invincible'||player.invincibleTimer>0) return;
  for(let i=invaderBullets.length-1;i>=0;i--){
    if(rectsOverlap(invaderBullets[i],player)){
      invaderBullets.splice(i,1);
      if(playerShield){absorbWithShield();return;}
      onPlayerHit(); return;
    }
  }
  for(const inv of invaders.filter(i=>i.alive)){
    if(rectsOverlap(inv,player)){
      inv.alive=false;
      if(playerShield){absorbWithShield();return;}
      onPlayerHit(); return;
    }
  }
}

function fireCounterShot(){
  if(!player) return;
  const cx=player.x+player.w/2, cy=player.y+player.h/2;
  for(let a=-30;a<=30;a+=30){
    const rad=(-Math.PI/2)+(a*Math.PI/180);
    bullets.push({x:cx-3,y:cy,w:6,h:12,vx:Math.cos(rad)*(BULLET_SPEED+2),vy:Math.sin(rad)*(BULLET_SPEED+2),bspd:BULLET_SPEED+2,petBullet:true});
  }
  playSound('shoot');
}

function absorbWithShield(){
  playerShield=false; triggerFlash(50,150,255,0.4); triggerShake(6,8);
  lifeGainDisplay={text:'SHIELD BREAK',timer:90,color:'#4af'};
  spawnExplosion(player.x+player.w/2,player.y+player.h/2,'#4af',16);
  player.invincibleTimer=60; playSound('powerup');
  if(gachaInventory['passive_shield_burst']?.level>=1){
    const cx=player.x+player.w/2, cy=player.y+player.h/2;
    for(let a=0;a<360;a+=45){
      const rad=a*Math.PI/180;
      bullets.push({x:cx-3,y:cy,w:8,h:8,vx:Math.cos(rad)*6,vy:Math.sin(rad)*6,bspd:6,explosive:true,petBullet:true});
    }
    lifeGainDisplay={text:'SHIELD BURST!',timer:90,color:'#ffdd00'};
    playSound('shoot_expl');
  }
}

function onPlayerHit(){
  stageStats.hits++;
  addUltimateGauge(12);
  const turtleMod=getPetEffect('turtle')?0.85:1;
  const dmg=Math.max(5,Math.floor(25*(1-playerStats.def/100)*turtleMod));
  playerStats.hp=Math.max(0,playerStats.hp-dmg);
  // ペット: slime heal
  if(getPetEffect('heal')&&playerStats.hp>0) playerStats.hp=Math.min(playerStats.maxHp,playerStats.hp+15);
  updateHUD();
  spawnExplosion(player.x+player.w/2,player.y+player.h/2,'#0f0',20);
  triggerShake(12,15); triggerFlash(255,0,0,0.4); hitFlashTimer=40;
  playSound('player_hit');
  if(playerStats.hp<=0){
    // valkyrie (LR): 一度だけHP60で復活
    if(getPetEffect('valkyrie')&&!player._valkyrieUsed){
      player._valkyrieUsed=true;
      playerStats.hp=60; updateHUD();
      player.invincibleTimer=180;
      triggerFlash(255,34,102,0.6);
      lifeGainDisplay={text:'★ VALKYRIE 復活!! HP60 ★',timer:120,color:'#ff2266'};
      return;
    }
    triggerGameOver();return;
  }
  // phoenix: 30%以下で無敵
  if(getPetEffect('phoenix')&&playerStats.hp<=playerStats.maxHp*0.3){
    player.invincibleTimer=Math.max(player.invincibleTimer,120);
    lifeGainDisplay={text:'PHOENIX  無敵発動！',timer:90,color:'#f80'};
  } else {
    lifeGainDisplay={text:`HP  -${dmg}  (${playerStats.hp}/${playerStats.maxHp})`,timer:90,color:'#f44'};
  }
  player.invincibleTimer=Math.max(player.invincibleTimer,120+playerUpgrades.invincibleBonus);
  if(gachaInventory['passive_counter']?.level>=1) fireCounterShot();
}

function rectsOverlap(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}

function triggerGameOver(){
  const wasRecord=score>0&&score>=(hiScores[0]||0);
  if(score>0) saveScore(score);
  const nr=wasRecord?'\n★ NEW RECORD! ★':'';
  playerStats.hp=0; updateHUD();
  state='gameover'; stopBGM();
  triggerFlash(255,0,0,0.6); playSound('gameover');
  showMessage(`ゲームオーバー\nスコア: ${score}${nr}\nSPACE: タイトルへ  /  R: 即リトライ`);
}

function updateHUD(){
  scoreEl.textContent=score;
  const livesHtmlEl=document.getElementById('lives');
  if(livesHtmlEl) livesHtmlEl.textContent=`${playerStats.hp}/${playerStats.maxHp}`;
  stageEl.textContent=stage;
  const h=document.getElementById('hiscore');
  if(h) h.textContent=Math.max(score,hiScore);
  const c=document.getElementById('coins');
  if(c) c.textContent=coins;
  const g=document.getElementById('gems');
  if(g) g.textContent=gems;
}
function showMessage(text){
  if(text===null) messageEl.classList.add('hidden');
  else{messageEl.textContent=text;messageEl.classList.remove('hidden');}
}

// ===== メイン更新（本体は js/game/update-tick.js）=====
function buildGameTickEnv() {
  const env = {};
  const tickNames = [
    'groundPulse', 'state', 'paused', 'stageCharX', 'stageCharY', 'stageCharTX', 'stageCharTY',
    'stars', 'frameCount', 'W', 'H', 'stageClearAnimTimer', 'stageResultData', 'matPopups',
    'stageBannerTimer', 'bossWarningTimer', 'powerupActive', 'powerupTimer', 'player',
    'hitFlashTimer', 'comboTimer', 'combo', 'comboDisplay', 'lifeGainDisplay', 'levelUpDisplay',
    'muzzleFlashes', 'ultimateActive', 'ultimateTimer', 'dashCooldown', 'dashTimer', 'dashTrail',
    'chargeTimer', 'chargeReady', 'lastShot', 'bullets', 'invaderBullets', 'particles',
    'shakeTimer', 'ufo', 'powerups', 'playerShield', 'skillChoices', 'bossPhase', 'bossRushDelay',
    'survivalTimer', 'invaders', 'escortShip', 'formationTimer', 'gachaInventory', 'passiveRegenTimer',
    'waveBannerTimer', 'waveState', 'waveNum', 'waveDelay', 'boss', 'currentEvent', 'sessionProgress',
    'score', 'stage', 'stageType', 'playerStats', 'playerUpgrades'
  ];
  for (const n of tickNames) {
    Object.defineProperty(env, n, {
      enumerable: true,
      configurable: true,
      get() { return eval(n); },
      set(v) { eval(n + ' = v'); }
    });
  }
  Object.assign(env, {
    playSound,
    fireBullet,
    explodeBomb,
    rectsOverlap,
    trySpawnUFO,
    updateMeteors,
    updateAsteroids,
    tryTriggerEvent,
    updateEvent,
    spawnBoss,
    updateBoss,
    updateMiniBosses,
    updateBossMinions,
    updateHealers,
    checkPlayerHit,
    updateEscortShip,
    updatePets,
    spawnExplosion,
    spawnFormation,
    startWave,
    getWaveCount,
    updateHUD,
    triggerFlash,
    addExp,
    addCoins,
    checkAndClaimMissions,
    spawnPowerup,
    spawnDmgNum,
    calcPlayerDmg,
    dropMaterial,
    addCombo
  });
  return env;
}
setGameTickEnv(buildGameTickEnv());

// ===== 描画（ルーティングは js/game/draw-dispatch.js）=====
function draw(){ paintFrame(drawDeps); }
const drawDeps={
  get ctx(){ return ctx; }, get W(){ return W; }, get H(){ return H; },
  getTheme,
  get state(){ return state; },
  get shakeTimer(){ return shakeTimer; },
  get shakeIntensity(){ return shakeIntensity; },
  get paused(){ return paused; },
  get stageClearAnimTimer(){ return stageClearAnimTimer; },
  get skillChoices(){ return skillChoices; },
  get escortShip(){ return escortShip; },
  get boss(){ return boss; },
  get ufo(){ return ufo; },
  bumpGachaAnimFrame(){ gachaAnimFrame++; },
  drawStarfield, drawTitle, drawVignette, drawCustomizeScreen, drawLoadoutScreen, drawUIButtons,
  drawStageSelectScreen, drawMapScreen, drawShopScreen, drawGachaScreen, drawGachaResult, drawGachaSummary,
  drawGachaRates, drawStardustShop, drawStageResult,
  drawAsteroids, drawMeteors, drawEscortShip, drawDashTrail, drawInvaders, drawHealers, drawBoss,
  drawMiniBosses, drawBossMinions, drawUFO, drawPowerups, drawPlayer, drawPets, drawBullets, drawMuzzleFlashes,
  drawParticles, updateDamageNumbers, drawDamageNumbers, drawGroundLine, drawHUD, drawBossWarning,
  drawSurvivalTimer, drawStageBanner, drawWaveBanner, drawLifeGainDisplay, drawLevelUpDisplay, drawSkillChoice,
  drawEventBanner, drawMatPopups, drawStageClearAnim, drawHitFlash, drawScreenFlash, drawScanlines,
  drawPauseOverlay,
};
function drawPauseOverlay(){
  ctx.fillStyle='rgba(0,0,0,0.78)'; ctx.fillRect(0,0,W,H);
  const cx=W/2;
  const pAccent=getTheme().accent;
  ctx.shadowColor=pAccent; ctx.shadowBlur=30;
  ctx.fillStyle='#fff'; ctx.font='bold 40px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('PAUSED',cx,120); ctx.shadowBlur=0;
  ctx.fillStyle='#556'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText('ESC to resume',cx,148);

  // HP bar
  const hpRatio=playerStats.hp/playerStats.maxHp;
  const hpColor=hpRatio>0.5?'#00ff88':hpRatio>0.25?'#ffaa00':'#ff3333';
  ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(cx-160,168,320,14,4); ctx.fill();
  ctx.fillStyle=hpColor; ctx.shadowColor=hpColor; ctx.shadowBlur=8;
  ctx.beginPath(); ctx.roundRect(cx-160,168,320*hpRatio,14,4); ctx.fill();
  ctx.shadowBlur=0;
  ctx.fillStyle='#ccc'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`HP  ${playerStats.hp} / ${playerStats.maxHp}`,cx,194);

  // Stat grid
  const stats=[
    {l:'ATK',v:`×${playerStats.atk.toFixed(2)}`,c:'#ff8844'},
    {l:'DEF',v:`${playerStats.def}%`,c:'#44aaff'},
    {l:'CRIT',v:`${playerStats.crit}%`,c:'#ffdd00'},
    {l:'SPD',v:`+${playerStats.spd}`,c:'#88ffcc'},
  ];
  stats.forEach((s,i)=>{
    const col=i%2, row=Math.floor(i/2);
    const bx=cx-158+col*162, by=210+row*48;
    ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(bx,by,150,38,5); ctx.fill();
    ctx.strokeStyle='#1a2a1a'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(bx,by,150,38,5); ctx.stroke();
    ctx.fillStyle='#445'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(s.l,bx+10,by+14);
    ctx.fillStyle=s.c; ctx.shadowColor=s.c; ctx.shadowBlur=5;
    ctx.font='bold 15px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(s.v,bx+140,by+28); ctx.shadowBlur=0;
  });

  // Weapon
  const wpId=playerLoadout.weaponId;
  const wpDef=wpId?WEAPON_GACHA_POOL.find(w=>w.id===wpId):null;
  const wpLabel=wpDef?wpDef.label:'CLASSIC';
  const ammoTxt=wpDef?`${weaponAmmo[wpDef.weapon]??0}/${wpDef.ammo}`:'∞';
  ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(cx-158,308,316,36,5); ctx.fill();
  ctx.strokeStyle='#1a2a1a'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(cx-158,308,316,36,5); ctx.stroke();
  ctx.fillStyle='#556'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='left'; ctx.fillText('WEAPON',cx-148,322);
  ctx.fillStyle='#ff8833'; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='right';
  ctx.fillText(`${wpLabel}  ${ammoTxt}`,cx+148,322);
  ctx.fillStyle='#444'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='right';
  ctx.fillText('ammo',cx+148,337);

  // Active pets
  const activePets=playerLoadout.pets.filter(pid=>pid&&gachaInventory[pid]);
  if(activePets.length>0){
    ctx.fillStyle='#334'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('ACTIVE PETS',cx,368);
    activePets.forEach((pid,i)=>{
      const petDef=PET_POOL.find(p=>p.id===pid);
      if(!petDef) return;
      const px=cx+(i-activePets.length/2+0.5)*110;
      ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(px-48,374,96,40,5); ctx.fill();
      ctx.save(); ctx.translate(px-26,394); ctx.scale(0.6,0.6); drawPetShape(petDef.effect,petDef.color); ctx.restore();
      ctx.fillStyle=petDef.color; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='left';
      ctx.fillText(petDef.label,px-12,397);
    });
  }

  // Stage info
  ctx.fillStyle='#334'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`STAGE ${stage}  ·  SCORE ${score}  ·  COMBO ${combo}`,cx,432);
  ctx.textAlign='left';
}

function drawStarfield(){
  for(const s of stars){
    const tw=0.4+Math.sin(s.twinkle)*0.6;
    ctx.globalAlpha=tw*(0.4+s.layer*0.25);
    ctx.fillStyle=s.layer===2?'#aaf':'#fff';
    ctx.fillRect(s.x,s.y,s.size,s.size);
  }
  ctx.globalAlpha=1;
}

function drawTitle(){
  const t=Date.now()/1000;
  ctx.shadowColor='#ff4422'; ctx.shadowBlur=30;
  ctx.fillStyle='#ff8855'; ctx.font='bold 42px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('PLANET SHOOTING',W/2,H/2-120); ctx.shadowBlur=0;
  ctx.fillStyle='#ff6633'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText('惑星をめぐり敵を倒せ',W/2,H/2-95);
  ctx.font='15px Orbitron,Courier New'; ctx.fillStyle='#ffff44';
  ctx.shadowColor='#ff0'; ctx.shadowBlur=10;
  ctx.fillText(`HI-SCORE  ${hiScore}`,W/2,H/2-72); ctx.shadowBlur=0;
  if(hiScores.length>1){
    ctx.fillStyle='#666'; ctx.font='10px Orbitron,Courier New';
    hiScores.slice(0,5).forEach((s,i)=>{
      ctx.fillStyle=i===0?'#ff0':i===1?'#aaa':i===2?'#c84':'#555';
      ctx.fillText(`${i+1}. ${s}`,W/2-60+i*30,H/2-52);
    });
  }
  ctx.fillStyle='#88ff88'; ctx.font='13px Orbitron,Courier New';
  ctx.fillText('← → ↑ ↓  MOVE    Z/SPACE  FIRE (hold=CHARGE)    Q  WEAPON',W/2,H/2-20);
  ctx.fillText('SHIFT  DASH',W/2,H/2+4);
  if(Math.sin(t*3)>0){
    ctx.fillStyle='#fff'; ctx.shadowColor='#fff'; ctx.shadowBlur=15;
    ctx.font='bold 20px Orbitron,Courier New';
    ctx.fillText('SPACE :  CUSTOMIZE  &  START',W/2,H/2+46); ctx.shadowBlur=0;
  }
  ctx.fillStyle='#44bbff'; ctx.font='12px Orbitron,Courier New';
  ctx.fillText('DEFEAT ENEMIES → BOSS → ROUTE SELECT → NEXT STAGE',W/2,H/2+82);
  ctx.fillText('MARS → VENUS → JUPITER → SATURN  /  BOSS ENCOUNTERS',W/2,H/2+104);
  [0,1,2].forEach(i=>{ const bob=Math.sin(t*2+i)*4; drawInvaderSprite(ctx,W/2-80+i*50,H/2+145+bob,Math.floor(t*2)%2,i); });
  // 実績カウント（絵文字なし）
  const unlocked=ACHIEVEMENT_DEFS.filter(d=>achievements[d.id]);
  if(unlocked.length>0){
    ctx.fillStyle='#444'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`ACHIEVEMENTS  ${unlocked.length} / ${ACHIEVEMENT_DEFS.length}`,W/2,H/2+188);
  }
  // 最高到達ステージ
  if(highestStage>1){
    ctx.fillStyle='#555'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(`BEST STAGE: ${highestStage}`,W-12,H-8);
  }
  ctx.textAlign='left';
}

function drawUpgradeScreen(){
  ctx.fillStyle='rgba(0,0,0,0.85)'; ctx.fillRect(0,0,W,H);
  // ランクバッジ
  if(stageRank){
    const rcol={S:'#ff0',A:'#0f0',B:'#0cf',C:'#aaa'}[stageRank];
    ctx.shadowColor=rcol; ctx.shadowBlur=30;
    ctx.fillStyle=rcol; ctx.font='bold 72px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(stageRank,W-40,100); ctx.shadowBlur=0;
    ctx.fillStyle=rcol; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(`HIT:${stageStats.hits}  COMBO:${stageStats.maxCombo}`,W-40,115);
  }
  ctx.fillStyle='#fff'; ctx.font='bold 28px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor='#ff0'; ctx.shadowBlur=20;
  ctx.fillText('UPGRADE  SELECT',W/2,80); ctx.shadowBlur=0;
  ctx.font='14px Orbitron,Courier New'; ctx.fillStyle='#aaa';
  ctx.fillText('1 / 2 / 3 キーで選択',W/2,115);
  upgradeChoices.forEach((up,i)=>{
    const x=80+i*230,y=160,w=200,h=260;
    ctx.fillStyle='rgba(10,10,30,0.9)'; ctx.strokeStyle=up.color; ctx.lineWidth=2;
    ctx.shadowColor=up.color; ctx.shadowBlur=15;
    ctx.beginPath(); ctx.roundRect(x,y,w,h,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=up.color; ctx.font='bold 36px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`${i+1}`,x+w/2,y+52);
    ctx.fillStyle='#fff'; ctx.font='bold 14px Orbitron,Courier New';
    ctx.fillText(up.label,x+w/2,y+96);
    ctx.fillStyle='#aaa'; ctx.font='12px Orbitron,Courier New';
    const words=up.desc; let line='',ly=y+126;
    for(const ch of words){
      if(ctx.measureText(line+ch).width>w-20){ctx.fillText(line,x+w/2,ly);line=ch;ly+=20;}
      else line+=ch;
    }
    if(line) ctx.fillText(line,x+w/2,ly);
  });
  ctx.textAlign='left'; ctx.lineWidth=1;
}

function drawDashTrail(){
  for(const t of dashTrail){
    ctx.globalAlpha=t.alpha*0.4;
    ctx.fillStyle='#4af';
    ctx.fillRect(t.x+8,t.y+10,t.w-16,t.h-10);
    ctx.fillRect(t.x+t.w/2-4,t.y,8,14);
  }
  ctx.globalAlpha=1;
}

function drawShipShape(x,y,w,h,shapeId){
  const shape=shapeId||SHIP_SHAPES[shipShapeIdx].id;
  if(shape==='fighter'){
    ctx.fillRect(x+8,y+10,w-16,h-10);
    ctx.fillRect(x+w/2-4,y,8,14);
    ctx.fillRect(x,y+h-8,14,8);
    ctx.fillRect(x+w-14,y+h-8,14,8);
  } else if(shape==='agile'){
    ctx.fillRect(x+14,y+10,w-28,h-10);
    ctx.fillRect(x+w/2-3,y,6,18);
    ctx.fillRect(x+4,y+h-6,12,6);
    ctx.fillRect(x+w-16,y+h-6,12,6);
  } else if(shape==='heavy'){
    ctx.fillRect(x+4,y+8,w-8,h-8);
    ctx.fillRect(x+w/2-6,y+2,12,10);
    ctx.fillRect(x,y+h-10,18,10);
    ctx.fillRect(x+w-18,y+h-10,18,10);
    ctx.fillRect(x+2,y+12,6,8);
    ctx.fillRect(x+w-8,y+12,6,8);
  }
}
function drawPlayer(){
  if(powerupActive==='invincible'||player.invincibleTimer>0){
    if(Math.floor(frameCount/4)%2===0) return;
  }
  const {x,y,w,h}=player;
  const shipColor=SHIP_COLORS[shipColorIdx].hex;
  const color=powerupActive==='wide'?'#f0f':powerupActive==='double'?'#ff0':shipColor;
  // チャージゲージ
  if(chargeTimer>0){
    const ratio=chargeTimer/CHARGE_MAX;
    ctx.strokeStyle=`rgba(255,200,0,${ratio})`;
    ctx.lineWidth=3; ctx.shadowColor='#ff0'; ctx.shadowBlur=ratio*20;
    ctx.beginPath(); ctx.arc(x+w/2,y+h/2,28+ratio*8,0,Math.PI*2*ratio); ctx.stroke();
    ctx.shadowBlur=0; ctx.lineWidth=1;
    if(chargeReady){
      const p2=0.6+Math.sin(frameCount*0.3)*0.4;
      ctx.strokeStyle=`rgba(255,220,0,${p2})`;
      ctx.lineWidth=4; ctx.beginPath(); ctx.arc(x+w/2,y+h/2,40,0,Math.PI*2); ctx.stroke();
      ctx.lineWidth=1;
    }
  }
  ctx.shadowColor=color; ctx.shadowBlur=14; ctx.fillStyle=color;
  drawShipShape(x,y,w,h);
  ctx.shadowBlur=0;
  // エンジン炎（形状ごとに異なる）
  const shape=SHIP_SHAPES[shipShapeIdx].id;
  ctx.globalAlpha=0.8;
  if(shape==='agile'){
    const fh=6+Math.random()*8;
    ctx.fillStyle='#f60'; ctx.fillRect(x+w/2-3,y+h,6,fh);
    ctx.fillStyle='#ff0'; ctx.fillRect(x+w/2-2,y+h,4,fh*0.5);
  } else if(shape==='heavy'){
    const fh=6+Math.random()*8;
    ctx.fillStyle='#f60'; ctx.fillRect(x+6,y+h,10,fh); ctx.fillRect(x+w-16,y+h,10,fh);
    ctx.fillStyle='#ff0'; ctx.fillRect(x+8,y+h,6,fh*0.5); ctx.fillRect(x+w-14,y+h,6,fh*0.5);
  } else {
    const fh=4+Math.random()*6;
    ctx.fillStyle='#f60'; ctx.fillRect(x+12,y+h,8,fh);
    ctx.fillStyle='#ff0'; ctx.fillRect(x+14,y+h,4,fh*0.5);
  }
  ctx.globalAlpha=1;
  // シールドリング
  if(playerShield){
    const pulse=0.6+Math.sin(frameCount*0.15)*0.4;
    ctx.globalAlpha=pulse;
    ctx.strokeStyle='#4af'; ctx.lineWidth=3;
    ctx.shadowColor='#4af'; ctx.shadowBlur=18;
    ctx.beginPath(); ctx.arc(x+w/2,y+h/2,34,0,Math.PI*2); ctx.stroke();
    ctx.shadowBlur=0; ctx.lineWidth=1; ctx.globalAlpha=1;
  }
}

function drawMuzzleFlashes(){
  for(const m of muzzleFlashes){
    const a=m.timer/m.maxTimer,r=(1-a)*16+4;
    const gr=ctx.createRadialGradient(m.x,m.y,0,m.x,m.y,r);
    gr.addColorStop(0,`rgba(255,255,255,${a})`);
    gr.addColorStop(1,'rgba(255,255,100,0)');
    ctx.fillStyle=gr; ctx.beginPath(); ctx.arc(m.x,m.y,r,0,Math.PI*2); ctx.fill();
  }
}

function drawUFODrone(inv){
  const cx=inv.x+inv.w/2, cy=inv.y+inv.h/2;
  ctx.save();
  ctx.translate(cx,cy);
  // saucer body
  ctx.shadowColor='#00ffee'; ctx.shadowBlur=12;
  ctx.fillStyle='#00ccdd';
  ctx.beginPath(); ctx.ellipse(0,4,inv.w/2,5,0,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#00ffee';
  ctx.beginPath(); ctx.ellipse(0,0,inv.w/2-4,8,0,0,Math.PI*2); ctx.fill();
  // dome
  ctx.fillStyle='rgba(100,255,240,0.5)';
  ctx.beginPath(); ctx.ellipse(0,-3,10,6,0,Math.PI,Math.PI*2); ctx.fill();
  // lights
  const lt=Date.now()/300;
  for(let i=0;i<4;i++){
    const a=i*Math.PI/2+lt;
    ctx.fillStyle=i%2===0?'#ff0':'#0ff';
    ctx.beginPath(); ctx.arc(Math.cos(a)*14,4+Math.sin(a)*2,2,0,Math.PI*2); ctx.fill();
  }
  ctx.restore();
  // HP bar
  if(inv.hp<inv.maxHp){
    ctx.fillStyle='#333'; ctx.fillRect(inv.x,inv.y-6,inv.w,3);
    ctx.fillStyle='#0ff'; ctx.fillRect(inv.x,inv.y-6,inv.w*(inv.hp/inv.maxHp),3);
  }
}

function drawSpider(inv){
  const cx=inv.x+inv.w/2, cy=inv.y+inv.h/2;
  ctx.save();
  ctx.translate(cx,cy);
  ctx.shadowColor='#ff4488'; ctx.shadowBlur=10;
  // legs (4 pairs)
  ctx.strokeStyle='#cc2266'; ctx.lineWidth=2;
  const legAngles=[-0.9,-0.5,0.5,0.9];
  for(const a of legAngles){
    ctx.beginPath(); ctx.moveTo(-4,0); ctx.lineTo(-14+Math.cos(a+Math.PI)*8,Math.sin(a+Math.PI)*10); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(4,0); ctx.lineTo(14+Math.cos(a)*8,Math.sin(a)*10); ctx.stroke();
  }
  // body
  ctx.fillStyle='#aa2255';
  ctx.beginPath(); ctx.ellipse(0,0,10,7,0,0,Math.PI*2); ctx.fill();
  ctx.fillStyle='#ff4488';
  ctx.beginPath(); ctx.ellipse(0,-3,6,5,0,0,Math.PI*2); ctx.fill();
  // eyes
  ctx.fillStyle='#ff0';
  ctx.beginPath(); ctx.arc(-3,-4,2,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(3,-4,2,0,Math.PI*2); ctx.fill();
  ctx.restore();
  if(inv.hp<inv.maxHp){
    ctx.fillStyle='#333'; ctx.fillRect(inv.x,inv.y-6,inv.w,3);
    ctx.fillStyle='#ff44aa'; ctx.fillRect(inv.x,inv.y-6,inv.w*(inv.hp/inv.maxHp),3);
  }
}

function drawCrystal(inv){
  const cx=inv.x+inv.w/2, cy=inv.y+inv.h/2;
  ctx.save();
  ctx.translate(cx,cy);
  const pulse=0.85+Math.sin(Date.now()/400)*0.15;
  ctx.shadowColor='#aaddff'; ctx.shadowBlur=16*pulse;
  // main crystal (hexagon-ish)
  ctx.fillStyle=`rgba(160,210,255,${0.7+pulse*0.2})`;
  ctx.beginPath();
  for(let i=0;i<6;i++){
    const a=i*Math.PI/3-Math.PI/6;
    i===0?ctx.moveTo(Math.cos(a)*14,Math.sin(a)*18):ctx.lineTo(Math.cos(a)*14,Math.sin(a)*18);
  }
  ctx.closePath(); ctx.fill();
  // inner highlight
  ctx.fillStyle=`rgba(220,240,255,${0.4+pulse*0.3})`;
  ctx.beginPath();
  for(let i=0;i<6;i++){
    const a=i*Math.PI/3-Math.PI/6;
    i===0?ctx.moveTo(Math.cos(a)*7,Math.sin(a)*9):ctx.lineTo(Math.cos(a)*7,Math.sin(a)*9);
  }
  ctx.closePath(); ctx.fill();
  // facet lines
  ctx.strokeStyle='rgba(200,230,255,0.6)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(0,-18); ctx.lineTo(0,18); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(-14,-9); ctx.lineTo(14,9); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(14,-9); ctx.lineTo(-14,9); ctx.stroke();
  ctx.restore();
  if(inv.hp<inv.maxHp){
    const r=inv.hp/inv.maxHp;
    ctx.fillStyle='#333'; ctx.fillRect(inv.x,inv.y-8,inv.w,4);
    ctx.fillStyle=r>0.5?'#88ccff':'#ff8844'; ctx.fillRect(inv.x,inv.y-8,inv.w*r,4);
  }
}

function drawHeavy(inv){
  const cx=inv.x+inv.w/2, cy=inv.y+inv.h/2;
  ctx.save();
  ctx.translate(cx,cy);
  ctx.shadowColor='#ff6600'; ctx.shadowBlur=18;
  // thruster glow
  const tg=0.6+Math.sin(Date.now()/120)*0.4;
  ctx.fillStyle=`rgba(255,80,0,${tg*0.6})`;
  ctx.beginPath(); ctx.ellipse(0,20,12,8,0,0,Math.PI*2); ctx.fill();
  // main hull
  ctx.fillStyle='#884400';
  ctx.fillRect(-20,-16,40,30);
  ctx.fillStyle='#cc6600';
  ctx.fillRect(-16,-20,32,10);
  ctx.fillRect(-22,-8,44,20);
  // armor plates
  ctx.fillStyle='#ff8800';
  ctx.fillRect(-18,-18,8,6); ctx.fillRect(10,-18,8,6);
  ctx.fillRect(-24,-6,6,14); ctx.fillRect(18,-6,6,14);
  // cockpit
  ctx.fillStyle='#ffaa44';
  ctx.fillRect(-8,-18,16,8);
  ctx.fillStyle='rgba(255,200,100,0.5)';
  ctx.fillRect(-6,-16,12,5);
  // cannons
  ctx.fillStyle='#553300';
  ctx.fillRect(-26,4,8,6); ctx.fillRect(18,4,8,6);
  ctx.restore();
  // HP bar always shown for heavy
  const r=inv.hp/inv.maxHp;
  ctx.fillStyle='#333'; ctx.fillRect(inv.x,inv.y-10,inv.w,5);
  ctx.fillStyle=r>0.6?'#ff6600':r>0.3?'#ff9900':'#ff0000';
  ctx.fillRect(inv.x,inv.y-10,inv.w*r,5);
}

function drawInvaders(){
  invaders.forEach(inv=>{
    if(!inv.alive) return;
    if(inv.invType==='ufo_drone'){ drawUFODrone(inv); return; }
    if(inv.invType==='spider'){ drawSpider(inv); return; }
    if(inv.invType==='crystal'){ drawCrystal(inv); return; }
    if(inv.invType==='heavy'){ drawHeavy(inv); return; }
    const typeCol={fast:'#00ffff',tank:'#ffffff',sniper:'#ff8800',bomber:'#ff44ff',normal:null}[inv.invType||'normal'];
    ctx.shadowColor=typeCol||['#ff5555','#ffff00','#00ffff'][inv.row<=0?0:inv.row<=1?1:2];
    ctx.shadowBlur=inv.formation?14:8;
    if(typeCol) ctx.fillStyle=typeCol;
    drawInvaderSprite(ctx,inv.x,inv.y,inv.frame,inv.row,typeCol);
    ctx.shadowBlur=0;
    // TANKのHPバー
    if(inv.invType==='tank'&&inv.maxHp>1){
      ctx.fillStyle='#333'; ctx.fillRect(inv.x,inv.y-6,inv.w,4);
      ctx.fillStyle=inv.hp/inv.maxHp>0.5?'#0f0':'#ff0';
      ctx.fillRect(inv.x,inv.y-6,inv.w*(inv.hp/inv.maxHp),4);
    }
  });
}

function drawInvaderSprite(ctx,x,y,frame,row,overrideColor){
  const type=row<=0?0:row<=1?1:2;
  const planetCols=getPlanetEnemyColors(stage);
  ctx.fillStyle=overrideColor||planetCols[type]||['#f55','#ff0','#0ff'][type];
  if(type===0){
    ctx.fillRect(x+10,y,16,6);ctx.fillRect(x+4,y+6,28,6);ctx.fillRect(x,y+12,36,8);
    if(frame===0){ctx.fillRect(x+4,y+20,8,6);ctx.fillRect(x+24,y+20,8,6);}
    else{ctx.fillRect(x,y+20,8,6);ctx.fillRect(x+28,y+20,8,6);}
  } else if(type===1){
    ctx.fillRect(x+8,y,20,6);ctx.fillRect(x+4,y+6,28,6);ctx.fillRect(x,y+12,36,6);
    ctx.fillRect(x+4,y+18,10,6);ctx.fillRect(x+22,y+18,10,6);
    if(frame===0){ctx.fillRect(x+2,y+20,6,6);ctx.fillRect(x+28,y+20,6,6);}
    else{ctx.fillRect(x+6,y+22,6,4);ctx.fillRect(x+24,y+22,6,4);}
  } else {
    ctx.fillRect(x+6,y,24,6);ctx.fillRect(x+2,y+6,32,6);ctx.fillRect(x,y+12,36,8);
    if(frame===0){ctx.fillRect(x+2,y+20,8,6);ctx.fillRect(x+14,y+20,8,6);ctx.fillRect(x+26,y+20,8,6);}
    else{ctx.fillRect(x+4,y+20,8,6);ctx.fillRect(x+18,y+20,8,6);ctx.fillRect(x+28,y+22,8,4);}
  }
}

function drawHealers(){
  for(const h of healers){
    if(!h.alive) continue;
    ctx.shadowColor='#0f0'; ctx.shadowBlur=12; ctx.fillStyle='#0f0';
    ctx.beginPath();
    ctx.moveTo(h.x+h.w/2,h.y); ctx.lineTo(h.x+h.w,h.y+h.h/2);
    ctx.lineTo(h.x+h.w/2,h.y+h.h); ctx.lineTo(h.x,h.y+h.h/2);
    ctx.closePath(); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font='bold 10px Courier New'; ctx.textAlign='center';
    ctx.fillText('+',h.x+h.w/2,h.y+h.h/2+4); ctx.textAlign='left'; ctx.shadowBlur=0;
  }
}

function drawAsteroids(){
  for(const a of asteroids){
    if(!a.alive) continue;
    ctx.save();
    ctx.translate(a.x+a.w/2,a.y+a.h/2);
    ctx.rotate(a.angle);
    ctx.shadowColor='#888'; ctx.shadowBlur=8;
    const ratio=a.hp/a.maxHp;
    ctx.fillStyle=ratio>0.6?'#888':ratio>0.3?'#a64':'#f44';
    // 不規則な多角形っぽく
    ctx.beginPath();
    const pts=8;
    for(let i=0;i<pts;i++){
      const ang=(Math.PI*2*i/pts);
      const r=(a.w/2)*(0.75+Math.sin(i*3+a.angle*0.5)*0.25);
      if(i===0) ctx.moveTo(Math.cos(ang)*r,Math.sin(ang)*r);
      else ctx.lineTo(Math.cos(ang)*r,Math.sin(ang)*r);
    }
    ctx.closePath(); ctx.fill();
    ctx.shadowBlur=0;
    ctx.restore();
  }
}

function drawMeteors(){
  for(const m of meteors){
    ctx.shadowColor='#f84'; ctx.shadowBlur=10; ctx.fillStyle='#f84';
    ctx.beginPath(); ctx.arc(m.x+m.w/2,m.y+m.h/2,m.w/2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle='#fa2'; ctx.beginPath(); ctx.arc(m.x+m.w/2-3,m.y+m.h/2-3,m.w/4,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
  }
}

function drawBoss(){
  const b=boss;
  // シールド
  if(b.shielded){
    const pulse=0.5+Math.sin(frameCount*0.1)*0.5;
    ctx.globalAlpha=pulse*0.7;
    ctx.strokeStyle='#4af'; ctx.lineWidth=5;
    ctx.shadowColor='#4af'; ctx.shadowBlur=20;
    ctx.beginPath(); ctx.ellipse(b.x+b.w/2,b.y+b.h/2,b.w/2+18,b.h/2+18,0,0,Math.PI*2); ctx.stroke();
    ctx.shadowBlur=0; ctx.lineWidth=1; ctx.globalAlpha=1;
    // シールドHPバー
    ctx.fillStyle='#111'; ctx.fillRect(b.x,b.y-32,b.w,6);
    ctx.fillStyle='#4af'; ctx.fillRect(b.x,b.y-32,b.w*(b.shieldHp/b.shieldMax),6);
    ctx.fillStyle='#aaa'; ctx.font='9px Courier New'; ctx.textAlign='center';
    ctx.fillText('SHIELD',b.x+b.w/2,b.y-34); ctx.textAlign='left';
  }
  const col=b.phase>=2?'#ff0':b.phase===1?'#f44':'#f80';
  const glow=b.phase>=2?40:b.phase===1?30:24;
  ctx.shadowColor=col; ctx.shadowBlur=glow; ctx.fillStyle=col;
  ctx.fillRect(b.x+10,b.y+10,b.w-20,b.h-10);
  ctx.fillRect(b.x+20,b.y,b.w-40,14);
  ctx.fillRect(b.x,b.y+20,20,20); ctx.fillRect(b.x+b.w-20,b.y+20,20,20);
  ctx.fillRect(b.x+10,b.y+b.h-10,12,14); ctx.fillRect(b.x+b.w-22,b.y+b.h-10,12,14);
  ctx.fillRect(b.x+b.w/2-6,b.y+b.h-14,12,18);
  ctx.fillStyle=b.frame===0?'#ff0':'#f00';
  ctx.fillRect(b.x+28,b.y+20,10,8); ctx.fillRect(b.x+b.w-38,b.y+20,10,8);
  ctx.shadowBlur=0;

  // フェーズ1: ダメージクラック + 怒りオーラ
  if(b.phase>=1){
    const crackA=0.55+Math.sin(frameCount*0.15)*0.2;
    ctx.globalAlpha=crackA; ctx.strokeStyle='#ff2200'; ctx.lineWidth=1.5;
    ctx.shadowColor='#ff2200'; ctx.shadowBlur=8;
    // 亀裂ライン
    [[b.x+25,b.y+15,b.x+35,b.y+35],[b.x+b.w-35,b.y+12,b.x+b.w-22,b.y+40],
     [b.x+b.w/2-8,b.y+20,b.x+b.w/2+5,b.y+45]].forEach(([x1,y1,x2,y2])=>{
      ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke();
    });
    // 怒りオーラ輪郭
    ctx.strokeStyle='rgba(255,60,0,0.35)'; ctx.lineWidth=6;
    ctx.beginPath(); ctx.roundRect(b.x-4,b.y-4,b.w+8,b.h+8,4); ctx.stroke();
    ctx.shadowBlur=0; ctx.globalAlpha=1;
    // 追加サイドキャノン
    ctx.fillStyle='#cc2200';
    ctx.fillRect(b.x-8,b.y+18,10,8); ctx.fillRect(b.x+b.w-2,b.y+18,10,8);
  }

  // フェーズ2: エネルギーリング + 激しい点滅 + 大型エンジン
  if(b.phase>=2){
    const pulse=0.7+Math.sin(frameCount*0.22)*0.3;
    // 回転エネルギーリング
    ctx.save();
    ctx.translate(b.x+b.w/2,b.y+b.h/2);
    for(let ring=0;ring<2;ring++){
      const angle=frameCount*(ring===0?0.04:-0.03)+ring*Math.PI;
      const rr=(b.w/2+20)+ring*14;
      ctx.rotate(angle); ctx.globalAlpha=pulse*0.8;
      ctx.strokeStyle='#ffdd00'; ctx.lineWidth=2.5;
      ctx.shadowColor='#ffdd00'; ctx.shadowBlur=14;
      ctx.setLineDash([12,8]);
      ctx.beginPath(); ctx.arc(0,0,rr,0,Math.PI*2); ctx.stroke();
      ctx.setLineDash([]); ctx.rotate(-angle);
    }
    ctx.restore();
    ctx.shadowBlur=0; ctx.globalAlpha=1;
    // 激しく点滅するクラック
    if(frameCount%4<2){
      ctx.fillStyle='rgba(255,255,0,0.22)'; ctx.fillRect(b.x,b.y,b.w,b.h);
    }
    // ラベル「PHASE 2」
    ctx.fillStyle='#ff0'; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.shadowColor='#ff0'; ctx.shadowBlur=10;
    ctx.fillText('PHASE 2',b.x+b.w/2,b.y-30);
    ctx.shadowBlur=0; ctx.textAlign='left';
  }
  const ratio=b.hp/b.maxHp;
  ctx.fillStyle='#222'; ctx.fillRect(b.x,b.y-18,b.w,9);
  const barcol=ratio>0.5?'#0f0':ratio>0.25?'#ff0':'#f00';
  ctx.shadowColor=barcol; ctx.shadowBlur=8; ctx.fillStyle=barcol;
  ctx.fillRect(b.x,b.y-18,b.w*ratio,9); ctx.shadowBlur=0;
  ctx.strokeStyle='#888'; ctx.lineWidth=1; ctx.strokeRect(b.x,b.y-18,b.w,9);
  ctx.fillStyle='#fff'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`BOSS  ${b.hp}/${b.maxHp}  [${b.ability.toUpperCase()}]`,b.x+b.w/2,b.y-22); ctx.textAlign='left';

  // テレグラフ演出
  if(b.attackCharge>0){
    const ratio=b.attackCharge/28;
    // チャージグロー（残り時間が少ないほど強く光る）
    ctx.globalAlpha=(1-ratio)*0.8;
    ctx.strokeStyle='#ff3300'; ctx.lineWidth=5;
    ctx.shadowColor='#ff3300'; ctx.shadowBlur=28;
    ctx.beginPath(); ctx.ellipse(b.x+b.w/2,b.y+b.h/2,b.w/2+12,b.h/2+12,0,0,Math.PI*2); ctx.stroke();
    ctx.shadowBlur=0; ctx.lineWidth=1; ctx.globalAlpha=1;
    // エイム攻撃：狙い線
    if(b.nextPattern==='aimed'&&b.aimTarget){
      ctx.globalAlpha=Math.min(0.55,(1-ratio)*0.7);
      ctx.strokeStyle='#f44'; ctx.lineWidth=1.5;
      ctx.setLineDash([8,5]);
      ctx.beginPath();
      ctx.moveTo(b.x+b.w/2, b.y+b.h);
      ctx.lineTo(b.aimTarget.x, b.aimTarget.y);
      ctx.stroke();
      ctx.setLineDash([]); ctx.lineWidth=1; ctx.globalAlpha=1;
      // 照準点
      ctx.globalAlpha=0.7;
      ctx.strokeStyle='#f44'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.arc(b.aimTarget.x,b.aimTarget.y,10,0,Math.PI*2); ctx.stroke();
      ctx.globalAlpha=1; ctx.lineWidth=1;
    }
    // wall攻撃：横線ヒント
    if(b.nextPattern==='wall'){
      ctx.globalAlpha=(1-ratio)*0.35;
      ctx.fillStyle='#f80';
      ctx.fillRect(0,b.y+b.h+8,W,16);
      ctx.globalAlpha=1;
    }
  }
}

function drawMiniBosses(){
  for(const mb of miniBosses){
    if(!mb.alive) continue;
    ctx.shadowColor='#f80'; ctx.shadowBlur=16; ctx.fillStyle='#f80';
    ctx.fillRect(mb.x+6,mb.y+6,mb.w-12,mb.h-6);
    ctx.fillRect(mb.x+12,mb.y,mb.w-24,10);
    ctx.fillRect(mb.x,mb.y+12,12,12); ctx.fillRect(mb.x+mb.w-12,mb.y+12,12,12);
    ctx.fillStyle=mb.frame===0?'#ff0':'#f00';
    ctx.fillRect(mb.x+16,mb.y+12,8,6); ctx.fillRect(mb.x+mb.w-24,mb.y+12,8,6);
    ctx.shadowBlur=0;
    const ratio=mb.hp/mb.maxHp;
    ctx.fillStyle='#222'; ctx.fillRect(mb.x,mb.y-12,mb.w,6);
    ctx.fillStyle=ratio>0.5?'#0f0':ratio>0.25?'#ff0':'#f00';
    ctx.fillRect(mb.x,mb.y-12,mb.w*ratio,6);
  }
}

function drawUFO(){
  ctx.shadowColor='#f0f'; ctx.shadowBlur=16; ctx.fillStyle='#f0f';
  ctx.beginPath(); ctx.ellipse(ufo.x+ufo.w/2,ufo.y+10,16,10,0,Math.PI,0); ctx.fill();
  ctx.beginPath(); ctx.ellipse(ufo.x+ufo.w/2,ufo.y+16,ufo.w/2,10,0,0,Math.PI*2); ctx.fill();
  ctx.shadowBlur=0;
  ctx.fillStyle='#ff0'; ctx.font='11px Courier New'; ctx.textAlign='center';
  ctx.fillText(ufo.points,ufo.x+ufo.w/2,ufo.y+14); ctx.textAlign='left';
}

function drawPowerups(){
  const colors={double:'#ff0',invincible:'#0ff',wide:'#f0f',heal:'#f44',shield:'#4af'};
  const labels={double:'2X',invincible:'★',wide:'W',heal:'♥',shield:'▣'};
  powerups.forEach(p=>{
    ctx.shadowColor=colors[p.type]; ctx.shadowBlur=10;
    ctx.fillStyle=colors[p.type]; ctx.fillRect(p.x,p.y,p.w,p.h); ctx.shadowBlur=0;
    ctx.fillStyle='#000'; ctx.font='bold 10px Courier New'; ctx.textAlign='center';
    ctx.fillText(labels[p.type],p.x+p.w/2,p.y+11); ctx.textAlign='left';
  });
}

function drawBullets(){
  bullets.forEach(b=>{
    if(b.charged){
      const pulse=0.7+Math.sin(frameCount*0.3)*0.3;
      ctx.shadowColor='#ff0'; ctx.shadowBlur=20*pulse;
      ctx.fillStyle='#ff0';
      ctx.beginPath(); ctx.arc(b.x+b.w/2,b.y+b.h/2,b.w/2+4*pulse,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(b.x+b.w/2,b.y+b.h/2,b.w/4,0,Math.PI*2); ctx.fill();
    } else if(b.laser){
      ctx.shadowColor='#0ff'; ctx.shadowBlur=12; ctx.fillStyle='#0ff'; ctx.fillRect(b.x,0,b.w,b.y);
    } else if(b.homing){
      ctx.shadowColor='#f80'; ctx.shadowBlur=10; ctx.fillStyle='#f80'; ctx.fillRect(b.x,b.y,b.w,b.h);
    } else if(b.explosive){
      ctx.shadowColor='#f0f'; ctx.shadowBlur=12; ctx.fillStyle='#f0f';
      ctx.beginPath(); ctx.arc(b.x+b.w/2,b.y+b.h/2,b.w/2+2,0,Math.PI*2); ctx.fill();
    } else {
      ctx.shadowColor='#fff'; ctx.shadowBlur=8; ctx.fillStyle='#fff'; ctx.fillRect(b.x,b.y,b.w,b.h);
    }
    ctx.shadowBlur=0;
  });
  invaderBullets.forEach(b=>{
    const col=b.aimed?'#f44':b.bomb?'#f0f':b.zigzag?'#0cf':'#f80';
    ctx.shadowColor=col; ctx.shadowBlur=b.aimed?12:b.bomb?14:6; ctx.fillStyle=col;
    if(b.aimed||b.bomb){
      ctx.beginPath(); ctx.arc(b.x+b.w/2,b.y+b.h/2,b.w/2,0,Math.PI*2); ctx.fill();
    } else {
      ctx.fillRect(b.x,b.y,b.w,6); ctx.fillRect(b.x+1,b.y+6,b.w-2,b.h-6);
    }
    ctx.shadowBlur=0;
  });
}

function updateDamageNumbers(){
  for(let i=damageNumbers.length-1;i>=0;i--){
    const d=damageNumbers[i];
    d.y+=d.vy; d.vy*=0.94; d.timer--;
    if(d.timer<=0) damageNumbers.splice(i,1);
  }
}
function drawDamageNumbers(){
  ctx.textAlign='center';
  for(const d of damageNumbers){
    const a=Math.min(1,d.timer/20);
    const scale=d.isCrit?(d.timer>45?1+(55-d.timer)*0.08:1):1;
    ctx.save();
    ctx.globalAlpha=a;
    ctx.translate(d.x,d.y);
    if(scale!==1) ctx.scale(scale,scale);
    const col=d.isHeal?'#00ff88':d.isCrit?'#ff4444':'#ffffff';
    ctx.shadowColor=col; ctx.shadowBlur=d.isCrit?12:6;
    ctx.fillStyle=col;
    ctx.font=`bold ${d.isCrit?18:13}px Orbitron,Courier New`;
    ctx.fillText(d.isCrit?`${d.val}!!`:String(d.val),0,0);
    ctx.shadowBlur=0; ctx.restore();
  }
  ctx.textAlign='left';
}
function drawParticles(){
  particles.forEach(p=>{
    ctx.globalAlpha=p.life; ctx.shadowColor=p.color; ctx.shadowBlur=6; ctx.fillStyle=p.color;
    ctx.fillRect(p.x-p.size/2,p.y-p.size/2,p.size,p.size);
  });
  ctx.globalAlpha=1; ctx.shadowBlur=0;
}

function drawGroundLine(color){
  const glow=4+Math.sin(groundPulse)*2;
  ctx.shadowColor=color; ctx.shadowBlur=glow*3; ctx.strokeStyle=color; ctx.lineWidth=1.5;
  ctx.beginPath(); ctx.moveTo(0,H-30); ctx.lineTo(W,H-30); ctx.stroke();
  ctx.shadowBlur=0;
}

function drawHUD(accent){
  // ── ボトムバー背景 (y = H-52 to H-4) ──
  const BAR_Y=H-52, BAR_H=48;
  ctx.fillStyle='rgba(0,0,0,0.7)';
  ctx.fillRect(0,BAR_Y,W,BAR_H);
  ctx.strokeStyle='rgba(255,255,255,0.06)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(0,BAR_Y); ctx.lineTo(W,BAR_Y); ctx.stroke();

  // ── 左: HPバー ──
  const hpRatio=playerStats.maxHp>0?playerStats.hp/playerStats.maxHp:0;
  const hpCol=hpRatio>0.5?'#00ff88':hpRatio>0.25?'#ffaa00':'#ff3344';
  ctx.fillStyle='rgba(255,255,255,0.08)'; ctx.beginPath(); ctx.roundRect(8,BAR_Y+8,180,10,3); ctx.fill();
  ctx.shadowColor=hpCol; ctx.shadowBlur=6;
  ctx.fillStyle=hpCol; ctx.beginPath(); ctx.roundRect(8,BAR_Y+8,Math.max(0,180*hpRatio),10,3); ctx.fill();
  ctx.shadowBlur=0;
  ctx.fillStyle='#aaa'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='left';
  ctx.fillText(`HP  ${playerStats.hp} / ${playerStats.maxHp}`,8,BAR_Y+32);

  // ── 中央: ULTゲージ ──
  const uRatio=ultimateGauge/ULTIMATE_MAX;
  const uReady=ultimateGauge>=ULTIMATE_MAX;
  const uCol=uReady?'#ffdd00':'#ff8833';
  const UX=W/2-90, UW=180;
  ctx.fillStyle='rgba(255,120,0,0.1)'; ctx.beginPath(); ctx.roundRect(UX,BAR_Y+8,UW,10,3); ctx.fill();
  ctx.shadowColor=uCol; ctx.shadowBlur=uReady?14:3;
  ctx.fillStyle=uCol; ctx.beginPath(); ctx.roundRect(UX,BAR_Y+8,UW*uRatio,10,3); ctx.fill();
  ctx.shadowBlur=0;
  ctx.fillStyle=uCol; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  if(uReady){
    ctx.globalAlpha=0.6+Math.sin(frameCount*0.25)*0.4;
    ctx.shadowColor=uCol; ctx.shadowBlur=10;
    ctx.fillText('★ E : ULTIMATE READY ★',W/2,BAR_Y+32);
    ctx.shadowBlur=0; ctx.globalAlpha=1;
  } else {
    ctx.fillStyle='#666';
    ctx.fillText(`ULT  ${Math.floor(uRatio*100)}%`,W/2,BAR_Y+32);
  }

  // ── 右: 武器 + ダッシュ ──
  const w=currentWeapon(), wcol=WEAPON_COLOR[w];
  const ammo=w==='normal'?'∞':weaponAmmo[w];
  ctx.shadowColor=wcol; ctx.shadowBlur=6; ctx.fillStyle=wcol;
  ctx.font='bold 12px Orbitron,Courier New'; ctx.textAlign='right';
  ctx.fillText(`[${WEAPON_LABEL[w]}]  ${ammo}`,W-8,BAR_Y+18);
  ctx.shadowBlur=0;
  // ダッシュ
  if(dashCooldown>0){
    ctx.fillStyle='rgba(100,180,255,0.25)'; ctx.beginPath(); ctx.roundRect(W-104,BAR_Y+24,96,7,2); ctx.fill();
    ctx.fillStyle='#4af'; ctx.shadowColor='#4af'; ctx.shadowBlur=4;
    ctx.beginPath(); ctx.roundRect(W-104,BAR_Y+24,96*(1-dashCooldown/DASH_COOLDOWN),7,2); ctx.fill();
    ctx.shadowBlur=0;
    ctx.fillStyle='#4af'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText('DASH',W-8,BAR_Y+40);
  } else {
    ctx.fillStyle='#4af'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.shadowColor='#4af'; ctx.shadowBlur=4;
    ctx.fillText('DASH  READY',W-8,BAR_Y+40);
    ctx.shadowBlur=0;
  }

  // ── 最下部: EXPストリップ (4px) ──
  const expRatio=playerLevel>=10?1:(exp/(EXP_TABLE[Math.min(playerLevel,EXP_TABLE.length-1)]||1));
  ctx.fillStyle='rgba(255,220,0,0.15)'; ctx.fillRect(0,H-4,W,4);
  ctx.shadowColor='#ff0'; ctx.shadowBlur=4;
  ctx.fillStyle='#dd0'; ctx.fillRect(0,H-4,W*expRatio,4);
  ctx.shadowBlur=0;
  ctx.fillStyle='#886'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`LV.${playerLevel}`,W/2,H-14);

  // パワーアップ (バーの上)
  if(powerupActive){
    const pcol={double:'#ff0',invincible:'#0ff',wide:'#f0f'}[powerupActive];
    const plabel={double:'2x SHOT',invincible:'SHIELD',wide:'WIDE'}[powerupActive];
    ctx.shadowColor=pcol; ctx.shadowBlur=8; ctx.fillStyle=pcol;
    ctx.font='11px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(`[${plabel}]`,W-8,BAR_Y-22);
    ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.beginPath(); ctx.roundRect(W-104,BAR_Y-14,96,6,2); ctx.fill();
    ctx.fillStyle=pcol; ctx.beginPath(); ctx.roundRect(W-104,BAR_Y-14,96*(powerupTimer/POWERUP_DURATION),6,2); ctx.fill();
    ctx.shadowBlur=0; ctx.textAlign='left';
  }

  // コンボ
  if(comboDisplay){
    ctx.globalAlpha=Math.min(1,comboDisplay.timer/20);
    ctx.shadowColor='#ff0'; ctx.shadowBlur=10;
    ctx.fillStyle='#ff0'; ctx.font='bold 16px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(comboDisplay.text,comboDisplay.x,comboDisplay.y);
    ctx.textAlign='left'; ctx.shadowBlur=0; ctx.globalAlpha=1;
  }

  // ボスまでカウンター
  if(bossPhase){
    const pulse=Math.sin(frameCount*0.1)*0.3+0.7;
    ctx.globalAlpha=pulse; ctx.shadowColor='#f44'; ctx.shadowBlur=15;
    ctx.fillStyle='#f44'; ctx.font='bold 14px Orbitron,Courier New'; ctx.textAlign='center';
    const bossLabel=stageType==='boss_rush'?`!! BOSS  ${bossRushCount+1}/${bossRushMax} !!`:'!! BOSS !!';
    ctx.fillText(bossLabel,W/2,22); ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
    if(healers.filter(h=>h.alive).length>0){
      ctx.fillStyle='#0f0'; ctx.font='12px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText('▲ HEALERS INCOMING ▲',W/2,40); ctx.textAlign='left';
    }
  } else {
    ctx.textAlign='right';
    if(stageType==='normal'||stageType==='escort'){
      const maxWave=getWaveCount();
      const alive=invaders.filter(i=>i.alive).length;
      ctx.fillStyle=accent; ctx.font='12px Orbitron,Courier New';
      ctx.fillText(`WAVE ${waveNum}/${maxWave}  ×${alive}`,W-8,22);
    } else if(stageType==='survival'){
      const sec=Math.ceil(survivalTimer/60);
      ctx.fillStyle='#0ff'; ctx.font='12px Orbitron,Courier New';
      ctx.fillText(`SURVIVE: ${sec}s`,W-8,22);
    }
    ctx.textAlign='left';
    if(isAsteroidStage){
      ctx.fillStyle='#888'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='right';
      ctx.fillText('☄ ASTEROID STAGE',W-8,38); ctx.textAlign='left';
    }
  }
  ctx.textAlign='left';
}

function drawLifeGainDisplay(){
  if(!lifeGainDisplay) return;
  const a=Math.min(1,lifeGainDisplay.timer/20);
  ctx.globalAlpha=a; ctx.shadowColor=lifeGainDisplay.color; ctx.shadowBlur=20;
  ctx.fillStyle=lifeGainDisplay.color; ctx.font='bold 22px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(lifeGainDisplay.text,W/2,H/2-20);
  ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
}

function drawLevelUpDisplay(){
  if(!levelUpDisplay) return;
  const a=Math.min(1,levelUpDisplay.timer/20);
  ctx.globalAlpha=a; ctx.shadowColor='#ff0'; ctx.shadowBlur=25;
  ctx.fillStyle='#ff0'; ctx.font='bold 26px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(levelUpDisplay.text,W/2,H/2-50);
  ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
}

function drawEventBanner(){
  if(!currentEvent||eventTimer<=0) return;
  const pulse=Math.sin(frameCount*0.15)*0.3+0.7;
  ctx.globalAlpha=pulse*0.9; ctx.fillStyle=currentEvent.color;
  ctx.font='bold 18px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor=currentEvent.color; ctx.shadowBlur=15;
  ctx.fillText(currentEvent.label,W/2,H-100);
  ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
}

function drawMatPopups(){
  if(!matPopups.length) return;
  ctx.textAlign='center';
  for(const p of matPopups){
    const a=p.timer/55;
    ctx.globalAlpha=Math.min(1,a*2);
    ctx.font='bold 14px Orbitron,Courier New';
    ctx.shadowColor='#fff'; ctx.shadowBlur=8;
    ctx.fillStyle='#fff';
    ctx.fillText(p.text,p.x,p.y);
    ctx.shadowBlur=0;
  }
  ctx.globalAlpha=1; ctx.textAlign='left';
}

function drawStageClearAnim(){
  const t=stageClearAnimTimer;
  const prog=1-(t/80);
  const flashAlpha=t>60?(t-60)/20*0.8:t<15?t/15*0.5:0.5;
  ctx.fillStyle=`rgba(0,255,120,${flashAlpha*0.18})`; ctx.fillRect(0,0,W,H);
  const textAlpha=t>60?0:(t<50&&t>10)?(50-t)/40:0;
  if(textAlpha>0){
    ctx.save();
    ctx.globalAlpha=textAlpha;
    ctx.fillStyle='rgba(0,0,0,0.55)'; ctx.fillRect(0,H/2-60,W,120);
    ctx.shadowColor='#00ff88'; ctx.shadowBlur=40;
    ctx.fillStyle='#fff'; ctx.font='bold 52px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('STAGE  CLEAR!',W/2,H/2+18);
    ctx.shadowBlur=0;
    ctx.restore();
  }
  // border flash
  if(t>55){
    ctx.strokeStyle=`rgba(0,255,120,${(t-55)/25})`; ctx.lineWidth=6;
    ctx.strokeRect(3,3,W-6,H-6); ctx.lineWidth=1;
  }
  ctx.textAlign='left';
}

function drawBossWarning(theme){
  if(bossWarningTimer<=0) return;
  const t=bossWarningTimer,pulse=Math.sin(t*0.25)*0.5+0.5;
  ctx.strokeStyle=`rgba(255,30,30,${pulse*0.9})`; ctx.lineWidth=8;
  ctx.strokeRect(4,4,W-8,H-8); ctx.lineWidth=1;
  if(t>40){
    ctx.globalAlpha=pulse*0.9;
    ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.fillRect(0,H/2-70,W,140);
    ctx.shadowColor='#ff0000'; ctx.shadowBlur=30;
    ctx.fillStyle='#ff2222'; ctx.font='bold 56px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('!! WARNING !!',W/2,H/2-5);
    ctx.shadowBlur=10; ctx.fillStyle='#ffaa00'; ctx.font='bold 20px Orbitron,Courier New';
    ctx.fillText('BOSS  APPROACHING',W/2,H/2+36);
    ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
  }
}

function drawStageBanner(accent){
  if(stageBannerTimer<=0) return;
  const progress=stageBannerTimer/120;
  const alpha=progress<0.2?progress/0.2:progress>0.7?(progress-0.7)/0.3:1;
  ctx.globalAlpha=alpha*0.95;
  ctx.fillStyle='rgba(0,0,0,0.7)'; ctx.fillRect(0,H/2-44,W,88);
  ctx.shadowColor=accent; ctx.shadowBlur=20; ctx.fillStyle=accent;
  ctx.font='bold 42px Orbitron,Courier New'; ctx.textAlign='center';
  const stageLabel=stageType==='normal'?(isAsteroidStage?' ☄':''):` [${STAGE_TYPE_LABELS[stageType]}]`;
  ctx.fillText(`STAGE  ${stage}${stageLabel}`,W/2,H/2+15);
  ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
}

function drawHitFlash(){
  if(hitFlashTimer<=0) return;
  const alpha=(hitFlashTimer/40)*0.55;
  const grad=ctx.createRadialGradient(W/2,H/2,H*0.25,W/2,H/2,H*0.85);
  grad.addColorStop(0,'rgba(255,0,0,0)');
  grad.addColorStop(1,`rgba(255,0,0,${alpha})`);
  ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
}
function drawScreenFlash(){
  if(!screenFlash) return;
  ctx.fillStyle=`rgba(${screenFlash.r},${screenFlash.g},${screenFlash.b},${screenFlash.alpha})`;
  ctx.fillRect(0,0,W,H);
  screenFlash.alpha-=screenFlash.decay;
  if(screenFlash.alpha<=0) screenFlash=null;
}
function drawVignette(){
  const grad=ctx.createRadialGradient(W/2,H/2,H*0.35,W/2,H/2,H*0.82);
  grad.addColorStop(0,'rgba(0,0,0,0)'); grad.addColorStop(1,'rgba(0,0,0,0.55)');
  ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
}
function drawScanlines(){
  ctx.fillStyle='rgba(0,0,0,0.12)';
  for(let y=0;y<H;y+=4) ctx.fillRect(0,y,W,2);
}

// ===== 環境ギミック =====
function initEnvGimmicks(){
  gravityZones=[]; emFields=[]; blackHoles=[];
  meteorRainTimer=0; meteorRainWarning=0;
  if(stage<3) return;
  const gCount=stage>=6?2:1;
  for(let i=0;i<gCount;i++){
    gravityZones.push({x:120+Math.random()*(W-240),y:50+Math.random()*(H*0.42),
      r:72,strength:0.32,angle:0,timer:900,alive:true});
  }
  if(stage>=5){
    emFields.push({x:120+Math.random()*(W-240),y:70+Math.random()*(H*0.38),
      r:58,vx:(Math.random()-0.5)*0.6,vy:(Math.random()-0.5)*0.4,timer:700,alive:true});
  }
  if(stage>=8){
    blackHoles.push({x:160+Math.random()*(W-320),y:60+Math.random()*(H*0.38),
      r:52,strength:1.6,angle:0,timer:600,alive:true});
  }
}
function updateEnvGimmicks(){
  if(bossPhase){gravityZones=[];emFields=[];blackHoles=[];meteorRainTimer=0;meteorRainWarning=0;return;}

  // 隕石雨フェーズ (stage5+, 1800fに1回)
  if(stage>=5&&!bossPhase){
    if(meteorRainWarning>0){
      meteorRainWarning--;
      if(meteorRainWarning===0) meteorRainTimer=360;
    } else if(meteorRainTimer>0){
      meteorRainTimer--;
      if(Math.random()<0.18) meteors.push({x:Math.random()*W,y:-20,w:14,h:14,vy:4+Math.random()*4,alive:true});
    } else if(Math.random()<0.00055){
      meteorRainWarning=120;
    }
  }
  for(let i=gravityZones.length-1;i>=0;i--){
    const gz=gravityZones[i];
    gz.angle+=0.018; gz.timer--;
    if(gz.timer<=0){gravityZones.splice(i,1);continue;}
    // 敵弾を引き寄せる
    for(const b of invaderBullets){
      const dx=gz.x-(b.x+2.5),dy=gz.y-(b.y+7),dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<gz.r*1.6&&dist>6){b.vx=(b.vx||0)+(dx/dist)*gz.strength;b.vy=(b.vy||INVADER_BULLET_SPEED)+(dy/dist)*gz.strength*0.5;}
    }
    // 自弾にも弱く影響
    for(const b of bullets){
      if(b.laser||b.charged) continue;
      const dx=gz.x-(b.x+3),dy=gz.y-(b.y+7),dist=Math.sqrt(dx*dx+dy*dy);
      if(dist<gz.r&&dist>6){b.vx=(b.vx||0)+(dx/dist)*gz.strength*0.35;b.vy=(b.vy||-BULLET_SPEED)+(dy/dist)*gz.strength*0.25;}
    }
  }
  for(let i=emFields.length-1;i>=0;i--){
    const ef=emFields[i];
    ef.x+=ef.vx; ef.y+=ef.vy; ef.timer--;
    if(ef.x<ef.r||ef.x>W-ef.r) ef.vx*=-1;
    if(ef.y<ef.r||ef.y>H*0.72) ef.vy*=-1;
    if(ef.timer<=0){emFields.splice(i,1);continue;}
    for(let j=invaderBullets.length-1;j>=0;j--){
      const b=invaderBullets[j];
      if(Math.hypot(ef.x-(b.x+2.5),ef.y-(b.y+7))<ef.r){
        spawnExplosion(b.x,b.y,'#0cf',3); invaderBullets.splice(j,1);
      }
    }
  }
  for(let i=blackHoles.length-1;i>=0;i--){
    const bh=blackHoles[i];
    bh.angle-=0.05; bh.timer--;
    if(bh.timer<=0){blackHoles.splice(i,1);continue;}
    // 敵弾を強く吸引→中心到達で消滅
    for(let j=invaderBullets.length-1;j>=0;j--){
      const b=invaderBullets[j];
      const dx=bh.x-(b.x+2.5),dy=bh.y-(b.y+7),dist=Math.sqrt(dx*dx+dy*dy)||1;
      if(dist<bh.r*2){
        b.vx=(b.vx||0)+(dx/dist)*bh.strength;
        b.vy=(b.vy||INVADER_BULLET_SPEED)+(dy/dist)*bh.strength;
        if(dist<12){invaderBullets.splice(j,1);}
      }
    }
    // 自弾も強く引っ張る
    for(const b of bullets){
      if(b.laser||b.charged) continue;
      const dx=bh.x-(b.x+3),dy=bh.y-(b.y+7),dist=Math.sqrt(dx*dx+dy*dy)||1;
      if(dist<bh.r*1.5){
        b.vx=(b.vx||0)+(dx/dist)*bh.strength*0.9;
        b.vy=(b.vy||-BULLET_SPEED)+(dy/dist)*bh.strength*0.6;
      }
    }
    // プレイヤーにも微弱な引力
    if(player){
      const dx=bh.x-(player.x+player.w/2),dy=bh.y-(player.y+player.h/2),dist=Math.sqrt(dx*dx+dy*dy)||1;
      if(dist<bh.r*2.2){
        player.x+=dx/dist*0.35; player.y+=dy/dist*0.22;
        player.x=Math.max(0,Math.min(W-player.w,player.x));
        player.y=Math.max(0,Math.min(H-player.h-10,player.y));
      }
    }
  }
}
function drawEnvGimmicks(){
  // 隕石雨警告
  if(meteorRainWarning>0){
    const blink=Math.floor(meteorRainWarning/8)%2===0;
    if(blink){
      ctx.fillStyle='rgba(255,80,0,0.18)'; ctx.fillRect(0,0,W,H);
      ctx.fillStyle='#ff5500'; ctx.font='bold 18px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.shadowColor='#ff5500'; ctx.shadowBlur=20;
      ctx.fillText('⚠ METEOR RAIN INCOMING ⚠',W/2,H/2-10);
      ctx.shadowBlur=0; ctx.textAlign='left';
    }
  }
  for(const gz of gravityZones){
    const a=Math.min(1,gz.timer/80)*0.65;
    ctx.globalAlpha=a;
    ctx.strokeStyle='#f80'; ctx.lineWidth=1.5; ctx.shadowColor='#f80'; ctx.shadowBlur=10;
    ctx.beginPath(); ctx.arc(gz.x,gz.y,gz.r,0,Math.PI*2); ctx.stroke();
    ctx.strokeStyle='rgba(255,150,0,0.5)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(gz.x,gz.y,gz.r*0.55,gz.angle,gz.angle+Math.PI*1.3); ctx.stroke();
    ctx.beginPath(); ctx.arc(gz.x,gz.y,gz.r*0.28,gz.angle+Math.PI,gz.angle+Math.PI*2.3); ctx.stroke();
    ctx.fillStyle='#f80'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.shadowBlur=0; ctx.fillText('GRAVITY',gz.x,gz.y+4);
    ctx.textAlign='left'; ctx.globalAlpha=1;
  }
  for(const ef of emFields){
    const a=Math.min(1,ef.timer/80)*0.7;
    ctx.globalAlpha=a;
    const grad=ctx.createRadialGradient(ef.x,ef.y,0,ef.x,ef.y,ef.r);
    grad.addColorStop(0,'rgba(0,200,255,0.14)'); grad.addColorStop(1,'rgba(0,200,255,0)');
    ctx.fillStyle=grad; ctx.beginPath(); ctx.arc(ef.x,ef.y,ef.r,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#0cf'; ctx.lineWidth=2; ctx.shadowColor='#0cf'; ctx.shadowBlur=14;
    ctx.beginPath(); ctx.arc(ef.x,ef.y,ef.r,0,Math.PI*2); ctx.stroke(); ctx.shadowBlur=0;
    if(frameCount%5<2){
      const arc=Math.random()*Math.PI*2;
      ctx.strokeStyle='rgba(0,230,255,0.85)'; ctx.lineWidth=1.5;
      ctx.beginPath();
      ctx.moveTo(ef.x+Math.cos(arc)*ef.r*0.25,ef.y+Math.sin(arc)*ef.r*0.25);
      ctx.lineTo(ef.x+Math.cos(arc+0.6)*ef.r*0.88,ef.y+Math.sin(arc+0.6)*ef.r*0.88);
      ctx.stroke();
    }
    ctx.fillStyle='#0cf'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('EM FIELD',ef.x,ef.y+4); ctx.textAlign='left'; ctx.globalAlpha=1; ctx.lineWidth=1;
  }
  for(const bh of blackHoles){
    const fadeA=Math.min(1,bh.timer/60);
    ctx.save();
    ctx.globalAlpha=fadeA;
    // 外側の引力リング
    for(let ring=3;ring>=1;ring--){
      const rr=bh.r*(0.6+ring*0.35);
      const ga=ctx.createRadialGradient(bh.x,bh.y,0,bh.x,bh.y,rr);
      ga.addColorStop(0,'rgba(0,0,0,0)');
      ga.addColorStop(0.6,'rgba(80,0,120,0.12)');
      ga.addColorStop(1,'rgba(120,0,200,0.0)');
      ctx.fillStyle=ga; ctx.beginPath(); ctx.arc(bh.x,bh.y,rr,0,Math.PI*2); ctx.fill();
    }
    // 渦巻き腕
    ctx.shadowColor='#aa00ff'; ctx.shadowBlur=18;
    for(let arm=0;arm<3;arm++){
      const startA=bh.angle+arm*(Math.PI*2/3);
      ctx.strokeStyle=`rgba(160,0,255,0.7)`; ctx.lineWidth=2;
      ctx.beginPath();
      for(let t=0;t<60;t++){
        const a=startA+t*0.12, r2=bh.r*0.15+t*(bh.r*0.015);
        const px2=bh.x+Math.cos(a)*r2, py2=bh.y+Math.sin(a)*r2;
        t===0?ctx.moveTo(px2,py2):ctx.lineTo(px2,py2);
      }
      ctx.stroke();
    }
    // 中心暗黒核
    const gCore=ctx.createRadialGradient(bh.x,bh.y,0,bh.x,bh.y,bh.r*0.55);
    gCore.addColorStop(0,'rgba(0,0,0,1)');
    gCore.addColorStop(0.7,'rgba(40,0,80,0.9)');
    gCore.addColorStop(1,'rgba(80,0,160,0)');
    ctx.fillStyle=gCore; ctx.beginPath(); ctx.arc(bh.x,bh.y,bh.r*0.55,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
    ctx.fillStyle='#cc44ff'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('BLACK HOLE',bh.x,bh.y+4); ctx.textAlign='left';
    ctx.restore();
  }
}

// ===== ボスカットイン描画 =====
function drawBossCutin(){
  if(bossCutinTimer<=0) return;
  const elapsed=(BOSS_CUTIN_DURATION-bossCutinTimer)/BOSS_CUTIN_DURATION;
  let oa=elapsed<0.12?elapsed/0.12:elapsed>0.8?(1-elapsed)/(1-0.8):1;
  oa=Math.min(1,Math.max(0,oa));
  const theme=getTheme();
  ctx.fillStyle=`rgba(0,0,0,${oa*0.84})`; ctx.fillRect(0,0,W,H);
  if(elapsed>0.1&&elapsed<0.92){
    const ta=elapsed<0.16?(elapsed-0.1)/0.06:elapsed>0.82?(1-elapsed)/(1-0.82):1;
    // スピードライン
    ctx.globalAlpha=ta*0.38; ctx.strokeStyle=theme.accent; ctx.lineWidth=1;
    for(let i=0;i<14;i++){
      const ly=H/2-85+i*13;
      const lp=Math.min(1,(elapsed-0.1)/0.14);
      ctx.beginPath(); ctx.moveTo(W/2-lp*W*0.58,ly); ctx.lineTo(W/2+lp*W*0.58,ly); ctx.stroke();
    }
    ctx.globalAlpha=ta;
    // WARNING
    ctx.fillStyle='#f44'; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.shadowColor='#f44'; ctx.shadowBlur=8;
    ctx.fillText('!! BOSS APPROACHING !!',W/2,H/2-100); ctx.shadowBlur=0;
    // ボス名（ズームイン）
    const zp=Math.min(1,(elapsed-0.1)/0.14);
    const fs=Math.floor(88-zp*36);
    ctx.font=`bold ${fs}px Orbitron,Courier New`;
    ctx.shadowColor=theme.accent; ctx.shadowBlur=38; ctx.fillStyle='#fff';
    ctx.fillText(boss?BOSS_NAMES[boss.ability]||'UNKNOWN':' ',W/2,H/2+12);
    ctx.shadowBlur=0;
    // アビリティタグ
    if(boss){
      ctx.fillStyle=theme.accent; ctx.font='bold 16px Orbitron,Courier New';
      ctx.shadowColor=theme.accent; ctx.shadowBlur=14;
      ctx.fillText(`[ ${boss.ability.toUpperCase()} ]`,W/2,H/2+50); ctx.shadowBlur=0;
    }
    // HPバープレビュー
    if(boss&&elapsed>0.28){
      const ba=Math.min(1,(elapsed-0.28)/0.1)*ta;
      ctx.globalAlpha=ba;
      ctx.fillStyle='#333'; ctx.fillRect(W/2-150,H/2+72,300,8);
      ctx.fillStyle='#0f0'; ctx.shadowColor='#0f0'; ctx.shadowBlur=6;
      ctx.fillRect(W/2-150,H/2+72,300,8); ctx.shadowBlur=0;
      ctx.fillStyle='#aaa'; ctx.font='10px Orbitron,Courier New';
      ctx.fillText(`HP  ${boss.maxHp}`,W/2,H/2+68);
    }
    ctx.globalAlpha=1; ctx.textAlign='left';
  }
}

// ===== ステージ選択ヘルパー =====
function drawHexagon(ctx,x,y,r){
  ctx.beginPath();
  for(let i=0;i<6;i++){const a=Math.PI/180*(60*i-30);i===0?ctx.moveTo(x+r*Math.cos(a),y+r*Math.sin(a)):ctx.lineTo(x+r*Math.cos(a),y+r*Math.sin(a));}
  ctx.closePath();
}
function drawStar(ctx,x,y,pts,outerR,innerR){
  ctx.beginPath();
  for(let i=0;i<pts*2;i++){const r=i%2===0?outerR:innerR,a=Math.PI/pts*i-Math.PI/2;i===0?ctx.moveTo(x+r*Math.cos(a),y+r*Math.sin(a)):ctx.lineTo(x+r*Math.cos(a),y+r*Math.sin(a));}
  ctx.closePath();
}
function drawWorldBgObjects(worldNum){
  ctx.save(); ctx.globalAlpha=0.18;
  if(worldNum===1){
    // 火星: 赤い惑星 + クレーター
    const g=ctx.createRadialGradient(400,60,10,400,60,80);
    g.addColorStop(0,'#cc3311'); g.addColorStop(1,'#440800');
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(400,60,80,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#aa2200'; ctx.lineWidth=2;
    [[350,95,12],[420,40,8],[380,72,5],[445,80,10]].forEach(([cx,cy,r])=>{
      ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.stroke();
    });
    ctx.strokeStyle='#883300'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(25,400,35,0,Math.PI*2); ctx.stroke();
    ctx.beginPath(); ctx.arc(455,360,22,0,Math.PI*2); ctx.stroke();
  } else if(worldNum===2){
    // 金星: 黄色い厚い雲の惑星
    [{x:380,y:70,r:75,c:'#aa8800'},{x:25,y:350,r:50,c:'#887700'},{x:450,y:400,r:40,c:'#ccaa00'}].forEach(n=>{
      const g=ctx.createRadialGradient(n.x,n.y,0,n.x,n.y,n.r);
      g.addColorStop(0,n.c+'cc'); g.addColorStop(0.5,n.c+'44'); g.addColorStop(1,'transparent');
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(n.x,n.y,n.r,0,Math.PI*2); ctx.fill();
    });
  } else if(worldNum===3){
    // 木星: 縞模様の大惑星
    const jx=390,jy=65,jr=72;
    const gj=ctx.createRadialGradient(jx,jy,0,jx,jy,jr);
    gj.addColorStop(0,'#cc7733'); gj.addColorStop(1,'#442200');
    ctx.fillStyle=gj; ctx.beginPath(); ctx.arc(jx,jy,jr,0,Math.PI*2); ctx.fill();
    ctx.save(); ctx.clip();
    ctx.fillStyle='rgba(180,90,30,0.5)';
    [-20,-6,8,22].forEach(dy=>ctx.fillRect(jx-jr,jy+dy,jr*2,5));
    ctx.restore();
  } else {
    // 土星: リング惑星
    const sx=390,sy=65,sr=55;
    const gs=ctx.createRadialGradient(sx,sy,0,sx,sy,sr);
    gs.addColorStop(0,'#ccbbaa'); gs.addColorStop(1,'#443322');
    ctx.fillStyle=gs; ctx.beginPath(); ctx.arc(sx,sy,sr,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle='#ccbbaa'; ctx.lineWidth=6;
    ctx.beginPath(); ctx.ellipse(sx,sy,sr*2.2,sr*0.45,-0.2,0,Math.PI*2); ctx.stroke();
    ctx.strokeStyle='#aa9977'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.ellipse(sx,sy,sr*1.7,sr*0.35,-0.2,0,Math.PI*2); ctx.stroke();
  }
  ctx.restore();
}

// ===== ステージ選択画面 =====
function drawStageSelectScreen(){
  const selStage=stageSelectIdx+1;
  const world=getWorldInfo(selStage);
  const PANEL_X=478;

  ctx.fillStyle=world.bg; ctx.fillRect(0,0,W,H);
  drawStarfield();
  drawWorldBgObjects(world.num);

  // ===== 右側情報パネル =====
  ctx.fillStyle='rgba(0,0,0,0.78)'; ctx.strokeStyle=world.accent+'44'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(PANEL_X+2,8,316,584,8); ctx.fill(); ctx.stroke();
  ctx.strokeStyle=world.accent+'30'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(PANEL_X,0); ctx.lineTo(PANEL_X,H); ctx.stroke();

  const px=PANEL_X+158;

  // 大きなステージ番号
  ctx.shadowColor=world.accent; ctx.shadowBlur=35;
  ctx.fillStyle=world.accent; ctx.font='bold 72px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(selStage,px,108); ctx.shadowBlur=0;
  ctx.fillStyle='#555'; ctx.font='10px Orbitron,Courier New';
  ctx.fillText('— STAGE —',px,130);

  ctx.fillStyle=world.accent+'30'; ctx.fillRect(PANEL_X+12,140,304,1);

  // ワールド名
  ctx.shadowColor=world.accent; ctx.shadowBlur=10;
  ctx.fillStyle=world.accent+'dd'; ctx.font='bold 10px Orbitron,Courier New';
  ctx.fillText(world.name,px,162); ctx.shadowBlur=0;

  // ワールドバッジ
  ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.strokeStyle=world.accent; ctx.lineWidth=1.5;
  ctx.beginPath(); ctx.arc(px,205,22,0,Math.PI*2); ctx.fill(); ctx.stroke();
  ctx.fillStyle=world.accent; ctx.font='bold 18px Orbitron,Courier New';
  ctx.fillText(world.num,px,212);

  ctx.fillStyle=world.accent+'30'; ctx.fillRect(PANEL_X+12,238,304,1);

  // ボス情報
  const bossAbility=selStage<=2?'BURST':selStage<=4?'SPLIT':selStage<=6?'TELEPORT':selStage<=8?'SHIELD':selStage<=10?'DASHER':'BARRAGE';
  const bossDescs={BURST:'一斉多方向弾幕',SPLIT:'弾分裂・拡散攻撃',TELEPORT:'瞬間移動で翻弄',SHIELD:'防護シールド展開',DASHER:'高速ダッシュ攻撃',BARRAGE:'360°全方位弾幕'};
  ctx.fillStyle='#cc2222'; ctx.font='bold 9px Orbitron,Courier New';
  ctx.fillText('▶ BOSS ENCOUNTER',px,260);
  ctx.shadowColor='#ff4444'; ctx.shadowBlur=12;
  ctx.fillStyle='#ff5555'; ctx.font='bold 18px Orbitron,Courier New';
  ctx.fillText(bossAbility,px,284); ctx.shadowBlur=0;
  ctx.fillStyle='#777'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText(bossDescs[bossAbility]||'',px,304);

  ctx.fillStyle=world.accent+'30'; ctx.fillRect(PANEL_X+12,318,304,1);

  // クリア状態
  const isLocked=selStage>highestStage;
  if(isLocked){
    ctx.fillStyle='#444'; ctx.font='bold 13px Orbitron,Courier New';
    ctx.fillText('LOCKED',px,344);
    ctx.fillStyle='#333'; ctx.font='9px Orbitron,Courier New';
    ctx.fillText(`CLEAR STAGE ${selStage-1} TO UNLOCK`,px,360);
  } else if(selStage<highestStage){
    ctx.shadowColor='#ffdd00'; ctx.shadowBlur=8;
    ctx.fillStyle='#ffdd00'; ctx.font='bold 13px Orbitron,Courier New';
    ctx.fillText('✓ CLEARED',px,344); ctx.shadowBlur=0;
  } else {
    ctx.fillStyle='#00ccff'; ctx.font='bold 13px Orbitron,Courier New';
    ctx.fillText('IN PROGRESS',px,344);
  }

  // 非ステージ1から開始の注意
  if(selStage>1&&!isLocked){
    ctx.fillStyle='rgba(255,120,0,0.14)'; ctx.strokeStyle='#ff8800'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(PANEL_X+12,372,304,30,4); ctx.fill(); ctx.stroke();
    ctx.fillStyle='#ff8800'; ctx.font='bold 9px Orbitron,Courier New';
    ctx.fillText(`★ STAGE ${selStage} から開始します`,px,392);
  }

  // ===== 敵プレビュー =====
  ctx.fillStyle=world.accent+'30'; ctx.fillRect(PANEL_X+12,412,304,1);
  ctx.fillStyle='#555'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('ENEMY TYPES',px,428);
  {
    const types=getStageEnemyTypes(selStage);
    const iconSize=22, gap=32, startX=px-(types.length*gap)/2+gap/2;
    types.forEach((t,i)=>{
      const ex=startX+i*gap, ey=458;
      const tc=ENEMY_PREVIEW_COLORS[t]||'#aaa';
      ctx.save(); ctx.translate(ex,ey);
      ctx.shadowColor=tc; ctx.shadowBlur=8; ctx.fillStyle=tc;
      drawEnemyPreviewIcon(ctx,t,iconSize);
      ctx.shadowBlur=0; ctx.restore();
      ctx.fillStyle=tc+'cc'; ctx.font='7px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(ENEMY_PREVIEW_LABELS[t]||t,ex,ey+iconSize*0.9);
    });
  }
  ctx.textAlign='left';

  // 操作ヒント（パネル下部）
  ctx.fillStyle=world.accent+'30'; ctx.fillRect(PANEL_X+12,548,304,1);
  ctx.fillStyle='#555'; ctx.font='9px Orbitron,Courier New';
  ctx.fillText('← → ↑ ↓: 選択   ESC: 戻る',px,564);
  ctx.shadowColor=world.accent; ctx.shadowBlur=8;
  ctx.fillStyle=world.accent; ctx.font='bold 10px Orbitron,Courier New';
  ctx.fillText('SPACE / ENTER: ゲーム開始',px,582); ctx.shadowBlur=0;

  // ===== 左マップエリア =====
  const maxShow=Math.min(highestStage,40);
  // スクロール: 惑星グループ（10ステージ）ごとにオフセット
  const mapScrollOffset=stageMapScrollOffset;

  // マップヘッダー
  ctx.shadowColor=world.accent; ctx.shadowBlur=15;
  ctx.fillStyle=world.accent; ctx.font='bold 15px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(world.name,PANEL_X/2,26); ctx.shadowBlur=0;
  ctx.fillStyle='#333'; ctx.font='9px Orbitron,Courier New';
  ctx.fillText(`HIGHEST: STAGE ${highestStage}`,PANEL_X/2,44);

  // 惑星境界バンド (10ステージごと)
  [10,20,30].forEach(n=>{
    if(n<maxShow){
      const p1=getStageNodePos(n,mapScrollOffset), p2=getStageNodePos(n+1,mapScrollOffset);
      const my=(p1.y+p2.y)/2;
      if(my<55||my>H-10) return;
      ctx.strokeStyle='rgba(255,255,255,0.05)'; ctx.lineWidth=30;
      ctx.beginPath(); ctx.moveTo(0,my); ctx.lineTo(PANEL_X,my); ctx.stroke();
      ctx.lineWidth=1;
      const winfo=getWorldInfo(n+1);
      ctx.fillStyle=winfo.accent+'99'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='right';
      ctx.fillText(winfo.name,PANEL_X-8,my-2);
    }
  });

  // 接続パス
  for(let s=1;s<maxShow;s++){
    const p1=getStageNodePos(s,mapScrollOffset), p2=getStageNodePos(s+1,mapScrollOffset);
    if(p1.y<55&&p2.y<55) continue;
    if(p1.y>H&&p2.y>H) continue;
    const winfo=getWorldInfo(s);
    ctx.strokeStyle=winfo.pathCol; ctx.lineWidth=4;
    ctx.beginPath(); ctx.moveTo(p1.x,p1.y); ctx.lineTo(p2.x,p2.y); ctx.stroke();
  }
  ctx.lineWidth=1;

  // ノード（六角形=通常、星形=ボスステージ）
  for(let s=1;s<=maxShow;s++){
    const pos=getStageNodePos(s,mapScrollOffset);
    if(pos.y<50||pos.y>H-10) continue;
    const isSel=s===selStage;
    const winfo=getWorldInfo(s);
    const nodeLocked=s>highestStage;
    const isBoss=s%5===0;
    const r=isSel?22:16;

    ctx.shadowColor=nodeLocked?'#333':isSel?winfo.accent:'#555';
    ctx.shadowBlur=isSel?18:nodeLocked?0:6;
    ctx.fillStyle=nodeLocked?'#111':isSel?winfo.accent:'#1a1a2e';
    ctx.strokeStyle=nodeLocked?'#333':isSel?winfo.accent:winfo.accent+'66';
    ctx.lineWidth=isSel?3:1.5;

    if(isBoss) drawStar(ctx,pos.x,pos.y,5,r,r*0.42);
    else drawHexagon(ctx,pos.x,pos.y,r);
    ctx.fill(); ctx.stroke();
    ctx.shadowBlur=0;

    ctx.fillStyle=nodeLocked?'#333':isSel?'#000':winfo.accent+'cc';
    ctx.font=`bold ${isSel?13:11}px Orbitron,Courier New`; ctx.textAlign='center';
    ctx.fillText(nodeLocked?'?':s,pos.x,pos.y+5);
  }
  ctx.lineWidth=1;

  // プレイヤー機体（選択ノードの上）
  const bob=Math.sin(frameCount*0.08)*4;
  const sc=SHIP_COLORS[shipColorIdx].hex;
  const cpx=stageCharX, cpy=stageCharY-38+bob;
  ctx.save();
  ctx.translate(cpx-12,cpy-7);
  ctx.scale(0.5,0.5);
  ctx.shadowColor=sc; ctx.shadowBlur=14; ctx.fillStyle=sc;
  drawShipShape(0,0,48,28,SHIP_SHAPES[shipShapeIdx].id);
  ctx.shadowBlur=0;
  ctx.globalAlpha=0.8; ctx.fillStyle='#f60';
  const fh=4+Math.random()*6;
  ctx.fillRect(12,28,8,fh); ctx.fillStyle='#ff0'; ctx.fillRect(14,28,4,fh*0.5);
  ctx.globalAlpha=1;
  ctx.restore();

  ctx.textAlign='left';
}

// ===== カスタマイズ画面 =====
function drawCustomizeScreen(){
  ctx.fillStyle='rgba(0,0,0,0.93)'; ctx.fillRect(0,0,W,H);
  const t=Date.now()/1000;
  const pAccent=getPlanet(highestStage).accent;

  // タイトル
  ctx.shadowColor=pAccent; ctx.shadowBlur=22;
  ctx.fillStyle='#fff'; ctx.font='bold 30px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('MISSION  SELECT',W/2,52); ctx.shadowBlur=0;
  ctx.fillStyle='#557'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText('↑↓ 選択   SPACE / ENTER 決定',W/2,72);

  // 左: メニュー項目
  const menuItems=[
    {
      icon:'◈',
      label:'LOADOUT',
      sublabel:()=>{ const c=CHAR_POOL.find(x=>x.id===playerLoadout.charId)||CHAR_POOL.find(x=>x.id==='char_basic'); return c.label; },
      desc:()=>{
        const c=CHAR_POOL.find(x=>x.id===playerLoadout.charId)||CHAR_POOL.find(x=>x.id==='char_basic');
        return `HP:${c.hp}  ATK:×${c.atk.toFixed(1)}  DEF:${c.def}%  SPD:+${c.spd}`;
      },
      color:'#0cf',
      badge:null,
    },
    {
      icon:'★',
      label:'GACHA SHOP',
      sublabel:()=>{ const n=ALL_GACHA_POOL.filter(i=>gachaInventory[i.id]).length; return `${n} / ${ALL_GACHA_POOL.length}  collected`; },
      desc:()=>`● ${coins.toLocaleString()} coins  /  ✦ ${gachaStardust} dust`,
      color:'#ffdd00',
      badge:'NEW',
    },
    {
      icon:'⚙',
      label:'UPGRADE SHOP',
      sublabel:()=>{ const tot=SHOP_ITEMS.reduce((a,s)=>a+shopUpgrades[s.id],0); return `強化済み: ${tot} / ${SHOP_ITEMS.length*SHOP_MAX_LV}  Lv合計`; },
      desc:()=>`● ${coins.toLocaleString()} coins  /  🔩${materials.scrap||0} ⚡${materials.core||0} 💎${materials.crystal||0}`,
      color:'#ff8833',
      badge:null,
    },
    {
      icon:'▶',
      label:'START  GAME',
      sublabel:()=>`STAGE ${startStage}  から出撃`,
      desc:()=>highestStage>1?`最高到達: STAGE ${highestStage}`:'初回プレイ',
      color:'#00ff88',
      badge:null,
    },
    {
      icon:'!!',
      label:'BOSS  RUSH',
      sublabel:()=>'全ステージ ボス連戦モード',
      desc:()=>'ボスのみ連続登場！ 高コイン報酬',
      color:'#ff4444',
      badge:null,
    },
  ];

  const mx=60, mw=380, rowH=96, startY=86;
  const menuBgMap={'#ffdd00':'50,38,0','#00ff88':'0,50,28','#ff4444':'70,0,0','#0cf':'0,42,70','#ff8833':'50,24,0'};
  const menuStrokeMap={'#ffdd00':'120,90,0','#00ff88':'0,100,50','#ff4444':'150,0,0','#0cf':'0,80,130','#ff8833':'120,60,0'};
  menuItems.forEach((item,i)=>{
    const sy=startY+i*rowH, active=customizeCursor===i;
    const pulse=0.75+Math.sin(frameCount*0.07+i)*0.25;
    const bgRgb=menuBgMap[item.color]||'0,42,70';
    const strokeRgb=menuStrokeMap[item.color]||'0,80,130';
    // 背景
    ctx.fillStyle=active?`rgba(${bgRgb},0.95)`:'rgba(10,12,22,0.85)';
    ctx.strokeStyle=active?item.color:`rgba(${strokeRgb},${pulse*0.4})`;
    ctx.lineWidth=active?2:1.2;
    ctx.shadowColor=active?item.color:'transparent'; ctx.shadowBlur=active?20:0;
    ctx.beginPath(); ctx.roundRect(mx,sy,mw,rowH-8,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    // 左アクセントバー
    ctx.fillStyle=item.color; ctx.globalAlpha=active?0.9:0.3;
    ctx.beginPath(); ctx.roundRect(mx,sy,4,rowH-8,{upperLeft:12,lowerLeft:12,upperRight:0,lowerRight:0}); ctx.fill(); ctx.globalAlpha=1;
    // アイコン
    ctx.fillStyle=active?item.color:'#445'; ctx.font=`bold ${active?20:17}px Orbitron,Courier New`; ctx.textAlign='left';
    ctx.shadowColor=active?item.color:'transparent'; ctx.shadowBlur=active?10:0;
    ctx.fillText(item.icon||'',mx+16,sy+44); ctx.shadowBlur=0;
    // ラベル
    ctx.shadowColor=item.color; ctx.shadowBlur=active?12:0;
    ctx.fillStyle=active?item.color:'#778'; ctx.font=`bold ${active?19:16}px Orbitron,Courier New`; ctx.textAlign='left';
    ctx.fillText(item.label,mx+44,sy+34); ctx.shadowBlur=0;
    // サブラベル
    ctx.fillStyle=active?'#eee':'#556'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(item.sublabel(),mx+44,sy+56);
    // 説明
    ctx.fillStyle=active?item.color:'#445'; ctx.font='10px Orbitron,Courier New';
    ctx.fillText(item.desc(),mx+44,sy+74);
    // 右矢印
    if(active){
      ctx.fillStyle=item.color; ctx.font='bold 22px Orbitron,Courier New'; ctx.textAlign='right';
      ctx.fillText('▶',mx+mw-16,sy+50);
    }
    ctx.textAlign='left';
  });

  // ミッションパネル（右下）
  const mpx=456, mpy=450, mpw=330, mph=150;
  ctx.fillStyle='rgba(6,8,18,0.94)'; ctx.strokeStyle='#442211'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(mpx,mpy,mpw,mph,8); ctx.fill(); ctx.stroke();
  // header glow strip
  ctx.save(); ctx.globalAlpha=0.18; ctx.fillStyle='#ff8833';
  ctx.beginPath(); ctx.roundRect(mpx+1,mpy+1,mpw-2,30,{upperLeft:7,upperRight:7}); ctx.fill(); ctx.restore();
  ctx.fillStyle='#ff8833'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor='#ff8833'; ctx.shadowBlur=8;
  ctx.fillText('SESSION  MISSIONS',mpx+mpw/2,mpy+20); ctx.shadowBlur=0;
  sessionMissions.forEach((m,i)=>{
    const done=missionClaimedSet.has(i);
    const progress=m.check(sessionProgress);
    const ry=mpy+36+i*36;
    ctx.fillStyle=done?'rgba(0,40,10,0.85)':'rgba(10,10,22,0.85)';
    ctx.strokeStyle=done?'#00bb33':'#2a1800'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(mpx+8,ry,mpw-16,30,5); ctx.fill(); ctx.stroke();
    // left icon
    ctx.fillStyle=done?'#00ff66':'#ff8833'; ctx.font='13px Courier New'; ctx.textAlign='left';
    ctx.fillText(done?'✓':'○',mpx+14,ry+20);
    // label
    ctx.fillStyle=done?'#00ee55':'#ddd'; ctx.font=`${done?'bold ':''} 11px Orbitron,Courier New`; ctx.textAlign='left';
    ctx.fillText(m.label,mpx+30,ry+20);
    // reward
    ctx.fillStyle='#ffaa44'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(`+${m.reward.coins}C${m.reward.dust?` +${m.reward.dust}⊕`:''}`,mpx+mpw-10,ry+20);
  });
  ctx.textAlign='left';

  // 右パネル: ロードアウト概要 + ステータス
  const px=456, py=100, pw=330, ph=340;
  ctx.fillStyle='rgba(6,8,18,0.92)'; ctx.strokeStyle='#1a2a3a'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(px,py,pw,ph,10); ctx.fill(); ctx.stroke();

  ctx.fillStyle=pAccent; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor=pAccent; ctx.shadowBlur=8;
  ctx.fillText('CURRENT  LOADOUT',px+pw/2,py+22); ctx.shadowBlur=0;

  const char=CHAR_POOL.find(c=>c.id===playerLoadout.charId)||CHAR_POOL.find(c=>c.id==='char_basic');
  // キャラアイコン風
  const charCol=char.color||'#0cf';
  ctx.save(); ctx.translate(px+pw/2,py+68);
  ctx.shadowColor=charCol; ctx.shadowBlur=16; ctx.fillStyle=charCol;
  drawShipShape(-20,-14,40,24,'fighter');
  ctx.shadowBlur=0;
  const fl=3+Math.sin(t*8)*2;
  ctx.globalAlpha=0.7; ctx.fillStyle='#f60'; ctx.fillRect(-8,10,6,fl); ctx.fillStyle='#ff0'; ctx.fillRect(-7,10,4,fl*0.5);
  ctx.restore();
  ctx.fillStyle=charCol; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor=charCol; ctx.shadowBlur=6;
  ctx.fillText(char.label,px+pw/2,py+108); ctx.shadowBlur=0;
  ctx.fillStyle=RARITY_COLORS[char.rarity]||'#aaa'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText(`[${char.rarity}]`,px+pw/2,py+124);

  // スタットバー
  const stats=[
    {l:'HP', v:char.hp, max:150, c:'#00ff88'},
    {l:'ATK',v:Math.round((char.atk-1)*100), max:50, c:'#ff8844'},
    {l:'DEF',v:char.def, max:50, c:'#44aaff'},
    {l:'CRIT',v:char.crit, max:40, c:'#ffdd00'},
    {l:'SPD', v:char.spd, max:5, c:'#88ffcc'},
  ];
  const bx=px+14, bw=pw-28;
  stats.forEach((s,i)=>{
    const by=py+138+i*30;
    ctx.fillStyle='#111'; ctx.fillRect(bx,by,bw,8);
    const ratio=Math.min(1,s.v/s.max);
    ctx.fillStyle=s.c; ctx.shadowColor=s.c; ctx.shadowBlur=4;
    ctx.fillRect(bx,by,bw*ratio,8); ctx.shadowBlur=0;
    ctx.fillStyle='#aaa'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(s.l,bx,by-3);
    ctx.fillStyle=s.c; ctx.textAlign='right';
    ctx.fillText(s.l==='HP'?s.v:`${s.v}${s.l==='ATK'?'%':s.l==='CRIT'?'%':s.l==='DEF'?'%':''}`,bx+bw,by-3);
  });

  // 装備・武器サマリー
  const wpLbl=playerLoadout.weaponId?(WEAPON_GACHA_POOL.find(w=>w.id===playerLoadout.weaponId)?.label||'?'):'CLASSIC';
  const petCount=playerLoadout.pets.filter(p=>p&&gachaInventory[p]).length;
  ctx.fillStyle='#556'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`武器: ${wpLbl}  /  ペット: ${petCount}匹`,px+pw/2,py+ph-14);

  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== ロードアウト画面 =====
function drawPetShape(effect,color){
  const s=18;
  ctx.fillStyle=color;
  switch(effect){
    case 'dragon':
      ctx.beginPath(); ctx.moveTo(0,-s); ctx.lineTo(s*0.6,s*0.4); ctx.lineTo(0,s*0.2); ctx.lineTo(-s*0.6,s*0.4); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.6; ctx.fillStyle='#ff6600';
      ctx.beginPath(); ctx.arc(0,s*0.65,4,0,Math.PI*2); ctx.fill();
      break;
    case 'hawk':
      ctx.beginPath(); ctx.moveTo(s,0); ctx.lineTo(-s*0.5,-s*0.7); ctx.lineTo(-s*0.25,0); ctx.lineTo(-s*0.5,s*0.7); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.38; ctx.fillStyle='#99ccff';
      ctx.beginPath(); ctx.moveTo(-s*0.1,-s*0.15); ctx.lineTo(-s,-s*0.7); ctx.lineTo(-s*0.3,0); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-s*0.1,s*0.15); ctx.lineTo(-s,s*0.7); ctx.lineTo(-s*0.3,0); ctx.closePath(); ctx.fill();
      break;
    case 'heal':
      ctx.beginPath(); ctx.ellipse(0,s*0.1,s*0.75,s,0,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.45; ctx.fillStyle='#fff';
      ctx.beginPath(); ctx.ellipse(-s*0.22,-s*0.3,s*0.2,s*0.18,0,0,Math.PI*2); ctx.fill();
      break;
    case 'fairy':
      for(let p=0;p<4;p++){
        const a=p*Math.PI/2;
        ctx.fillStyle=color;
        ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(a)*s,Math.sin(a)*s); ctx.lineTo(Math.cos(a+Math.PI/4)*s*0.35,Math.sin(a+Math.PI/4)*s*0.35); ctx.closePath(); ctx.fill();
      }
      break;
    case 'phoenix':
      ctx.save(); ctx.rotate(-Math.PI/2);
      ctx.fillStyle=color;
      ctx.beginPath(); ctx.moveTo(s,0); ctx.lineTo(-s*0.5,-s*0.85); ctx.lineTo(-s*0.3,0); ctx.lineTo(-s*0.5,s*0.85); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.5; ctx.fillStyle='#ffdd00';
      ctx.beginPath(); ctx.arc(s*0.3,0,s*0.32,0,Math.PI*2); ctx.fill();
      ctx.restore();
      break;
    case 'turtle':
      ctx.beginPath(); ctx.ellipse(0,0,s*0.85,s*0.7,0,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.5; ctx.strokeStyle='#006600'; ctx.lineWidth=1.5;
      for(let h=0;h<6;h++){const a=h*Math.PI/3; ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(Math.cos(a)*s*0.75,Math.sin(a)*s*0.6); ctx.stroke();}
      ctx.lineWidth=1; ctx.globalAlpha=0.9; ctx.fillStyle='#88cc88';
      ctx.beginPath(); ctx.ellipse(-s*0.35,-s*0.5,s*0.15,s*0.25,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(s*0.35,-s*0.5,s*0.15,s*0.25,0,0,Math.PI*2); ctx.fill();
      break;
    case 'bomber':
      ctx.beginPath(); ctx.ellipse(0,0,s*0.55,s*0.4,0,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.55; ctx.fillStyle='#111';
      ctx.fillRect(-s*0.5,-s*0.15,s*0.32,s*0.3); ctx.fillRect(-s*0.08,-s*0.15,s*0.32,s*0.3);
      ctx.globalAlpha=0.85; ctx.fillStyle='rgba(255,255,80,0.9)';
      ctx.beginPath(); ctx.ellipse(0,-s*0.52,s*0.35,s*0.22,-0.15,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(0,s*0.52,s*0.35,s*0.22,0.15,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.9; ctx.fillStyle='#ff4400';
      ctx.beginPath(); ctx.arc(0,0,s*0.18,0,Math.PI*2); ctx.fill();
      break;
    case 'ghost':
      ctx.globalAlpha*=0.78;
      ctx.beginPath(); ctx.arc(0,-s*0.1,s*0.65,Math.PI,0);
      ctx.lineTo(s*0.65,s*0.55);
      ctx.quadraticCurveTo(s*0.42,s*0.3,s*0.22,s*0.55);
      ctx.quadraticCurveTo(0,s*0.3,-s*0.22,s*0.55);
      ctx.quadraticCurveTo(-s*0.42,s*0.3,-s*0.65,s*0.55);
      ctx.lineTo(-s*0.65,s*0.55); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.9; ctx.fillStyle='#111';
      ctx.beginPath(); ctx.ellipse(-s*0.22,-s*0.15,s*0.13,s*0.18,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(s*0.22,-s*0.15,s*0.13,s*0.18,0,0,Math.PI*2); ctx.fill();
      break;
    case 'exp':
      ctx.beginPath(); ctx.roundRect(-s*0.7,-s*0.7,s*1.4,s*1.4,3); ctx.fill();
      ctx.globalAlpha=0.8; ctx.fillStyle='#fff';
      ctx.beginPath(); ctx.arc(-s*0.28,-s*0.22,s*0.18,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(s*0.28,-s*0.22,s*0.18,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.9; ctx.strokeStyle=color; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(0,-s*0.7); ctx.lineTo(0,-s*1.1); ctx.stroke();
      ctx.globalAlpha=1; ctx.fillStyle=color;
      ctx.beginPath(); ctx.arc(0,-s*1.1,s*0.16,0,Math.PI*2); ctx.fill();
      break;
    default:// coin/cat
      ctx.fillStyle=color;
      ctx.beginPath(); ctx.ellipse(0,s*0.1,s*0.75,s,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-s*0.5,-s*0.6); ctx.lineTo(-s*0.8,-s*1.1); ctx.lineTo(-s*0.15,-s*0.7); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(s*0.5,-s*0.6); ctx.lineTo(s*0.8,-s*1.1); ctx.lineTo(s*0.15,-s*0.7); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.85; ctx.fillStyle='#000';
      ctx.beginPath(); ctx.ellipse(-s*0.28,-s*0.1,s*0.13,s*0.2,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(s*0.28,-s*0.1,s*0.13,s*0.2,0,0,Math.PI*2); ctx.fill();
      break;
  }
  ctx.globalAlpha=1;
}

function drawLoadoutPreview(px,py,pw,ph,item){
  const cx=px+pw/2;
  const rc=RARITY_COLORS[item.rarity]||item.color||'#aaa';

  // Top rarity strip
  ctx.save(); ctx.globalAlpha=0.18; ctx.fillStyle=rc;
  ctx.beginPath(); ctx.roundRect(px+1,py+1,pw-2,52,{upperLeft:8,upperRight:8,lowerLeft:0,lowerRight:0}); ctx.fill(); ctx.restore();
  ctx.fillStyle=rc; ctx.fillRect(px+1,py+1,pw-2,3);

  ctx.fillStyle=rc; ctx.shadowColor=rc; ctx.shadowBlur=6;
  ctx.font='bold 12px Orbitron,Courier New'; ctx.textAlign='left';
  ctx.fillText(`[${item.rarity}]`,px+12,py+26); ctx.shadowBlur=0;
  ctx.fillStyle='#445'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='right';
  ctx.fillText(item.type.toUpperCase(),px+pw-12,py+26);

  let equipped=false;
  if(loadoutTab===0) equipped=playerLoadout.charId===item.id||(item.id==='char_basic'&&!playerLoadout.charId);
  else if(loadoutTab===1) equipped=playerLoadout.equip.includes(item.id);
  else if(loadoutTab===2) equipped=playerLoadout.pets.includes(item.id);
  else equipped=playerLoadout.weaponId===item.id||(item.id===null&&!playerLoadout.weaponId);
  if(equipped){
    ctx.shadowColor='#0f0'; ctx.shadowBlur=8;
    ctx.fillStyle='#00ee44'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('◉ 装備中',cx,py+44); ctx.shadowBlur=0;
  }

  // Icon area
  const iconCY=py+130;
  ctx.save(); ctx.translate(cx,iconCY);
  ctx.shadowColor=rc; ctx.shadowBlur=22;
  if(loadoutTab===0){
    ctx.fillStyle=rc;
    drawShipShape(-28,-18,56,34,'fighter');
    const fl=4+Math.sin(frameCount*0.2)*3;
    ctx.globalAlpha=0.7; ctx.fillStyle='#f60'; ctx.fillRect(-10,16,8,fl);
    ctx.fillStyle='#ff0'; ctx.fillRect(-9,16,6,fl*0.5);
    ctx.globalAlpha=0.18+Math.sin(frameCount*0.04)*0.08;
    ctx.strokeStyle=rc; ctx.lineWidth=1; ctx.setLineDash([4,5]);
    ctx.beginPath(); ctx.ellipse(0,0,48,27,0,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
  } else if(loadoutTab===1){
    const s=28+Math.sin(frameCount*0.08)*3;
    ctx.fillStyle=rc;
    ctx.beginPath(); ctx.moveTo(0,-s); ctx.lineTo(s*0.65,0); ctx.lineTo(0,s); ctx.lineTo(-s*0.65,0); ctx.closePath(); ctx.fill();
    ctx.globalAlpha=0.28; ctx.fillStyle='#fff';
    ctx.beginPath(); ctx.moveTo(0,-s); ctx.lineTo(s*0.65,0); ctx.lineTo(0,-s*0.32); ctx.closePath(); ctx.fill();
  } else if(loadoutTab===2){
    drawPetShape(item.effect,rc);
  } else {
    ctx.fillStyle=rc;
    const wt=item.weapon||'normal';
    if(wt==='laser'){
      ctx.fillRect(-4,-28,8,38);
      ctx.globalAlpha=0.35; ctx.fillRect(-12,-22,24,5);
    } else if(wt==='homing'){
      ctx.beginPath(); ctx.moveTo(0,-28); ctx.lineTo(10,10); ctx.lineTo(0,4); ctx.lineTo(-10,10); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=0.5; ctx.fillStyle='#f80';
      ctx.beginPath(); ctx.moveTo(-12,14); ctx.lineTo(12,14); ctx.lineTo(0,30); ctx.closePath(); ctx.fill();
    } else if(wt==='explosive'){
      ctx.beginPath(); ctx.arc(0,0,20,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=0.45; ctx.strokeStyle='#f44'; ctx.lineWidth=3;
      for(let e=0;e<6;e++){
        const a=e*Math.PI/3+frameCount*0.025;
        ctx.beginPath(); ctx.moveTo(Math.cos(a)*22,Math.sin(a)*22); ctx.lineTo(Math.cos(a)*34,Math.sin(a)*34); ctx.stroke();
      }
    } else {
      for(let b=-1;b<=1;b++){
        ctx.beginPath(); ctx.roundRect(b*14-3,-20,6,28,3); ctx.fill();
      }
    }
  }
  ctx.globalAlpha=1; ctx.shadowBlur=0; ctx.restore();

  ctx.shadowColor=rc; ctx.shadowBlur=10;
  ctx.fillStyle='#fff'; ctx.font='bold 17px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(item.label,cx,py+186); ctx.shadowBlur=0;
  ctx.fillStyle='#999'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText(item.desc,cx,py+205);

  // Divider
  const divY=py+218;
  ctx.strokeStyle='#1a2040'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(px+16,divY); ctx.lineTo(px+pw-16,divY); ctx.stroke();

  // Stats
  const sY=divY+14, bx=px+14, bw=pw-28;
  if(loadoutTab===0&&item.hp){
    const stats=[
      {l:'HP',  v:item.hp,          max:150,c:'#00ff88',d:`${item.hp}`},
      {l:'ATK', v:(item.atk-1)*100, max:50, c:'#ff8844',d:`×${item.atk.toFixed(1)}`},
      {l:'DEF', v:item.def,         max:50, c:'#44aaff',d:`${item.def}%`},
      {l:'CRIT',v:item.crit,        max:40, c:'#ffdd00',d:`${item.crit}%`},
      {l:'SPD', v:item.spd,         max:5,  c:'#88ffcc',d:`+${item.spd}`},
    ];
    stats.forEach((s,i)=>{
      const by=sY+i*38;
      ctx.fillStyle='#aaa'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='left'; ctx.fillText(s.l,bx,by+12);
      ctx.fillStyle=s.c; ctx.textAlign='right'; ctx.fillText(s.d,bx+bw,by+12);
      ctx.fillStyle='#141622'; ctx.beginPath(); ctx.roundRect(bx,by+16,bw,7,3); ctx.fill();
      if(s.v>0){ ctx.fillStyle=s.c; ctx.shadowColor=s.c; ctx.shadowBlur=4; ctx.beginPath(); ctx.roundRect(bx,by+16,bw*Math.min(1,s.v/s.max),7,3); ctx.fill(); ctx.shadowBlur=0; }
    });
  } else if(loadoutTab===1){
    ctx.fillStyle='#556'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('── BONUS ──',cx,sY+6);
    const bonuses=[];
    if(item.hp>0) bonuses.push({l:'HP',v:`+${item.hp}`,c:'#00ff88'});
    if(item.atk&&item.atk>1) bonuses.push({l:'ATK',v:`×${item.atk.toFixed(1)}`,c:'#ff8844'});
    if(item.def>0) bonuses.push({l:'DEF',v:`+${item.def}%`,c:'#44aaff'});
    if(item.crit>0) bonuses.push({l:'CRIT',v:`+${item.crit}%`,c:'#ffdd00'});
    if(item.spd>0) bonuses.push({l:'SPD',v:`+${item.spd}`,c:'#88ffcc'});
    bonuses.forEach((b,i)=>{
      ctx.fillStyle=b.c; ctx.shadowColor=b.c; ctx.shadowBlur=6;
      ctx.font='bold 18px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(`${b.l}  ${b.v}`,cx,sY+32+i*32); ctx.shadowBlur=0;
    });
    if(item.slot){
      const sm={atk:'→ 攻撃スロット',def:'→ 防御スロット',sp:'→ 特殊スロット'};
      ctx.fillStyle='#445'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(sm[item.slot]||item.slot,cx,sY+200);
    }
  } else if(loadoutTab===2){
    const effMap={dragon:'3秒毎 炎弾発射',hawk:'3秒毎 追尾弾',heal:'被弾時 HP+15',fairy:'コイン+20%',exp:'EXP+15%',phoenix:'HP30%以下 無敵',coin:'コイン引き寄せ',turtle:'被ダメ-15%',bomber:'8秒毎に爆弾投下',ghost:'10秒毎に無敵1秒'};
    ctx.fillStyle=rc; ctx.shadowColor=rc; ctx.shadowBlur=5;
    ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(effMap[item.effect]||item.desc,cx,sY+18); ctx.shadowBlur=0;
    ctx.fillStyle='#445'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText('ペットスロット',cx,sY+46);
    const maxSlots=stage>=10?3:stage>=5?2:1;
    for(let s=0;s<3;s++){
      const pid=playerLoadout.pets[s];
      const locked=s>=maxSlots;
      const scx=cx+(s-1)*58, scy=sY+90;
      ctx.fillStyle=locked?'rgba(8,8,16,0.8)':'rgba(10,12,26,0.9)';
      ctx.strokeStyle=locked?'#1a1a22':pid===item.id?'#0f0':pid?'#cc88ff':'#2a2a3a';
      ctx.lineWidth=locked?1:1.5;
      ctx.shadowColor=pid===item.id?'#0f0':pid?'#cc88ff':'transparent'; ctx.shadowBlur=pid&&!locked?8:0;
      ctx.beginPath(); ctx.arc(scx,scy,22,0,Math.PI*2); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      if(locked){
        ctx.fillStyle='#2a2a3a'; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='center'; ctx.fillText('LOCK',scx,scy+4);
      } else if(pid){
        const pet=PET_POOL.find(p=>p.id===pid);
        if(pet){ ctx.save(); ctx.translate(scx,scy); ctx.scale(0.55,0.55); drawPetShape(pet.effect,pet.color); ctx.restore(); }
      } else {
        ctx.fillStyle='#2a3050'; ctx.font='bold 18px monospace'; ctx.textAlign='center'; ctx.fillText('+',scx,scy+7);
      }
      ctx.fillStyle=locked?'#2a2a3a':'#445'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(locked?'LOCK':`SLOT ${s+1}`,scx,scy+36);
    }
  } else {
    const wDescs={normal:'通常弾 弾数無制限',laser:'貫通レーザー',homing:'自動追尾ミサイル',explosive:'爆発弾 範囲ダメージ'};
    ctx.fillStyle='#aaa'; ctx.font='12px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(wDescs[item.weapon||'normal']||item.desc,cx,sY+18);
    if(item.ammo){
      ctx.shadowColor=rc; ctx.shadowBlur=10;
      ctx.fillStyle=rc; ctx.font='bold 36px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(`×${item.ammo}`,cx,sY+62); ctx.shadowBlur=0;
      ctx.fillStyle='#445'; ctx.font='12px Orbitron,Courier New'; ctx.fillText('AMMO',cx,sY+82);
    } else {
      ctx.shadowColor='#0f0'; ctx.shadowBlur=8;
      ctx.fillStyle='#0f0'; ctx.font='bold 18px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText('UNLIMITED  ∞',cx,sY+60); ctx.shadowBlur=0;
    }
  }

  // Level-up section (skip for CLASSIC weapon)
  if(item.id!==null){
    const inv=gachaInventory[item.id];
    const lv=inv?inv.level||1:1;
    const cost=item.id?getLevelUpCost(item):null;
    const lvY=py+ph-96;
    ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(px+14,lvY,pw-28,38,6); ctx.fill();
    ctx.strokeStyle='#1a2a2a'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(px+14,lvY,pw-28,38,6); ctx.stroke();
    // Level bar
    const barW=pw-56, barX=px+28;
    ctx.fillStyle='#0a0a18'; ctx.beginPath(); ctx.roundRect(barX,lvY+22,barW,6,3); ctx.fill();
    if(lv<30){
      ctx.fillStyle=rc; ctx.shadowColor=rc; ctx.shadowBlur=4;
      ctx.beginPath(); ctx.roundRect(barX,lvY+22,barW*(lv/30),6,3); ctx.fill(); ctx.shadowBlur=0;
    } else {
      const g=ctx.createLinearGradient(barX,0,barX+barW,0);
      g.addColorStop(0,'#ffd700'); g.addColorStop(1,'#ff8800'); ctx.fillStyle=g;
      ctx.beginPath(); ctx.roundRect(barX,lvY+22,barW,6,3); ctx.fill();
    }
    ctx.fillStyle=lv>=30?'#ffd700':rc; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(`Lv.${lv}${lv>=30?' MAX':''}`,px+28,lvY+16);
    if(cost){
      ctx.fillStyle='#556'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='right';
      ctx.fillText(`UP:${cost.dust}⊕+${cost.coins}C`,px+pw-18,lvY+16);
    }
  }

  // Enter button
  const btnY=py+ph-52;
  ctx.fillStyle=equipped?'rgba(0,28,0,0.75)':'rgba(0,36,76,0.75)';
  ctx.strokeStyle=equipped?'#0f0':'#0cf'; ctx.lineWidth=1.5;
  ctx.shadowColor=equipped?'#0f0':'#0cf'; ctx.shadowBlur=10;
  ctx.beginPath(); ctx.roundRect(px+14,btnY,pw-28,34,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
  const btnLabels=['ENTER: キャラ変更','ENTER: 装備する','ENTER: ペット設定','ENTER: 武器選択'];
  ctx.fillStyle=equipped?'#00ff66':'#0cf'; ctx.font='bold 12px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(equipped?'◉ 現在装備中':btnLabels[loadoutTab],cx,btnY+22);
  // Level-up hint
  if(item.id!==null&&getLevelUpCost(item)){
    ctx.fillStyle='#335'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('L:レベルアップ',cx,py+ph-8);
  }
}

function drawLoadoutScreen(){
  ctx.fillStyle='rgba(0,0,0,0.97)'; ctx.fillRect(0,0,W,H);

  const TAB_COLORS=['#00ccff','#ff8844','#cc88ff','#44aaff'];
  const tc=TAB_COLORS[loadoutTab];
  const bgG=ctx.createRadialGradient(148,330,0,148,330,270);
  bgG.addColorStop(0,tc+'11'); bgG.addColorStop(1,'transparent');
  ctx.fillStyle=bgG; ctx.fillRect(0,0,W,H);

  // ── TABS ──
  const TAB_LABELS=['◈  キャラ','⚙  装備','♦  ペット','▶  武器'];
  const TW=W/4;
  TAB_LABELS.forEach((label,i)=>{
    const tx=i*TW, active=loadoutTab===i, col=TAB_COLORS[i];
    ctx.fillStyle='rgba(7,8,18,0.92)'; ctx.fillRect(tx,0,TW,47);
    if(active){ ctx.save(); ctx.globalAlpha=0.14; ctx.fillStyle=col; ctx.fillRect(tx,0,TW,47); ctx.restore(); }
    if(i>0){ ctx.strokeStyle='#18182a'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(tx,4); ctx.lineTo(tx,42); ctx.stroke(); }
    ctx.fillStyle=active?col:'#3a3a55'; ctx.font=`${active?'bold ':''} 13px Orbitron,Courier New`; ctx.textAlign='center';
    ctx.shadowColor=active?col:'transparent'; ctx.shadowBlur=active?10:0;
    ctx.fillText(label,tx+TW/2,28); ctx.shadowBlur=0;
    // Bottom bar
    if(active){ ctx.fillStyle=col; ctx.shadowColor=col; ctx.shadowBlur=10; ctx.fillRect(tx+2,44,TW-4,3); ctx.shadowBlur=0; }
    else { ctx.fillStyle='#18182a'; ctx.fillRect(tx,44,TW,3); }
  });

  // Build pool
  let pool=[];
  if(loadoutTab===0) pool=CHAR_POOL.filter(c=>gachaInventory[c.id]||c.id==='char_basic');
  else if(loadoutTab===1) pool=EQUIP_POOL.filter(e=>gachaInventory[e.id]);
  else if(loadoutTab===2) pool=PET_POOL.filter(p=>gachaInventory[p.id]);
  else pool=[{id:null,rarity:'N',type:'weapon',label:'CLASSIC',desc:'通常弾・無限',color:'#aaa',weapon:'normal',ammo:0},...WEAPON_GACHA_POOL.filter(w=>gachaInventory[w.id])];
  const cur=Math.min(loadoutCursor,Math.max(0,pool.length-1));
  const curItem=pool[cur];

  // Panel dimensions (PH shorter to leave room for BACK button at y=558)
  const PX=4,  PY=50, PW=290, PH=H-PY-48;
  const LX=PX+PW+6, LY=PY, LW=W-LX-4, LH=PH;

  // Left panel bg
  ctx.fillStyle='rgba(6,8,20,0.96)'; ctx.strokeStyle='#161c36'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(PX,PY,PW,PH,8); ctx.fill(); ctx.stroke();
  // Right panel bg
  ctx.fillStyle='rgba(5,6,16,0.96)'; ctx.strokeStyle='#161c36'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(LX,LY,LW,LH,8); ctx.fill(); ctx.stroke();

  // ── LEFT: PREVIEW ──
  if(curItem) drawLoadoutPreview(PX,PY,PW,PH,curItem);
  else{
    ctx.fillStyle='#2a2a40'; ctx.font='13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('アイテムなし',PX+PW/2,PY+PH/2-10);
    ctx.fillStyle='#445'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText('ガチャで入手しよう！',PX+PW/2,PY+PH/2+12);
  }

  // ── RIGHT: ITEM GRID (4 per row) ──
  if(pool.length===0){
    ctx.fillStyle='#2a2a40'; ctx.font='13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('まだアイテムがありません',LX+LW/2,LY+LH/2-10);
    ctx.fillStyle='#445'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText('ガチャで入手しよう！',LX+LW/2,LY+LH/2+14);
  } else {
    const COLS=4, pad=8, gap=6;
    const cellW=Math.floor((LW-pad*2-gap*(COLS-1))/COLS);
    const cellH=Math.min(cellW,72);
    const visRows=Math.floor((LH-pad*2-24)/(cellH+gap));
    const curRow=Math.floor(cur/COLS);
    const startRow=Math.max(0,Math.min(curRow-Math.floor(visRows/2),Math.ceil(pool.length/COLS)-visRows));

    for(let vi=0;vi<visRows;vi++){
      for(let col=0;col<COLS;col++){
        const pi=(startRow+vi)*COLS+col;
        if(pi>=pool.length) continue;
        const item=pool[pi];
        const isActive=pi===cur;
        const rc=RARITY_COLORS[item.rarity]||item.color||'#aaa';
        const cx2=LX+pad+col*(cellW+gap);
        const cy2=LY+pad+vi*(cellH+gap);

        // Card bg
        ctx.fillStyle=isActive?`rgba(${hexToRgb(rc)||'60,60,80'},0.2)`:'rgba(10,12,28,0.88)';
        ctx.strokeStyle=isActive?rc:'#1a1e38';
        ctx.lineWidth=isActive?2:1;
        ctx.shadowColor=isActive?rc:'transparent'; ctx.shadowBlur=isActive?16:0;
        ctx.beginPath(); ctx.roundRect(cx2,cy2,cellW,cellH,7); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;

        // Top rarity bar
        ctx.fillStyle=rc; ctx.globalAlpha=isActive?0.9:0.5;
        ctx.beginPath(); ctx.roundRect(cx2,cy2,cellW,3,{upperLeft:7,upperRight:7}); ctx.fill(); ctx.globalAlpha=1;

        // Icon
        ctx.save(); ctx.translate(cx2+cellW/2,cy2+cellH/2-8);
        ctx.fillStyle=rc; ctx.shadowColor=rc; ctx.shadowBlur=isActive?12:4;
        if(item.type==='char'||item.type==='skin'){
          drawShipShape(-10,-6,20,12,'fighter');
        } else if(item.type==='pet'&&item.effect){
          ctx.scale(0.5,0.5); drawPetShape(item.effect,rc);
        } else {
          ctx.beginPath(); ctx.moveTo(0,-9); ctx.lineTo(7,0); ctx.lineTo(0,9); ctx.lineTo(-7,0); ctx.closePath(); ctx.fill();
        }
        ctx.shadowBlur=0; ctx.restore();

        // Label (truncate)
        const lbl=item.label.length>8?item.label.slice(0,7)+'…':item.label;
        ctx.fillStyle=isActive?'#fff':'#778'; ctx.font=`${isActive?'bold ':''} 9px Orbitron,Courier New`; ctx.textAlign='center';
        ctx.fillText(lbl,cx2+cellW/2,cy2+cellH-8);

        // Equipped dot
        let equipped=false;
        if(loadoutTab===0) equipped=playerLoadout.charId===item.id||(item.id==='char_basic'&&!playerLoadout.charId);
        else if(loadoutTab===1) equipped=playerLoadout.equip.includes(item.id);
        else if(loadoutTab===2) equipped=playerLoadout.pets.includes(item.id);
        else equipped=playerLoadout.weaponId===item.id||(item.id===null&&!playerLoadout.weaponId);
        if(equipped){
          ctx.fillStyle='#00ee44'; ctx.shadowColor='#0f0'; ctx.shadowBlur=6;
          ctx.beginPath(); ctx.arc(cx2+cellW-10,cy2+10,4,0,Math.PI*2); ctx.fill();
          ctx.shadowBlur=0;
        }
      }
    }

    ctx.textAlign='center';
    if(Math.ceil(pool.length/COLS)>visRows){
      ctx.fillStyle='#2a2a42'; ctx.font='10px Orbitron,Courier New';
      ctx.fillText(`${cur+1}  /  ${pool.length}  ▲▼`,LX+LW/2,LY+LH-8);
    } else if(Math.sin(frameCount*0.08)>0){
      ctx.fillStyle='#2a2a42'; ctx.font='10px Orbitron,Courier New';
      ctx.fillText('↑↓←→ 選択  ENTER セット',LX+LW/2,LY+LH-8);
    }
  }

  // Bottom hint (left panel)
  if(Math.sin(frameCount*0.06)>0){
    ctx.fillStyle='#2a2a42'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('←→ タブ切替  ESC 戻る',PX+PW/2,PY+PH-8);
  }

  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== マップ画面 =====
function drawMapScreen(){
  ctx.fillStyle='rgba(0,0,0,0.88)'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#fff'; ctx.font='bold 30px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor='#00ff55'; ctx.shadowBlur=20;
  ctx.fillText('ROUTE  SELECT',W/2,80); ctx.shadowBlur=0;
  ctx.fillStyle='#aaa'; ctx.font='13px Orbitron,Courier New';
  ctx.fillText(`STAGE ${stage+1}  /  1 または 2 キーで選択`,W/2,112);
  mapRoutes.forEach((type,i)=>{
    const x=80+i*340, y=148, w=300, h=260;
    const col=STAGE_TYPE_COLORS[type];
    ctx.fillStyle='rgba(8,8,24,0.92)'; ctx.strokeStyle=col; ctx.lineWidth=2;
    ctx.shadowColor=col; ctx.shadowBlur=18;
    ctx.beginPath(); ctx.roundRect(x,y,w,h,14); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    // 番号
    ctx.fillStyle=col; ctx.font='bold 44px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`${i+1}`,x+w/2,y+60);
    // タイプ名
    ctx.fillStyle='#fff'; ctx.font='bold 17px Orbitron,Courier New';
    ctx.fillText(STAGE_TYPE_LABELS[type],x+w/2,y+105);
    // 説明
    ctx.fillStyle='#aaa'; ctx.font='12px Orbitron,Courier New';
    ctx.fillText(STAGE_TYPE_DESCS[type],x+w/2,y+138);
    // アイコン
    ctx.fillStyle=col; ctx.font='36px Orbitron,Courier New';
    const icons={normal:'★',boss_rush:'!!',survival:'⏱',escort:'▲'};
    ctx.fillText(icons[type],x+w/2,y+200);
    // 難易度
    const diff={normal:'★★☆',boss_rush:'★★★',survival:'★★☆',escort:'★★★'};
    ctx.fillStyle='#888'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(diff[type],x+w/2,y+238);
  });
  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== 護衛艦描画 =====
function drawEscortShip(){
  if(!escortShip||!escortShip.alive) return;
  const {x,y,w,h}=escortShip;
  const pulse=0.7+Math.sin(frameCount*0.12)*0.3;
  ctx.shadowColor='#f80'; ctx.shadowBlur=12*pulse; ctx.fillStyle='#f80';
  ctx.fillRect(x+10,y,w-20,h);
  ctx.fillRect(x,y+8,14,h-12); ctx.fillRect(x+w-14,y+8,14,h-12);
  ctx.fillRect(x+w/2-5,y-10,10,14);
  ctx.fillStyle='#ff0';
  ctx.fillRect(x+w/2-3,y+6,6,6);
  ctx.shadowBlur=0;
  // HPバー
  const ratio=escortShip.hp/escortShip.maxHp;
  ctx.fillStyle='#333'; ctx.fillRect(x,y-12,w,7);
  ctx.fillStyle=ratio>0.5?'#0f0':ratio>0.25?'#ff0':'#f44';
  ctx.fillRect(x,y-12,w*ratio,7);
  ctx.fillStyle='#fff'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('ESCORT',x+w/2,y-15); ctx.textAlign='left';
}

// ===== サバイバルタイマー描画（HUD内で呼ぶ） =====
function drawSurvivalTimer(){
  if(stageType!=='survival'||bossPhase) return;
  const sec=Math.ceil(survivalTimer/60);
  const danger=sec<=10;
  const pulse=danger?0.6+Math.sin(frameCount*0.3)*0.4:1;
  ctx.globalAlpha=pulse;
  ctx.shadowColor=danger?'#f44':'#0cf'; ctx.shadowBlur=15;
  ctx.fillStyle=danger?'#f44':'#0cf';
  ctx.font=`bold 20px Orbitron,Courier New`; ctx.textAlign='center';
  ctx.fillText(`SURVIVE  ${sec}`,W/2,22);
  ctx.shadowBlur=0; ctx.textAlign='left'; ctx.globalAlpha=1;
}

// ===== ガチャ描画 =====
function drawGachaScreen(){
  // 背景
  ctx.fillStyle='#02010d'; ctx.fillRect(0,0,W,H);
  const t=frameCount*0.012;
  [[160,260,200,'#3300aa'],[320,380,140,'#660033'],[80,420,120,'#001166']].forEach(([nx,ny,nr,nc])=>{
    const ng=ctx.createRadialGradient(nx,ny,0,nx,ny,nr);
    ng.addColorStop(0,nc+'55'); ng.addColorStop(0.6,nc+'18'); ng.addColorStop(1,'transparent');
    ctx.fillStyle=ng; ctx.fillRect(0,0,W,H);
  });

  // 左右仕切り
  ctx.strokeStyle='rgba(100,60,180,0.25)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(420,0); ctx.lineTo(420,H); ctx.stroke();

  // ===== LEFT: カプセルエリア =====
  ctx.shadowColor='#aa66ff'; ctx.shadowBlur=22;
  ctx.fillStyle='#cc88ff'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('◈  GACHA  SHOP  ◈',210,38); ctx.shadowBlur=0;

  // 外周オービット
  for(let i=0;i<10;i++){
    const a=t*1.4+i*(Math.PI*2/10);
    const r=68+Math.sin(t*2.5+i*0.7)*8;
    const sx=210+Math.cos(a)*r, sy=220+Math.sin(a)*r*0.45;
    ctx.globalAlpha=0.25+Math.sin(t*3+i)*0.2;
    ctx.fillStyle=i%3===0?'#ffdd00':i%3===1?'#cc88ff':'#44aaff';
    ctx.beginPath(); ctx.arc(sx,sy,i%2===0?2:1.2,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;

  // カプセル台座グロー
  const baseG=ctx.createRadialGradient(210,268,0,210,268,60);
  baseG.addColorStop(0,'rgba(120,60,220,0.35)'); baseG.addColorStop(1,'transparent');
  ctx.fillStyle=baseG; ctx.fillRect(0,0,W,H);

  // カプセル本体
  const bob=Math.sin(t*2.4)*8;
  ctx.save();
  ctx.translate(210,220+bob);
  ctx.shadowColor='#9944ff'; ctx.shadowBlur=36;
  const cg=ctx.createLinearGradient(-26,-38,26,38);
  cg.addColorStop(0,'#f0e0ff'); cg.addColorStop(0.35,'#aa55ff'); cg.addColorStop(0.7,'#5500cc'); cg.addColorStop(1,'#1a0044');
  ctx.fillStyle=cg;
  ctx.beginPath(); ctx.ellipse(0,0,26,34,Math.sin(t*0.4)*0.08,0,Math.PI*2); ctx.fill();
  ctx.shadowBlur=0;
  ctx.globalAlpha=0.55; ctx.fillStyle='#fff';
  ctx.beginPath(); ctx.ellipse(-9,-13,8,12,-0.35,0,Math.PI*2); ctx.fill();
  ctx.globalAlpha=0.12; ctx.fillStyle='#fff';
  ctx.beginPath(); ctx.ellipse(0,0,26,34,0,0,Math.PI*2); ctx.fill();
  ctx.globalAlpha=1;
  ctx.restore();

  // コレクション進捗
  const ownedItems=ALL_GACHA_POOL.filter(i=>gachaInventory[i.id]);
  const progRatio=ownedItems.length/ALL_GACHA_POOL.length;
  const bx=24,by=306,bw=372,bh=9;
  ctx.fillStyle='rgba(255,255,255,0.07)'; ctx.beginPath(); ctx.roundRect(bx,by,bw,bh,5); ctx.fill();
  if(progRatio>0){
    const pg=ctx.createLinearGradient(bx,0,bx+bw,0);
    pg.addColorStop(0,'#ffdd00'); pg.addColorStop(1,'#cc88ff');
    ctx.fillStyle=pg; ctx.beginPath(); ctx.roundRect(bx,by,Math.max(8,bw*progRatio),bh,5); ctx.fill();
  }
  ctx.fillStyle='#555'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='left';
  ctx.fillText(`COLLECTION  ${ownedItems.length} / ${ALL_GACHA_POOL.length}`,bx,by-5);
  ctx.fillStyle='#554400'; ctx.textAlign='right';
  ctx.fillText(`✦ ${gachaStardust} dust`,bx+bw,by-5);

  // レアリティ別所持数
  ['SSR','SR','R','N'].forEach((r,ri)=>{
    const items=GACHA_POOL.filter(i=>i.rarity===r);
    const got=items.filter(i=>gachaInventory[i.id]).length;
    ctx.shadowColor=got>0?RARITY_COLORS[r]:'transparent'; ctx.shadowBlur=got>0?5:0;
    ctx.fillStyle=got>0?RARITY_COLORS[r]:'#333';
    ctx.font='9px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(`${r} ${got}/${items.length}`,bx+ri*95,by+22);
    ctx.shadowBlur=0;
  });

  // ===== RIGHT: タブ切り替え =====
  const tabW=164, tabH=34, tab1x=432, tab2x=596;
  // NORMAL タブ
  ctx.fillStyle=gachaTab===0?'rgba(80,56,0,0.95)':'rgba(18,18,24,0.85)';
  ctx.strokeStyle=gachaTab===0?'#ffd700':'#2a2a3a'; ctx.lineWidth=gachaTab===0?2:1;
  ctx.beginPath(); ctx.roundRect(tab1x,6,tabW,tabH,{upperLeft:8,upperRight:0,lowerRight:0,lowerLeft:8}); ctx.fill(); ctx.stroke();
  ctx.fillStyle=gachaTab===0?'#ffd700':'#444'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor=gachaTab===0?'#ffd700':'transparent'; ctx.shadowBlur=gachaTab===0?8:0;
  ctx.fillText('[ Q ] NORMAL',tab1x+tabW/2,28); ctx.shadowBlur=0;
  // PREMIUM タブ
  const pkItem=ALL_GACHA_POOL.find(i=>i.id===currentPickupId);
  ctx.fillStyle=gachaTab===1?'rgba(60,0,100,0.97)':'rgba(18,18,24,0.85)';
  ctx.strokeStyle=gachaTab===1?'#cc44ff':'#2a2a3a'; ctx.lineWidth=gachaTab===1?2:1;
  ctx.beginPath(); ctx.roundRect(tab2x,6,tabW,tabH,{upperLeft:0,upperRight:8,lowerRight:8,lowerLeft:0}); ctx.fill(); ctx.stroke();
  ctx.fillStyle=gachaTab===1?'#dd88ff':'#444'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.shadowColor=gachaTab===1?'#cc44ff':'transparent'; ctx.shadowBlur=gachaTab===1?8:0;
  ctx.fillText('[ E ] PREMIUM 💎',tab2x+tabW/2,28); ctx.shadowBlur=0;

  if(gachaTab===0){
    // ===== 通常ガチャ (COINS) =====
    const coinPulse=0.88+Math.sin(t*3.5)*0.12;
    ctx.shadowColor='#ffd700'; ctx.shadowBlur=14*coinPulse;
    ctx.fillStyle='#887700'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText('● COINS',434,58);
    ctx.fillStyle='#ffd700'; ctx.font='bold 26px Orbitron,Courier New';
    ctx.fillText(coins.toLocaleString(),434,86); ctx.shadowBlur=0;
    // デイリー無料ボタン
    const canDaily=canDailyGacha();
    const bdY=96;
    ctx.fillStyle=canDaily?'rgba(0,50,30,0.95)':'rgba(14,14,14,0.7)';
    ctx.strokeStyle=canDaily?'#00ff88':'#1a2a1a'; ctx.lineWidth=canDaily?2:1;
    ctx.beginPath(); ctx.roundRect(432,bdY,328,38,8); ctx.fill(); ctx.stroke();
    ctx.fillStyle=canDaily?'#00ff88':'#334'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(canDaily?'[ D ] DAILY FREE GACHA ★':'DAILY FREE GACHA  (済み)',596,bdY+24);
    // 1回ボタン
    const can1=coins>=500;
    const b1y=144;
    ctx.shadowColor=can1?'#ffd700':'transparent'; ctx.shadowBlur=can1?12:0;
    const bg1=ctx.createLinearGradient(432,b1y,760,b1y+90);
    bg1.addColorStop(0,can1?'rgba(100,72,0,0.97)':'rgba(20,20,20,0.85)');
    bg1.addColorStop(1,can1?'rgba(60,42,0,0.95)':'rgba(14,14,14,0.85)');
    ctx.fillStyle=bg1; ctx.strokeStyle=can1?'#ffd700':'#252525'; ctx.lineWidth=can1?2:1;
    ctx.beginPath(); ctx.roundRect(432,b1y,328,90,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=can1?'#ffd700':'#2a2a2a'; ctx.beginPath(); ctx.roundRect(432,b1y,50,24,{upperLeft:12,upperRight:0,lowerRight:0,lowerLeft:0}); ctx.fill();
    ctx.fillStyle='#000'; ctx.font='bold 10px Orbitron,Courier New'; ctx.textAlign='center'; ctx.fillText('×1',457,b1y+16);
    ctx.fillStyle=can1?'#ffe566':'#3a3a3a'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText('SINGLE  PULL',448,b1y+48);
    ctx.fillStyle=can1?'#aa8822':'#2a2a2a'; ctx.font='12px Orbitron,Courier New'; ctx.fillText('500 coins',448,b1y+66);
    ctx.fillStyle=can1?'#66ee66':'#3a1500'; ctx.font='10px Orbitron,Courier New';
    ctx.fillText(can1?'[ 1 ] キー':'コイン不足',448,b1y+84);
    // 10連ボタン
    const can10=coins>=5000;
    const b2y=244;
    ctx.shadowColor=can10?'#cc88ff':'transparent'; ctx.shadowBlur=can10?14:0;
    const bg2=ctx.createLinearGradient(432,b2y,760,b2y+102);
    bg2.addColorStop(0,can10?'rgba(70,12,120,0.97)':'rgba(20,20,20,0.85)');
    bg2.addColorStop(1,can10?'rgba(44,6,80,0.95)':'rgba(14,14,14,0.85)');
    ctx.fillStyle=bg2; ctx.strokeStyle=can10?'#cc88ff':'#252525'; ctx.lineWidth=can10?2:1;
    ctx.beginPath(); ctx.roundRect(432,b2y,328,102,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=can10?'#cc88ff':'#2a2a2a'; ctx.beginPath(); ctx.roundRect(432,b2y,50,24,{upperLeft:12,upperRight:0,lowerRight:0,lowerLeft:0}); ctx.fill();
    ctx.fillStyle='#000'; ctx.font='bold 10px Orbitron,Courier New'; ctx.textAlign='center'; ctx.fillText('×10',457,b2y+16);
    ctx.shadowColor=can10?'#ff9900':'transparent'; ctx.shadowBlur=can10?8:0;
    ctx.fillStyle=can10?'rgba(80,40,0,0.92)':'rgba(25,18,0,0.7)'; ctx.strokeStyle=can10?'#ff9900':'#2a2000'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(570,b2y+5,182,20,4); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=can10?'#ff9900':'#3a2800'; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('★ SR以上 1枚確定',661,b2y+19);
    ctx.fillStyle=can10?'#dd99ff':'#3a3a3a'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText('10×  PULL',448,b2y+58);
    ctx.fillStyle=can10?'#8844aa':'#2a2a2a'; ctx.font='12px Orbitron,Courier New'; ctx.fillText('5,000 coins',448,b2y+76);
    ctx.fillStyle=can10?'#88aaff':'#3a1500'; ctx.font='10px Orbitron,Courier New';
    ctx.fillText(can10?'[ 2 ] キー':'コイン不足',448,b2y+96);
    // 天井バー
    const b3y=356; const pityLeft=80-gachaPityCount;
    const pityCol=pityLeft<=10?'#ff4444':pityLeft<=20?'#ff9900':'#445566';
    ctx.fillStyle='rgba(14,14,28,0.92)'; ctx.strokeStyle=pityLeft<=10?'#ff4444':'#1a2a3a'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(432,b3y,328,30,8); ctx.fill(); ctx.stroke();
    ctx.fillStyle=pityCol; ctx.shadowColor=pityCol; ctx.shadowBlur=pityLeft<=10?6:0;
    ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`天井 ${pityLeft}回  ( SSR確定 80連 )`,596,b3y+19); ctx.shadowBlur=0;
    ctx.fillStyle='#1a1a2a'; ctx.fillRect(436,b3y+24,320,4);
    ctx.fillStyle=pityCol; ctx.fillRect(436,b3y+24,320*(gachaPityCount/80),4);
    // LR天井バー
    const lrPityLeft=200-lrPityCount;
    const lrPityCol=lrPityLeft<=20?'#ff2266':lrPityLeft<=50?'#ff8800':'#552233';
    ctx.fillStyle='rgba(14,8,20,0.92)'; ctx.strokeStyle=lrPityLeft<=20?'#ff2266':'#33001a'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(432,b3y+34,328,22,5); ctx.fill(); ctx.stroke();
    ctx.fillStyle=lrPityCol; ctx.shadowColor=lrPityCol; ctx.shadowBlur=lrPityLeft<=20?6:0;
    ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`LR天井 ${lrPityLeft}回 ( LEGEND確定 200連 )`,596,b3y+49); ctx.shadowBlur=0;
    ctx.fillStyle='#1a0a12'; ctx.fillRect(436,b3y+52,320,3);
    ctx.fillStyle=lrPityCol; ctx.fillRect(436,b3y+52,320*(lrPityCount/200),3);

  } else {
    // ===== プレミアムガチャ (GEMS) =====
    ctx.shadowColor='#cc44ff'; ctx.shadowBlur=14;
    ctx.fillStyle='#660088'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='left'; ctx.fillText('💎 GEMS',434,58);
    ctx.fillStyle='#dd88ff'; ctx.font='bold 26px Orbitron,Courier New'; ctx.fillText(gems,434,86); ctx.shadowBlur=0;

    // ピックアップバナー
    if(pkItem){
      const pkc=RARITY_COLORS[pkItem.rarity]||'#ffdd00';
      ctx.save(); ctx.globalAlpha=0.12; ctx.fillStyle=pkc;
      ctx.beginPath(); ctx.roundRect(432,96,328,60,10); ctx.fill(); ctx.restore();
      ctx.fillStyle='rgba(10,6,20,0.9)'; ctx.strokeStyle=pkc; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.roundRect(432,96,328,60,10); ctx.fill(); ctx.stroke();
      ctx.shadowColor=pkc; ctx.shadowBlur=10;
      ctx.fillStyle='#ff4'; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='left';
      ctx.fillText('★ PICKUP',440,113); ctx.shadowBlur=0;
      ctx.fillStyle=pkc; ctx.font='bold 14px Orbitron,Courier New'; ctx.fillText(pkItem.label,440,130);
      ctx.fillStyle='#777'; ctx.font='10px Orbitron,Courier New'; ctx.fillText(`[${pkItem.rarity}] ${pkItem.desc}`,440,146);
      // mini icon
      ctx.save(); ctx.translate(742,126); ctx.scale(0.7,0.7); ctx.fillStyle=pkc; ctx.shadowColor=pkc; ctx.shadowBlur=12;
      drawGachaItemIcon(pkItem); ctx.restore();
    }

    // 1回 (5gems)
    const canP1=gems>=5;
    const pb1y=166;
    ctx.shadowColor=canP1?'#cc44ff':'transparent'; ctx.shadowBlur=canP1?12:0;
    const pbg1=ctx.createLinearGradient(432,pb1y,760,pb1y+90);
    pbg1.addColorStop(0,canP1?'rgba(80,0,140,0.97)':'rgba(20,20,20,0.85)');
    pbg1.addColorStop(1,canP1?'rgba(50,0,90,0.95)':'rgba(14,14,14,0.85)');
    ctx.fillStyle=pbg1; ctx.strokeStyle=canP1?'#cc44ff':'#252525'; ctx.lineWidth=canP1?2:1;
    ctx.beginPath(); ctx.roundRect(432,pb1y,328,90,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=canP1?'#cc44ff':'#2a2a2a'; ctx.beginPath(); ctx.roundRect(432,pb1y,50,24,{upperLeft:12,upperRight:0,lowerRight:0,lowerLeft:0}); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font='bold 10px Orbitron,Courier New'; ctx.textAlign='center'; ctx.fillText('×1',457,pb1y+16);
    ctx.fillStyle=canP1?'#ee88ff':'#3a3a3a'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText('PREMIUM  PULL',448,pb1y+48);
    ctx.fillStyle=canP1?'#9944cc':'#2a2a2a'; ctx.font='12px Orbitron,Courier New'; ctx.fillText('5 💎 gems',448,pb1y+66);
    ctx.fillStyle=canP1?'#cc88ff':'#3a1500'; ctx.font='10px Orbitron,Courier New';
    ctx.fillText(canP1?'[ 1 ] キー':'ジェム不足',448,pb1y+84);

    // 10連 (50gems)
    const canP10=gems>=50;
    const pb2y=266;
    ctx.shadowColor=canP10?'#ff88ff':'transparent'; ctx.shadowBlur=canP10?14:0;
    const pbg2=ctx.createLinearGradient(432,pb2y,760,pb2y+102);
    pbg2.addColorStop(0,canP10?'rgba(120,0,160,0.97)':'rgba(20,20,20,0.85)');
    pbg2.addColorStop(1,canP10?'rgba(80,0,110,0.95)':'rgba(14,14,14,0.85)');
    ctx.fillStyle=pbg2; ctx.strokeStyle=canP10?'#ff88ff':'#252525'; ctx.lineWidth=canP10?2:1;
    ctx.beginPath(); ctx.roundRect(432,pb2y,328,102,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=canP10?'#ff88ff':'#2a2a2a'; ctx.beginPath(); ctx.roundRect(432,pb2y,50,24,{upperLeft:12,upperRight:0,lowerRight:0,lowerLeft:0}); ctx.fill();
    ctx.fillStyle='#fff'; ctx.font='bold 10px Orbitron,Courier New'; ctx.textAlign='center'; ctx.fillText('×10',457,pb2y+16);
    ctx.shadowColor=canP10?'#ffdd00':'transparent'; ctx.shadowBlur=canP10?8:0;
    ctx.fillStyle=canP10?'rgba(80,60,0,0.9)':'rgba(25,18,0,0.7)'; ctx.strokeStyle=canP10?'#ffdd00':'#2a2000'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(570,pb2y+5,182,20,4); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=canP10?'#ffdd00':'#3a2800'; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('★ SSR排出率 20%',661,pb2y+19);
    ctx.fillStyle=canP10?'#ff88ff':'#3a3a3a'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText('10×  PREMIUM',448,pb2y+58);
    ctx.fillStyle=canP10?'#bb44cc':'#2a2a2a'; ctx.font='12px Orbitron,Courier New'; ctx.fillText('50 💎 gems',448,pb2y+76);
    ctx.fillStyle=canP10?'#ee88ff':'#3a1500'; ctx.font='10px Orbitron,Courier New';
    ctx.fillText(canP10?'[ 2 ] キー':'ジェム不足',448,pb2y+96);

    // 天井バー (premium)
    const pb3y=378; const ppLeft=50-premiumPityCount;
    const ppCol=ppLeft<=5?'#ff4444':ppLeft<=15?'#ff9900':'#6633aa';
    ctx.fillStyle='rgba(14,14,28,0.92)'; ctx.strokeStyle=ppLeft<=5?'#ff4444':'#2a1a3a'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(432,pb3y,328,30,8); ctx.fill(); ctx.stroke();
    ctx.fillStyle=ppCol; ctx.shadowColor=ppCol; ctx.shadowBlur=ppLeft<=5?6:0;
    ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`天井 ${ppLeft}回  ( SSR確定 50連 )`,596,pb3y+19); ctx.shadowBlur=0;
    ctx.fillStyle='#1a1a2a'; ctx.fillRect(436,pb3y+24,320,4);
    ctx.fillStyle=ppCol; ctx.fillRect(436,pb3y+24,320*(premiumPityCount/50),4);
    // プレミアムLR天井バー
    const plrLeft=100-premiumLrPityCount;
    const plrCol=plrLeft<=10?'#ff2266':plrLeft<=25?'#ff8800':'#552233';
    ctx.fillStyle='rgba(14,8,20,0.92)'; ctx.strokeStyle=plrLeft<=10?'#ff2266':'#33001a'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(432,pb3y+34,328,22,5); ctx.fill(); ctx.stroke();
    ctx.fillStyle=plrCol; ctx.shadowColor=plrCol; ctx.shadowBlur=plrLeft<=10?6:0;
    ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`LR天井 ${plrLeft}回 ( LEGEND確定 100連 )`,596,pb3y+49); ctx.shadowBlur=0;
    ctx.fillStyle='#1a0a12'; ctx.fillRect(436,pb3y+52,320,3);
    ctx.fillStyle=plrCol; ctx.fillRect(436,pb3y+52,320*(premiumLrPityCount/100),3);
  }

  // 排出率・スターダストショップ（共通）
  const b3y=418;
  ctx.fillStyle='rgba(18,18,30,0.92)'; ctx.strokeStyle='#2a2a3a'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(432,b3y,154,30,8); ctx.fill(); ctx.stroke();
  ctx.fillStyle='#555'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('[ R ] 排出率',509,b3y+20);
  ctx.fillStyle='rgba(14,14,28,0.92)'; ctx.strokeStyle='#2a2a3a'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(594,b3y,166,30,8); ctx.fill(); ctx.stroke();
  ctx.fillStyle='#665500'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`[ S ] DUST SHOP ✦${gachaStardust}`,677,b3y+20);

  // ナビヒント
  ctx.fillStyle='#222233'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('ESC: 戻る   Q/E: タブ切替',596,H-8);

  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== ガチャアイテムアイコン =====
function drawGachaItemIcon(item){
  const ic=item.color||RARITY_COLORS[item.rarity]||'#aaa';
  ctx.fillStyle=ic; ctx.strokeStyle=ic;
  const t=item.type;

  if(t==='char'||t==='skin'){
    const r=item.rarity;
    if(r==='SSR'){
      ctx.beginPath(); ctx.moveTo(0,-24); ctx.lineTo(10,6); ctx.lineTo(7,18); ctx.lineTo(-7,18); ctx.lineTo(-10,6); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-8,-4); ctx.lineTo(-14,-10); ctx.lineTo(-18,2); ctx.lineTo(-10,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(8,-4); ctx.lineTo(14,-10); ctx.lineTo(18,2); ctx.lineTo(10,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-9,4); ctx.lineTo(-22,16); ctx.lineTo(-18,8); ctx.lineTo(-11,6); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(9,4); ctx.lineTo(22,16); ctx.lineTo(18,8); ctx.lineTo(11,6); ctx.closePath(); ctx.fill();
      ctx.fillRect(-9,14,4,7); ctx.fillRect(-4,14,3,5); ctx.fillRect(1,14,3,5); ctx.fillRect(5,14,4,7);
      ctx.save(); ctx.globalAlpha=0.35; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.arc(0,0,28,0,Math.PI*2); ctx.stroke(); ctx.restore();
    } else if(r==='SR'){
      ctx.beginPath(); ctx.moveTo(0,-22); ctx.lineTo(9,8); ctx.lineTo(6,18); ctx.lineTo(-6,18); ctx.lineTo(-9,8); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-7,2); ctx.lineTo(-20,16); ctx.lineTo(-15,8); ctx.lineTo(-9,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(7,2); ctx.lineTo(20,16); ctx.lineTo(15,8); ctx.lineTo(9,4); ctx.closePath(); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.8; ctx.fillRect(-8,12,5,7); ctx.fillRect(3,12,5,7); ctx.restore();
    } else if(r==='R'){
      ctx.beginPath(); ctx.moveTo(0,-20); ctx.lineTo(7,8); ctx.lineTo(0,14); ctx.lineTo(-7,8); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-5,0); ctx.lineTo(-18,14); ctx.lineTo(-13,6); ctx.lineTo(-7,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(5,0); ctx.lineTo(18,14); ctx.lineTo(13,6); ctx.lineTo(7,4); ctx.closePath(); ctx.fill();
    } else {
      ctx.beginPath(); ctx.moveTo(0,-16); ctx.lineTo(8,10); ctx.lineTo(-8,10); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-6,4); ctx.lineTo(-13,12); ctx.lineTo(-8,10); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(6,4); ctx.lineTo(13,12); ctx.lineTo(8,10); ctx.closePath(); ctx.fill();
    }

  } else if(t==='equip'){
    const slot=item.slot||'atk';
    if(slot==='def'){
      ctx.beginPath(); ctx.moveTo(0,-20); ctx.lineTo(15,-12); ctx.lineTo(15,4); ctx.quadraticCurveTo(15,20,0,26); ctx.quadraticCurveTo(-15,20,-15,4); ctx.lineTo(-15,-12); ctx.closePath(); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.28; ctx.fillStyle='#fff';
      ctx.beginPath(); ctx.moveTo(0,-13); ctx.lineTo(9,-7); ctx.lineTo(9,4); ctx.quadraticCurveTo(9,14,0,18); ctx.quadraticCurveTo(-9,14,-9,4); ctx.lineTo(-9,-7); ctx.closePath(); ctx.fill();
      ctx.restore();
    } else if(slot==='sp'){
      ctx.beginPath(); ctx.moveTo(5,-22); ctx.lineTo(-4,0); ctx.lineTo(2,0); ctx.lineTo(-6,22); ctx.lineTo(12,-2); ctx.lineTo(5,-2); ctx.closePath(); ctx.fill();
    } else {
      ctx.beginPath(); ctx.moveTo(0,-22); ctx.lineTo(13,-6); ctx.lineTo(13,4); ctx.lineTo(0,22); ctx.lineTo(-13,4); ctx.lineTo(-13,-6); ctx.closePath(); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.32; ctx.fillStyle='#fff';
      ctx.beginPath(); ctx.moveTo(0,-14); ctx.lineTo(8,-4); ctx.lineTo(0,14); ctx.lineTo(-8,-4); ctx.closePath(); ctx.fill();
      ctx.restore(); ctx.fillStyle=ic;
      ctx.save(); ctx.globalAlpha=0.45; ctx.lineWidth=0.8;
      ctx.beginPath(); ctx.moveTo(-13,-6); ctx.lineTo(0,-22); ctx.lineTo(13,-6); ctx.moveTo(0,-22); ctx.lineTo(0,-4); ctx.stroke();
      ctx.restore();
    }

  } else if(t==='pet'){
    const eff=item.effect||'';
    if(eff==='dragon'){
      ctx.beginPath(); ctx.moveTo(-8,-12); ctx.lineTo(-12,-24); ctx.lineTo(-4,-14); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(8,-12); ctx.lineTo(12,-24); ctx.lineTo(4,-14); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.ellipse(0,4,13,11,0,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.35; ctx.fillStyle='#000';
      ctx.beginPath(); ctx.ellipse(0,10,8,5,0,0,Math.PI*2); ctx.fill(); ctx.restore();
      ctx.fillStyle='#ff6600';
      ctx.beginPath(); ctx.arc(-4,0,2.5,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(4,0,2.5,0,Math.PI*2); ctx.fill();
    } else if(eff==='hawk'){
      ctx.beginPath(); ctx.ellipse(0,0,4,10,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-3,-2); ctx.lineTo(-22,-5); ctx.lineTo(-16,6); ctx.lineTo(-4,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(3,-2); ctx.lineTo(22,-5); ctx.lineTo(16,6); ctx.lineTo(4,4); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-4,8); ctx.lineTo(0,20); ctx.lineTo(4,8); ctx.closePath(); ctx.fill();
    } else if(eff==='fairy'){
      ctx.beginPath();
      for(let i=0;i<5;i++){
        const ao=(Math.PI*2/5)*i-Math.PI/2, ai=ao+Math.PI/5;
        if(i===0) ctx.moveTo(Math.cos(ao)*18,Math.sin(ao)*18); else ctx.lineTo(Math.cos(ao)*18,Math.sin(ao)*18);
        ctx.lineTo(Math.cos(ai)*8,Math.sin(ai)*8);
      }
      ctx.closePath(); ctx.fill();
    } else if(eff==='phoenix'){
      ctx.beginPath(); ctx.moveTo(0,-18); ctx.lineTo(8,-2); ctx.lineTo(0,4); ctx.lineTo(-8,-2); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-7,6); ctx.lineTo(-12,20); ctx.lineTo(-6,14); ctx.lineTo(-2,22); ctx.lineTo(0,14); ctx.lineTo(2,22); ctx.lineTo(6,14); ctx.lineTo(12,20); ctx.lineTo(7,6); ctx.closePath(); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.75;
      ctx.beginPath(); ctx.moveTo(-6,-4); ctx.lineTo(-18,4); ctx.lineTo(-12,10); ctx.lineTo(-5,6); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(6,-4); ctx.lineTo(18,4); ctx.lineTo(12,10); ctx.lineTo(5,6); ctx.closePath(); ctx.fill();
      ctx.restore();
    } else if(eff==='heal'){
      ctx.beginPath(); ctx.arc(-6,-4,9,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(6,-4,9,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(0,6,13,0,Math.PI); ctx.fill(); ctx.fillRect(-13,0,26,8);
      ctx.save(); ctx.globalAlpha=0.6; ctx.fillStyle='#000';
      ctx.beginPath(); ctx.arc(-5,-2,3,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(5,-2,3,0,Math.PI*2); ctx.fill(); ctx.restore();
    } else if(eff==='exp'||eff==='bot'){
      ctx.fillRect(-13,-12,26,22); ctx.fillRect(-2,-22,4,12);
      ctx.beginPath(); ctx.arc(0,-24,4,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.fillStyle='#000'; ctx.fillRect(-9,-7,7,5); ctx.fillRect(2,-7,7,5);
      ctx.fillStyle='#0ff'; ctx.globalAlpha=0.9; ctx.fillRect(-8,-6,5,3); ctx.fillRect(3,-6,5,3);
      ctx.fillStyle='#000'; ctx.globalAlpha=1; ctx.fillRect(-7,2,14,4); ctx.restore();
    } else if(eff==='turtle'){
      ctx.beginPath(); ctx.ellipse(0,2,18,14,0,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.45; ctx.strokeStyle='#004400'; ctx.lineWidth=1.5;
      for(let h=0;h<6;h++){const a=h*Math.PI/3; ctx.beginPath(); ctx.moveTo(0,2); ctx.lineTo(Math.cos(a)*16,2+Math.sin(a)*12); ctx.stroke();}
      ctx.restore(); ctx.fillStyle='#88cc88';
      ctx.beginPath(); ctx.ellipse(-6,-14,3,5,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(6,-14,3,5,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(0,18,3,5,0,0,Math.PI*2); ctx.fill();
    } else if(eff==='bomber'){
      ctx.beginPath(); ctx.ellipse(0,0,12,8,0,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.55; ctx.fillStyle='#111';
      ctx.fillRect(-11,-4,7,8); ctx.fillRect(-2,-4,7,8);
      ctx.restore(); ctx.fillStyle='rgba(255,255,80,0.9)';
      ctx.beginPath(); ctx.ellipse(0,-12,10,5,-0.2,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(0,12,10,5,0.2,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#ff2200'; ctx.beginPath(); ctx.arc(0,0,4,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#ff0'; ctx.beginPath(); ctx.arc(0,0,2,0,Math.PI*2); ctx.fill();
    } else if(eff==='ghost'){
      ctx.save(); ctx.globalAlpha=0.75;
      ctx.beginPath(); ctx.arc(0,-4,16,Math.PI,0);
      ctx.lineTo(16,12);
      ctx.quadraticCurveTo(10,6,5,12); ctx.quadraticCurveTo(0,6,-5,12); ctx.quadraticCurveTo(-10,6,-16,12);
      ctx.lineTo(-16,12); ctx.closePath(); ctx.fill();
      ctx.restore(); ctx.fillStyle='#111';
      ctx.beginPath(); ctx.ellipse(-5,-5,3,4,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(5,-5,3,4,0,0,Math.PI*2); ctx.fill();
    } else {
      // cat
      ctx.beginPath(); ctx.moveTo(-11,-14); ctx.lineTo(-16,-24); ctx.lineTo(-4,-16); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(11,-14); ctx.lineTo(16,-24); ctx.lineTo(4,-16); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.arc(0,-6,13,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(0,10,9,12,0,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.globalAlpha=0.65; ctx.fillStyle='#000';
      ctx.beginPath(); ctx.ellipse(-4,-6,2.5,3.5,-0.2,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(4,-6,2.5,3.5,0.2,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }

  } else if(t==='weapon'){
    const wp=item.weapon||'';
    if(wp==='laser'){
      ctx.fillRect(-3,-28,6,36); ctx.fillRect(-2,-32,4,6);
      ctx.beginPath(); ctx.roundRect(-10,2,20,14,3); ctx.fill();
      ctx.save(); ctx.fillStyle='#fff'; ctx.globalAlpha=0.65; ctx.fillRect(-1.5,-22,3,20); ctx.restore();
    } else if(wp==='homing'){
      ctx.beginPath(); ctx.ellipse(0,0,11,20,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.moveTo(0,-24); ctx.lineTo(-7,-18); ctx.lineTo(7,-18); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(-8,14); ctx.lineTo(-14,22); ctx.lineTo(-6,18); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(8,14); ctx.lineTo(14,22); ctx.lineTo(6,18); ctx.closePath(); ctx.fill();
    } else if(wp==='explosive'){
      ctx.beginPath(); ctx.arc(0,4,17,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.strokeStyle=ic; ctx.lineWidth=3;
      ctx.beginPath(); ctx.moveTo(0,-13); ctx.quadraticCurveTo(8,-20,4,-26); ctx.stroke(); ctx.restore();
      ctx.fillStyle='#ff4'; ctx.beginPath(); ctx.arc(4,-27,4,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.fillStyle='#fff'; ctx.globalAlpha=0.18;
      ctx.beginPath(); ctx.arc(-5,-2,6,0,Math.PI*2); ctx.fill(); ctx.restore();
    } else if(wp==='pulse'){
      // pulse cannon: sleek multi-barrel rapid fire
      ctx.fillRect(-2,-30,4,36); ctx.fillRect(-8,-28,4,32); ctx.fillRect(4,-28,4,32);
      ctx.beginPath(); ctx.roundRect(-10,4,20,10,3); ctx.fill();
      ctx.save(); ctx.fillStyle='#fff'; ctx.globalAlpha=0.5;
      ctx.fillRect(-1,-24,2,18); ctx.restore();
      ctx.save(); ctx.fillStyle='#ff8833'; ctx.globalAlpha=0.7;
      ctx.beginPath(); ctx.arc(0,-30,3,0,Math.PI*2); ctx.fill();
      ctx.restore();
    } else if(wp==='gravity'){
      // gravity bomb: orb with orbit rings
      ctx.beginPath(); ctx.arc(0,4,14,0,Math.PI*2); ctx.fill();
      ctx.save(); ctx.strokeStyle=ic; ctx.lineWidth=2; ctx.globalAlpha=0.6;
      ctx.beginPath(); ctx.ellipse(0,4,22,7,0,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(0,4,7,22,0,0,Math.PI*2); ctx.stroke();
      ctx.restore();
      ctx.save(); ctx.fillStyle='#fff'; ctx.globalAlpha=0.22;
      ctx.beginPath(); ctx.arc(-4,-1,5,0,Math.PI*2); ctx.fill(); ctx.restore();
      ctx.fillStyle='#000'; ctx.beginPath(); ctx.arc(0,4,6,0,Math.PI*2); ctx.fill();
      ctx.fillStyle=ic; ctx.beginPath(); ctx.arc(0,4,3,0,Math.PI*2); ctx.fill();
    } else {
      // spread/classic
      ctx.fillRect(-9,-22,5,28); ctx.fillRect(-3,-26,6,30); ctx.fillRect(4,-22,5,28);
      ctx.beginPath(); ctx.roundRect(-11,4,22,14,4); ctx.fill();
    }
  } else {
    ctx.beginPath(); ctx.moveTo(0,-18); ctx.lineTo(13,0); ctx.lineTo(0,18); ctx.lineTo(-13,0); ctx.closePath(); ctx.fill();
  }
}

function drawGachaResult(){
  const item=gachaResults[gachaCurrentIdx];
  if(!item) return;
  const isLR=item.rarity==='LR';
  const rc=isLR?getLRColor(frameCount*0.06):RARITY_COLORS[item.rarity];
  const isSSR=item.rarity==='SSR', isSR=item.rarity==='SR';
  const stall=gateStall(item.rarity), total=gateTotal(item.rarity);
  const f=gachaAnimFrame;
  const cx=W/2, cy=H/2;

  ctx.fillStyle='#000'; ctx.fillRect(0,0,W,H);

  // LR: 背景レインボーオーラ
  if(isLR){
    for(let i=0;i<7;i++){
      const a=i/7, col=getLRColor(i+frameCount*0.04);
      const g=ctx.createRadialGradient(cx,cy,0,cx,cy,400);
      g.addColorStop(a,'transparent'); g.addColorStop(Math.min(1,a+0.18),col+'18'); g.addColorStop(Math.min(1,a+0.36),'transparent');
      ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
    }
  }

  // ===== フェーズ1: ゲートが開く =====
  if(f<=GATE_OPEN+stall+GATE_WARPOUT){
    const openProg=Math.min(1,f/GATE_OPEN);
    const maxR=isLR?240:isSSR?200:isSR?170:130;
    const gateR=maxR*openProg;

    const glowSize=isLR?440:isSSR?360:isSR?290:230;
    const glow=ctx.createRadialGradient(cx,cy,0,cx,cy,glowSize);
    glow.addColorStop(0,RARITY_COLORS[item.rarity]+(isLR?'55':isSSR?'44':isSR?'30':'22')); glow.addColorStop(1,'transparent');
    ctx.fillStyle=glow; ctx.fillRect(0,0,W,H);

    if(gateR>10){
      ctx.save(); ctx.translate(cx,cy);
      const rot=f*0.05;

      ctx.strokeStyle=rc; ctx.lineWidth=isLR?6:isSSR?4:3;
      ctx.shadowColor=rc; ctx.shadowBlur=isLR?50:isSSR?32:18;
      ctx.globalAlpha=openProg;
      ctx.beginPath(); ctx.arc(0,0,gateR,0,Math.PI*2); ctx.stroke();

      ctx.rotate(-rot*1.6);
      ctx.strokeStyle=isSSR?'#fff':rc; ctx.lineWidth=isSSR?2:1.5; ctx.shadowBlur=isSSR?16:8;
      ctx.setLineDash([12,8]);
      ctx.beginPath(); ctx.arc(0,0,gateR*0.72,0,Math.PI*2); ctx.stroke();
      ctx.setLineDash([]);

      ctx.rotate(rot*3.2);
      ctx.strokeStyle=rc; ctx.lineWidth=isSSR?3:2; ctx.shadowBlur=isSSR?22:12;
      ctx.beginPath(); ctx.arc(0,0,gateR*0.44,0,Math.PI*2); ctx.stroke();
      ctx.shadowBlur=0;

      const spCount=isSSR?16:isSR?12:8;
      for(let i=0;i<spCount;i++){
        const a=(Math.PI*2/spCount)*i+f*0.025;
        const sx=Math.cos(a)*gateR, sy=Math.sin(a)*gateR;
        ctx.fillStyle=isSSR?'#fff':rc;
        ctx.shadowColor=rc; ctx.shadowBlur=isSSR?14:8;
        const sp=isSSR?4:isSR?3:2;
        ctx.beginPath(); ctx.arc(sx,sy,sp,0,Math.PI*2); ctx.fill();
        ctx.shadowBlur=0;
        if(isSSR){
          ctx.strokeStyle='rgba(255,255,180,0.3)'; ctx.lineWidth=1;
          ctx.beginPath(); ctx.moveTo(sx,sy); ctx.lineTo(sx*1.35,sy*1.35); ctx.stroke();
        }
      }

      const innerR=gateR*0.38;
      ctx.globalAlpha=Math.min(1,openProg*1.5);
      const hole=ctx.createRadialGradient(0,0,0,0,0,innerR);
      hole.addColorStop(0,'#000'); hole.addColorStop(0.7,'#000'); hole.addColorStop(1,'transparent');
      ctx.fillStyle=hole; ctx.beginPath(); ctx.arc(0,0,innerR,0,Math.PI*2); ctx.fill();
      ctx.globalAlpha=1;
      ctx.restore();
    }

    // ===== フェーズ1.5: STALL =====
    if(f>GATE_OPEN && f<=GATE_OPEN+stall){
      const stallProg=(f-GATE_OPEN)/stall;
      const flicker=Math.sin(f*0.8)>0;
      const fastFlick=Math.sin(f*1.8)>0;

      if(isLR){
        // レインボー全画面パルス
        const rainCol=getLRColor(frameCount*0.1);
        ctx.globalAlpha=Math.abs(Math.sin(f*0.12))*0.35;
        ctx.fillStyle=rainCol; ctx.fillRect(0,0,W,H);
        ctx.globalAlpha=1;

        // レインボーライトニング
        ctx.save(); ctx.translate(cx,cy);
        for(let b=0;b<12;b++){
          if((b+Math.floor(f/3))%2!==0) continue;
          const baseA=(Math.PI*2/12)*b+f*0.03;
          ctx.strokeStyle=getLRColor(b*0.5+frameCount*0.08);
          ctx.lineWidth=1.5+Math.random()*2;
          ctx.shadowColor=getLRColor(b*0.5); ctx.shadowBlur=18;
          ctx.beginPath(); ctx.moveTo(0,0);
          let lx=0,ly=0;
          for(let s=1;s<=7;s++){
            const d=(180+Math.random()*80)/7*s;
            const j=(Math.random()-0.5)*40;
            lx=Math.cos(baseA)*d+Math.cos(baseA+Math.PI/2)*j;
            ly=Math.sin(baseA)*d+Math.sin(baseA+Math.PI/2)*j;
            ctx.lineTo(lx,ly);
          }
          ctx.stroke(); ctx.shadowBlur=0;
        }
        ctx.restore();

        // "???" 大文字レインボー
        ctx.globalAlpha=fastFlick?1.0:0.5;
        ctx.shadowColor=getLRColor(frameCount*0.1); ctx.shadowBlur=80;
        ctx.fillStyle='#fff'; ctx.font='bold 90px Orbitron,Courier New'; ctx.textAlign='center';
        ctx.fillText('???',cx,cy+32); ctx.shadowBlur=0; ctx.globalAlpha=1;

        // "LEGEND !!" テキスト
        ctx.globalAlpha=Math.min(1,stallProg*2.5)*(flicker?1:0.6);
        const lc=getLRColor(frameCount*0.08);
        ctx.shadowColor=lc; ctx.shadowBlur=60;
        ctx.fillStyle=lc; ctx.font='bold 32px Orbitron,Courier New';
        ctx.fillText('★★  LEGEND  !!  ★★',cx,cy-130);
        ctx.shadowBlur=0; ctx.globalAlpha=1;

        // レインボーコーナーフレーム
        if(fastFlick){
          for(let i=0;i<4;i++){
            ctx.strokeStyle=getLRColor(i*1.5+frameCount*0.05);
            ctx.lineWidth=6-i; ctx.shadowColor=ctx.strokeStyle; ctx.shadowBlur=20;
            ctx.strokeRect(3+i*4,3+i*4,W-6-i*8,H-6-i*8);
            ctx.shadowBlur=0;
          }
        }

        // レインボースピードライン
        ctx.globalAlpha=0.18+Math.sin(f*0.3)*0.08;
        for(let i=0;i<36;i++){
          const a=(Math.PI*2/36)*i;
          ctx.strokeStyle=getLRColor(i*0.17);
          ctx.lineWidth=1;
          ctx.beginPath();
          ctx.moveTo(cx+Math.cos(a)*320,cy+Math.sin(a)*320);
          ctx.lineTo(cx+Math.cos(a)*180,cy+Math.sin(a)*180);
          ctx.stroke();
        }
        ctx.globalAlpha=1;

      } else if(isSSR){
        // 金色パルス全画面
        ctx.globalAlpha=Math.abs(Math.sin(f*0.15))*0.28;
        ctx.fillStyle='#ffcc00'; ctx.fillRect(0,0,W,H);
        ctx.globalAlpha=1;

        // ライトニングボルト放射
        ctx.save(); ctx.translate(cx,cy);
        for(let b=0;b<8;b++){
          if((b+Math.floor(f/4))%3!==0) continue;
          const baseA=(Math.PI*2/8)*b+f*0.02;
          ctx.strokeStyle=`rgba(255,255,120,${0.3+Math.random()*0.5})`;
          ctx.lineWidth=1+Math.random()*1.5;
          ctx.shadowColor='#ffee00'; ctx.shadowBlur=12;
          ctx.beginPath(); ctx.moveTo(0,0);
          let lx=0,ly=0;
          for(let s=1;s<=6;s++){
            const d=(160+Math.random()*70)/6*s;
            const j=(Math.random()-0.5)*35;
            lx=Math.cos(baseA)*d+Math.cos(baseA+Math.PI/2)*j;
            ly=Math.sin(baseA)*d+Math.sin(baseA+Math.PI/2)*j;
            ctx.lineTo(lx,ly);
          }
          ctx.stroke(); ctx.shadowBlur=0;
        }
        ctx.restore();

        // "???" 大文字
        ctx.globalAlpha=fastFlick?1.0:0.5;
        ctx.shadowColor='#ffdd00'; ctx.shadowBlur=60;
        ctx.fillStyle='#fff'; ctx.font='bold 80px Orbitron,Courier New'; ctx.textAlign='center';
        ctx.fillText('???',cx,cy+28); ctx.shadowBlur=0; ctx.globalAlpha=1;

        // "LEGENDARY !!" テキスト
        ctx.globalAlpha=Math.min(1,stallProg*3)*(flicker?1:0.7);
        ctx.shadowColor='#ffdd00'; ctx.shadowBlur=40;
        ctx.fillStyle='#ffee44'; ctx.font='bold 28px Orbitron,Courier New';
        ctx.fillText('★  LEGENDARY  !!  ★',cx,cy-115);
        ctx.shadowBlur=0; ctx.globalAlpha=1;

        // コーナーフラッシュ枠
        if(fastFlick){
          ctx.strokeStyle='#ffdd00'; ctx.lineWidth=8;
          ctx.shadowColor='#ffdd00'; ctx.shadowBlur=30;
          ctx.strokeRect(4,4,W-8,H-8);
          ctx.lineWidth=2; ctx.strokeRect(16,16,W-32,H-32);
          ctx.shadowBlur=0;
        }

        // 収束スピードライン
        ctx.globalAlpha=0.22+Math.sin(f*0.3)*0.08;
        ctx.strokeStyle='#ffdd00'; ctx.lineWidth=1;
        for(let i=0;i<28;i++){
          const a=(Math.PI*2/28)*i;
          ctx.beginPath();
          ctx.moveTo(cx+Math.cos(a)*300,cy+Math.sin(a)*300);
          ctx.lineTo(cx+Math.cos(a)*170,cy+Math.sin(a)*170);
          ctx.stroke();
        }
        ctx.globalAlpha=1;

      } else if(isSR){
        ctx.globalAlpha=flicker?0.9:0.45;
        ctx.shadowColor=rc; ctx.shadowBlur=35;
        ctx.fillStyle='#fff'; ctx.font='bold 58px Orbitron,Courier New'; ctx.textAlign='center';
        ctx.fillText('???',cx,cy+10); ctx.shadowBlur=0; ctx.globalAlpha=1;

        ctx.globalAlpha=Math.min(1,stallProg*3)*(flicker?1:0.65);
        ctx.shadowColor=rc; ctx.shadowBlur=30;
        ctx.fillStyle=rc; ctx.font='bold 22px Orbitron,Courier New';
        ctx.fillText('⚡  EPIC  !  ⚡',cx,cy-90);
        ctx.shadowBlur=0; ctx.globalAlpha=1;

        if(flicker){
          ctx.strokeStyle=rc; ctx.lineWidth=5;
          ctx.shadowColor=rc; ctx.shadowBlur=22;
          ctx.strokeRect(3,3,W-6,H-6); ctx.shadowBlur=0;
        }
        ctx.globalAlpha=0.16;
        ctx.strokeStyle=rc; ctx.lineWidth=1;
        for(let i=0;i<18;i++){
          const lx=(i/18)*W;
          ctx.beginPath(); ctx.moveTo(lx,0); ctx.lineTo(lx+60,H); ctx.stroke();
        }
        ctx.globalAlpha=1;

      } else {
        ctx.globalAlpha=flicker?0.85:0.4;
        ctx.shadowColor=rc; ctx.shadowBlur=22;
        ctx.fillStyle='#fff'; ctx.font='bold 42px Orbitron,Courier New'; ctx.textAlign='center';
        ctx.fillText('???',cx,cy+10); ctx.shadowBlur=0; ctx.globalAlpha=1;
      }
    }
  }

  // ===== フェーズ2: ワープアウト =====
  const warpStart=GATE_OPEN+stall;
  if(f>warpStart && f<=warpStart+GATE_WARPOUT){
    const wp=(f-warpStart)/GATE_WARPOUT;
    const gateR=(isSSR?200:isSR?170:130)*(1-wp*0.7);
    ctx.save(); ctx.translate(cx,cy);
    ctx.strokeStyle=rc; ctx.lineWidth=3*(1-wp);
    ctx.shadowColor=rc; ctx.shadowBlur=22*(1-wp);
    ctx.globalAlpha=1-wp*0.8;
    ctx.beginPath(); ctx.arc(0,0,gateR,0,Math.PI*2); ctx.stroke();
    ctx.restore();

    // 衝撃波リング
    if(wp>0.25){
      const sp=(wp-0.25)/0.75;
      const shockR=sp*280;
      ctx.strokeStyle=rc; ctx.lineWidth=Math.max(0.5,3*(1-sp));
      ctx.globalAlpha=(1-sp)*0.85;
      ctx.shadowColor=rc; ctx.shadowBlur=12;
      ctx.beginPath(); ctx.arc(cx,cy,shockR,0,Math.PI*2); ctx.stroke();
      if(sp>0.35){
        const sp2=(sp-0.35)/0.65;
        ctx.strokeStyle='#fff'; ctx.lineWidth=Math.max(0.5,2*(1-sp2));
        ctx.globalAlpha=(1-sp2)*0.5;
        ctx.beginPath(); ctx.arc(cx,cy,sp2*220,0,Math.PI*2); ctx.stroke();
      }
      ctx.shadowBlur=0; ctx.globalAlpha=1;
    }

    const itemScale=wp*wp*1.6;
    ctx.save(); ctx.translate(cx,cy); ctx.scale(itemScale,itemScale);
    ctx.shadowColor=rc; ctx.shadowBlur=45*wp;
    ctx.fillStyle=rc; ctx.globalAlpha=wp;
    ctx.beginPath(); ctx.moveTo(0,-22); ctx.lineTo(16,13); ctx.lineTo(0,8); ctx.lineTo(-16,13); ctx.closePath(); ctx.fill();
    ctx.shadowBlur=0; ctx.restore();

    if(wp>0.55){
      ctx.globalAlpha=(wp-0.55)/0.45*(isLR?1.0:isSSR?0.9:0.65);
      ctx.fillStyle=isLR?getLRColor(frameCount*0.08):isSSR?'#ffcc00':rc; ctx.fillRect(0,0,W,H);
      ctx.globalAlpha=1;
    }
  }

  // ===== フェーズ3: リベール =====
  const revealStart=warpStart+GATE_WARPOUT;
  if(f>revealStart){
    const rp=Math.min(1,(f-revealStart)/GATE_FADEIN);
    const rAge=f-revealStart;

    const glowR=isLR?500:isSSR?420:isSR?330:270;
    const bg=ctx.createRadialGradient(cx,cy,0,cx,cy,glowR);
    bg.addColorStop(0,RARITY_COLORS[item.rarity]+(isLR?'66':isSSR?'55':isSR?'3a':'28')); bg.addColorStop(1,'transparent');
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

    // LR: レインボーキラキラ
    if(isLR){
      for(let i=0;i<24;i++){
        const a=frameCount*0.05+i*(Math.PI*2/24);
        const r2=110+Math.sin(frameCount*0.08+i*1.2)*55;
        const px=cx+Math.cos(a)*r2, py=cy+Math.sin(a)*r2-20;
        ctx.globalAlpha=rp*(0.5+Math.sin(frameCount*0.12+i)*0.3);
        ctx.fillStyle=getLRColor(i*0.25+frameCount*0.04);
        ctx.shadowColor=ctx.fillStyle; ctx.shadowBlur=14;
        ctx.beginPath(); ctx.arc(px,py,3,0,Math.PI*2); ctx.fill();
        ctx.shadowBlur=0;
      }
      ctx.globalAlpha=1;
    }

    // SSR背景キラキラ
    if(isSSR){
      for(let i=0;i<14;i++){
        const a=frameCount*0.04+i*(Math.PI*2/14);
        const r=95+Math.sin(frameCount*0.07+i*1.3)*45;
        const px=cx+Math.cos(a)*r, py=cy+Math.sin(a)*r-20;
        ctx.globalAlpha=rp*(0.4+Math.sin(frameCount*0.1+i)*0.3);
        ctx.fillStyle='#ffee88'; ctx.shadowColor='#ffdd00'; ctx.shadowBlur=10;
        ctx.beginPath(); ctx.arc(px,py,2.5,0,Math.PI*2); ctx.fill(); ctx.shadowBlur=0;
      }
      ctx.globalAlpha=1;
    }

    ctx.globalAlpha=rp;
    const cw=340, ch=372, cxl=cx-cw/2, cyl=cy-ch/2-12;

    // SSR 外枠ゴールドグロー
    if(isSSR){
      ctx.shadowColor='#ffdd00'; ctx.shadowBlur=55;
      ctx.strokeStyle='#ffaa00'; ctx.lineWidth=4;
      ctx.beginPath(); ctx.roundRect(cxl-4,cyl-4,cw+8,ch+8,20); ctx.stroke(); ctx.shadowBlur=0;
    }

    ctx.shadowColor=rc; ctx.shadowBlur=isSSR?44:26;
    ctx.fillStyle='rgba(5,4,18,0.98)'; ctx.strokeStyle=rc; ctx.lineWidth=isSSR?3:2.5;
    ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,ch,16); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;

    // SSR 斜めゴールドストライプ
    if(isSSR){
      ctx.save();
      ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,ch,16); ctx.clip();
      ctx.globalAlpha=rp*0.11;
      ctx.fillStyle='#ffdd00';
      for(let s=0;s<4;s++){
        const sx=cxl-60+s*110;
        ctx.beginPath();
        ctx.moveTo(sx,cyl); ctx.lineTo(sx+60,cyl);
        ctx.lineTo(sx+60+ch*0.45,cyl+ch); ctx.lineTo(sx+ch*0.45,cyl+ch);
        ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha=rp; ctx.restore();
    }

    // LR: 外枠レインボーグロー
    if(isLR){
      for(let i=0;i<6;i++){
        ctx.strokeStyle=getLRColor(i*1.0+frameCount*0.06);
        ctx.lineWidth=3-i*0.3; ctx.shadowColor=ctx.strokeStyle; ctx.shadowBlur=30;
        ctx.globalAlpha=rp*(0.7-i*0.1);
        ctx.beginPath(); ctx.roundRect(cxl-4-i*3,cyl-4-i*3,cw+8+i*6,ch+8+i*6,22); ctx.stroke();
        ctx.shadowBlur=0;
      }
      ctx.globalAlpha=rp;
    }

    // SSR 外枠ゴールドグロー
    if(isSSR){
      ctx.shadowColor='#ffdd00'; ctx.shadowBlur=55;
      ctx.strokeStyle='#ffaa00'; ctx.lineWidth=4;
      ctx.beginPath(); ctx.roundRect(cxl-4,cyl-4,cw+8,ch+8,20); ctx.stroke(); ctx.shadowBlur=0;
    }

    ctx.shadowColor=isLR?getLRColor(frameCount*0.06):rc; ctx.shadowBlur=isLR?50:isSSR?44:26;
    ctx.fillStyle='rgba(5,4,18,0.98)'; ctx.strokeStyle=isLR?getLRColor(frameCount*0.06):rc; ctx.lineWidth=isLR?4:isSSR?3:2.5;
    ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,ch,16); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;

    // LR レインボーストライプ
    if(isLR){
      ctx.save();
      ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,ch,16); ctx.clip();
      for(let s=0;s<6;s++){
        ctx.globalAlpha=rp*0.07;
        ctx.fillStyle=getLRColor(s+frameCount*0.02);
        const sx=cxl-60+s*90;
        ctx.beginPath();
        ctx.moveTo(sx,cyl); ctx.lineTo(sx+50,cyl);
        ctx.lineTo(sx+50+ch*0.45,cyl+ch); ctx.lineTo(sx+ch*0.45,cyl+ch);
        ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha=rp; ctx.restore();
    }

    // SSR 斜めゴールドストライプ
    if(isSSR){
      ctx.save();
      ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,ch,16); ctx.clip();
      ctx.globalAlpha=rp*0.11;
      ctx.fillStyle='#ffdd00';
      for(let s=0;s<4;s++){
        const sx=cxl-60+s*110;
        ctx.beginPath();
        ctx.moveTo(sx,cyl); ctx.lineTo(sx+60,cyl);
        ctx.lineTo(sx+60+ch*0.45,cyl+ch); ctx.lineTo(sx+ch*0.45,cyl+ch);
        ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha=rp; ctx.restore();
    }

    // レアリティバナー
    if(isLR){
      const banG=ctx.createLinearGradient(cxl,cyl,cxl+cw,cyl+58);
      LR_RAINBOW.forEach((c,i)=>banG.addColorStop(i/6,c));
      ctx.fillStyle=banG;
    } else if(isSSR){
      const banG=ctx.createLinearGradient(cxl,cyl,cxl+cw,cyl+58);
      banG.addColorStop(0,'#996600'); banG.addColorStop(0.5,'#ffdd00'); banG.addColorStop(1,'#996600');
      ctx.fillStyle=banG;
    } else { ctx.fillStyle=rc; }
    ctx.beginPath(); ctx.roundRect(cxl,cyl,cw,58,{upperLeft:16,upperRight:16,lowerLeft:0,lowerRight:0}); ctx.fill();
    ctx.fillStyle='#000'; ctx.font=`bold ${isLR?36:isSSR?32:26}px Orbitron,Courier New`; ctx.textAlign='center';
    ctx.fillText(item.rarity,cx,cyl+42);

    // LR / LEGENDARY / EPIC コールアウト（カード上）
    if(isLR){
      ctx.globalAlpha=rp*(0.7+Math.sin(frameCount*0.25)*0.3);
      const lc=getLRColor(frameCount*0.07);
      ctx.shadowColor=lc; ctx.shadowBlur=55;
      ctx.fillStyle='#fff'; ctx.font='bold 24px Orbitron,Courier New';
      ctx.fillText('★★  LEGEND  !!  ★★',cx,cyl-30);
      ctx.shadowBlur=0;
    } else if(isSSR){
      ctx.globalAlpha=rp*(0.7+Math.sin(frameCount*0.22)*0.3);
      ctx.shadowColor='#ffdd00'; ctx.shadowBlur=38;
      ctx.fillStyle='#ffee44'; ctx.font='bold 20px Orbitron,Courier New';
      ctx.fillText('★  LEGENDARY  !!  ★',cx,cyl-26);
      ctx.shadowBlur=0;
    } else if(isSR){
      ctx.globalAlpha=rp*(0.7+Math.sin(frameCount*0.2)*0.3);
      ctx.shadowColor=rc; ctx.shadowBlur=22;
      ctx.fillStyle=rc; ctx.font='bold 16px Orbitron,Courier New';
      ctx.fillText('⚡  EPIC  !  ⚡',cx,cyl-20);
      ctx.shadowBlur=0;
    }
    ctx.globalAlpha=rp;

    // NEWバッジ
    if(gachaNewItems.has(item.id)){
      ctx.shadowColor='#00ff66'; ctx.shadowBlur=16;
      ctx.fillStyle='#00ff66'; ctx.font='bold 13px Orbitron,Courier New';
      ctx.fillText('★  NEW  !',cx+126,cyl+22); ctx.shadowBlur=0;
    }

    // アイコン（大きく）
    ctx.save(); ctx.translate(cx,cyl+160);
    const iconS=isLR?2.0:isSSR?1.7:isSR?1.4:1.2;
    ctx.scale(iconS,iconS);
    ctx.shadowColor=isLR?getLRColor(frameCount*0.06):rc; ctx.shadowBlur=isLR?45:isSSR?32:22; ctx.globalAlpha=rp*0.95;
    drawGachaItemIcon(item);
    if(isLR){
      ctx.globalAlpha=rp*(0.35+Math.sin(frameCount*0.12)*0.2);
      for(let ri=0;ri<3;ri++){
        ctx.strokeStyle=getLRColor(ri*2+frameCount*0.06);
        ctx.lineWidth=(2-ri*0.5)/iconS;
        ctx.beginPath(); ctx.arc(0,0,(35+ri*12)/iconS,0,Math.PI*2); ctx.stroke();
      }
    }
    if(isSSR){
      ctx.globalAlpha=rp*(0.28+Math.sin(frameCount*0.1)*0.18);
      ctx.strokeStyle='#ffdd00'; ctx.lineWidth=1.5/iconS;
      ctx.beginPath(); ctx.arc(0,0,40/iconS,0,Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.arc(0,0,54/iconS,0,Math.PI*2); ctx.stroke();
    }
    ctx.shadowBlur=0; ctx.restore();
    ctx.globalAlpha=rp;

    ctx.fillStyle='#444'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(item.type.toUpperCase(),cx,cyl+220);

    ctx.shadowColor=rc; ctx.shadowBlur=isSSR?20:10;
    ctx.fillStyle='#fff'; ctx.font=`bold ${isSSR?24:20}px Orbitron,Courier New`;
    ctx.fillText(item.label,cx,cyl+252); ctx.shadowBlur=0;

    ctx.fillStyle='#aaa'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(item.desc,cx,cyl+274);

    const inv=gachaInventory[item.id];
    if(!gachaNewItems.has(item.id)&&inv){
      if(inv.level>=30){
        ctx.fillStyle='#ffd700'; ctx.font='bold 11px Orbitron,Courier New';
        ctx.fillText(`Lv.MAX  →  ✦ スターダスト +${{SSR:50,SR:20,R:10,N:5}[item.rarity]}`,cx,cyl+298);
      } else {
        ctx.fillStyle='#667'; ctx.font='10px Orbitron,Courier New';
        ctx.fillText(`重複  →  ${item.rarity} 素材 +1`,cx,cyl+298);
      }
    }

    // プログレスドット
    if(gachaResults.length>1){
      ctx.fillStyle='#444'; ctx.font='9px Orbitron,Courier New';
      ctx.fillText(`${gachaCurrentIdx+1}  /  ${gachaResults.length}`,cx,cyl+ch-10);
      gachaResults.forEach((r,i)=>{
        const dx=cx-gachaResults.length*9+i*18;
        ctx.fillStyle=i===gachaCurrentIdx?RARITY_COLORS[r.rarity]:i<gachaCurrentIdx?RARITY_COLORS[r.rarity]+'66':'#2a2a2a';
        ctx.beginPath(); ctx.arc(dx,cyl+ch+8,i===gachaCurrentIdx?6:4,0,Math.PI*2); ctx.fill();
      });
    }

    // 最後のカード: 再ガチャボタン
    const isLast=gachaCurrentIdx>=gachaResults.length-1;
    if(isLast){
      const btny=cyl+ch+22, btnw=155, btnh=36;
      const btn1x=cx-168, btn2x=cx+14;
      const can1=coins>=500;
      ctx.shadowColor=can1?'#ffd700':'transparent'; ctx.shadowBlur=can1?12:0;
      const bg1=ctx.createLinearGradient(btn1x,btny,btn1x+btnw,btny+btnh);
      bg1.addColorStop(0,can1?'rgba(120,88,0,0.97)':'rgba(28,28,28,0.9)');
      bg1.addColorStop(1,can1?'rgba(72,52,0,0.95)':'rgba(18,18,18,0.9)');
      ctx.fillStyle=bg1; ctx.strokeStyle=can1?'#ffd700':'#3a3a3a'; ctx.lineWidth=can1?2:1;
      ctx.beginPath(); ctx.roundRect(btn1x,btny,btnw,btnh,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      ctx.fillStyle=can1?'#ffe566':'#555'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText('[1]  SINGLE  500C',btn1x+btnw/2,btny+15);
      ctx.fillStyle=can1?'#aa8822':'#444'; ctx.font='9px Orbitron,Courier New';
      ctx.fillText('もう1回',btn1x+btnw/2,btny+29);

      const can10=coins>=5000;
      ctx.shadowColor=can10?'#cc88ff':'transparent'; ctx.shadowBlur=can10?12:0;
      const bg2=ctx.createLinearGradient(btn2x,btny,btn2x+btnw,btny+btnh);
      bg2.addColorStop(0,can10?'rgba(82,14,140,0.97)':'rgba(28,28,28,0.9)');
      bg2.addColorStop(1,can10?'rgba(50,8,88,0.95)':'rgba(18,18,18,0.9)');
      ctx.fillStyle=bg2; ctx.strokeStyle=can10?'#cc88ff':'#3a3a3a'; ctx.lineWidth=can10?2:1;
      ctx.beginPath(); ctx.roundRect(btn2x,btny,btnw,btnh,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      ctx.fillStyle=can10?'#dd99ff':'#555'; ctx.font='bold 11px Orbitron,Courier New';
      ctx.fillText('[2]  10×PULL  5000C',btn2x+btnw/2,btny+15);
      ctx.fillStyle=can10?'#9955bb':'#444'; ctx.font='9px Orbitron,Courier New';
      ctx.fillText('10連',btn2x+btnw/2,btny+29);
    } else {
      if(Math.sin(frameCount*0.14)>0){
        ctx.fillStyle='#445'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
        ctx.fillText('SPACE: 次へ',cx,cyl+ch+42);
      }
    }

    if(rAge<GATE_FADEIN*0.6 && Math.sin(frameCount*0.22)>0){
      ctx.fillStyle='#2a2a3a'; ctx.font='9px Orbitron,Courier New';
      const skipHint=gachaResults.length>=10?'SPACE×2: 全スキップ  /  SPACE: 次へ':'SPACE: スキップ';
      ctx.fillText(skipHint,cx,H-10);
    }
    ctx.globalAlpha=1;
  }

  ctx.textAlign='left'; ctx.lineWidth=1;
}

function drawGachaSummary(){
  ctx.fillStyle='rgba(0,0,0,0.97)'; ctx.fillRect(0,0,W,H);

  const hasSSR=gachaResults.some(r=>r.rarity==='SSR');

  // SSR全画面ゴールドエフェクト
  if(hasSSR){
    const pulse=0.5+Math.sin(frameCount*0.1)*0.5;
    const bgG=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,420);
    bgG.addColorStop(0,`rgba(85,65,0,${pulse*0.28})`); bgG.addColorStop(1,'transparent');
    ctx.fillStyle=bgG; ctx.fillRect(0,0,W,H);

    ctx.strokeStyle=`rgba(255,220,0,${pulse*0.65})`; ctx.lineWidth=5;
    ctx.shadowColor='#ffdd00'; ctx.shadowBlur=22;
    ctx.strokeRect(3,3,W-6,H-6);
    ctx.strokeStyle=`rgba(255,220,0,${pulse*0.3})`; ctx.lineWidth=2;
    ctx.strokeRect(12,12,W-24,H-24);
    ctx.shadowBlur=0; ctx.lineWidth=1;

    for(let i=0;i<10;i++){
      const a=frameCount*0.03+i*(Math.PI*2/10);
      const r=230+Math.sin(frameCount*0.07+i*1.3)*35;
      ctx.globalAlpha=0.45+Math.sin(frameCount*0.1+i)*0.3;
      ctx.fillStyle='#ffee88'; ctx.shadowColor='#ffdd00'; ctx.shadowBlur=8;
      ctx.beginPath(); ctx.arc(W/2+Math.cos(a)*r,H/2+Math.sin(a)*r,3,0,Math.PI*2); ctx.fill(); ctx.shadowBlur=0;
    }
    ctx.globalAlpha=1;
  }

  const hasLR=gachaResults.some(r=>r.rarity==='LR');
  // タイトル
  const titleCol=hasLR?getLRColor(frameCount*0.06):hasSSR?'#ffdd00':'#cc88ff';
  ctx.shadowColor=titleCol; ctx.shadowBlur=hasLR?50:hasSSR?35:20;
  ctx.fillStyle=titleCol;
  ctx.font=`bold ${hasLR||hasSSR?26:22}px Orbitron,Courier New`; ctx.textAlign='center';
  ctx.fillText(hasLR?'★★  LEGEND  OBTAINED  ★★':hasSSR?'★  SUMMON  RESULTS  ★':'SUMMON  RESULTS',W/2,36); ctx.shadowBlur=0;

  if(hasLR && Math.sin(frameCount*0.12)>0){
    ctx.fillStyle=`rgba(255,34,102,0.1)`; ctx.fillRect(0,42,W,18);
    ctx.fillStyle='#ff2266'; ctx.font='bold 9px Orbitron,Courier New';
    ctx.fillText('★★  LEGEND  !!  WORLD  FIRST  !!  ★★',W/2,55);
  } else if(hasSSR && Math.sin(frameCount*0.12)>0){
    ctx.fillStyle='rgba(255,220,0,0.08)'; ctx.fillRect(0,42,W,18);
    ctx.fillStyle='#aa8800'; ctx.font='bold 9px Orbitron,Courier New';
    ctx.fillText('LEGENDARY  OBTAINED  !!',W/2,55);
  }

  const cols=5, rows=2, cw=148, ch=114, gapX=5, gapY=6;
  const totalW=cols*cw+(cols-1)*gapX;
  const startX=(W-totalW)/2, startY=64;

  gachaResults.forEach((item,i)=>{
    const col=i%cols, row=Math.floor(i/cols);
    const x=startX+col*(cw+gapX);
    const isItemLR=item.rarity==='LR';
    const isItemSSR=item.rarity==='SSR';
    const rc=isItemLR?getLRColor(frameCount*0.05+i):RARITY_COLORS[item.rarity];
    const y=startY+row*(ch+gapY)+((isItemLR||isItemSSR)?Math.sin(frameCount*0.12+i)*2.5:0);
    const isNew=gachaNewItems.has(item.id);

    if(isItemLR){
      for(let ri=0;ri<3;ri++){
        ctx.shadowColor=getLRColor(ri+frameCount*0.04); ctx.shadowBlur=20-ri*5;
        ctx.strokeStyle=getLRColor(ri+frameCount*0.04); ctx.lineWidth=2.5-ri*0.5;
        ctx.fillStyle='rgba(18,4,12,0.98)';
        ctx.beginPath(); ctx.roundRect(x-ri*2,y-ri*2,cw+ri*4,ch+ri*4,8+ri*2); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      }
    } else if(isItemSSR){
      ctx.shadowColor='#ffdd00'; ctx.shadowBlur=22;
      ctx.strokeStyle='#aa7700'; ctx.lineWidth=2.5;
      ctx.fillStyle='rgba(12,10,24,0.98)';
      ctx.beginPath(); ctx.roundRect(x,y,cw,ch,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    } else {
      ctx.shadowColor=rc; ctx.shadowBlur=item.rarity==='SR'?10:5;
      ctx.strokeStyle=rc; ctx.lineWidth=item.rarity==='SR'?2:1.5;
      ctx.fillStyle='rgba(8,8,20,0.95)';
      ctx.beginPath(); ctx.roundRect(x,y,cw,ch,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    }

    // LRレインボーストライプ
    if(isItemLR){
      ctx.save();
      ctx.beginPath(); ctx.roundRect(x,y,cw,ch,8); ctx.clip();
      for(let s=0;s<5;s++){
        ctx.globalAlpha=0.07; ctx.fillStyle=getLRColor(s+frameCount*0.02);
        const sx=x-30+s*44;
        ctx.beginPath(); ctx.moveTo(sx,y); ctx.lineTo(sx+36,y); ctx.lineTo(sx+36+ch*0.5,y+ch); ctx.lineTo(sx+ch*0.5,y+ch); ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha=1; ctx.restore();
    }

    // SSR斜めストライプ
    if(isItemSSR){
      ctx.save();
      ctx.beginPath(); ctx.roundRect(x,y,cw,ch,8); ctx.clip();
      ctx.globalAlpha=0.09; ctx.fillStyle='#ffdd00';
      ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x+50,y); ctx.lineTo(x+50+ch*0.55,y+ch); ctx.lineTo(x+ch*0.55,y+ch); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.moveTo(x+82,y); ctx.lineTo(x+112,y); ctx.lineTo(x+112+ch*0.55,y+ch); ctx.lineTo(x+82+ch*0.55,y+ch); ctx.closePath(); ctx.fill();
      ctx.globalAlpha=1; ctx.restore();
    }

    // レアリティ帯
    if(isItemLR){
      const banG=ctx.createLinearGradient(x,y,x+cw,y+24);
      LR_RAINBOW.forEach((c,i2)=>banG.addColorStop(i2/6,c));
      ctx.fillStyle=banG;
    } else if(isItemSSR){
      const banG=ctx.createLinearGradient(x,y,x+cw,y+24);
      banG.addColorStop(0,'#886600'); banG.addColorStop(0.5,'#ffdd00'); banG.addColorStop(1,'#886600');
      ctx.fillStyle=banG;
    } else { ctx.fillStyle=RARITY_COLORS[item.rarity]; }
    ctx.beginPath(); ctx.roundRect(x,y,cw,24,{upperLeft:8,upperRight:8,lowerLeft:0,lowerRight:0}); ctx.fill();
    ctx.fillStyle='#000'; ctx.font='bold 11px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(item.rarity,x+cw/2,y+16);

    if(isNew){
      ctx.fillStyle='#00ff66'; ctx.shadowColor='#00ff66'; ctx.shadowBlur=8;
      ctx.font='bold 9px Orbitron,Courier New';
      ctx.fillText('★NEW',x+cw-22,y+15); ctx.shadowBlur=0;
    }

    // アイコン
    ctx.save(); ctx.translate(x+cw/2,y+60);
    const iconS=isItemLR?1.4:isItemSSR?1.2:item.rarity==='SR'?1.0:0.85;
    ctx.scale(iconS,iconS);
    ctx.shadowColor=isItemLR?getLRColor(frameCount*0.06):rc; ctx.shadowBlur=isItemLR?24:isItemSSR?16:8;
    drawGachaItemIcon(item);
    ctx.shadowBlur=0; ctx.restore();

    ctx.shadowColor=rc; ctx.shadowBlur=isNew?10:isItemSSR?8:0;
    ctx.fillStyle='#fff'; ctx.font=`bold ${item.label.length>10?9:11}px Orbitron,Courier New`;
    ctx.fillText(item.label,x+cw/2,y+88); ctx.shadowBlur=0;

    ctx.fillStyle='#445'; ctx.font='8px Orbitron,Courier New';
    ctx.fillText(item.type.toUpperCase(),x+cw/2,y+100);

    const inv=gachaInventory[item.id];
    if(!isNew&&inv){
      ctx.fillStyle=inv.level>=30?'#ffd700':'#445'; ctx.font='7px Orbitron,Courier New';
      ctx.fillText(inv.level>=30?'MAX→DUST':'重複',x+cw/2,y+111);
    }

    // SSR軌道パーティクル
    if(isItemSSR){
      for(let p=0;p<5;p++){
        const pa=frameCount*0.10+p*(Math.PI*2/5), pr=22+Math.sin(frameCount*0.07+p)*5;
        ctx.globalAlpha=0.85; ctx.fillStyle='#ffd700';
        ctx.shadowColor='#ffaa00'; ctx.shadowBlur=6;
        ctx.beginPath(); ctx.arc(x+cw/2+Math.cos(pa)*pr,y+ch/2+Math.sin(pa)*pr,2.5,0,Math.PI*2); ctx.fill();
        ctx.shadowBlur=0; ctx.globalAlpha=1;
      }
    }
  });

  // 再ガチャボタン（目立つ）
  const boty=startY+rows*ch+(rows-1)*gapY+16;
  const btn1x=W/2-318, btn2x=W/2+10, btnw=304, btnh=44;

  const can1=coins>=500;
  ctx.shadowColor=can1?'#ffd700':'transparent'; ctx.shadowBlur=can1?18:0;
  const bg1=ctx.createLinearGradient(btn1x,boty,btn1x+btnw,boty+btnh);
  bg1.addColorStop(0,can1?'rgba(140,100,0,0.97)':'rgba(30,30,30,0.9)');
  bg1.addColorStop(1,can1?'rgba(82,58,0,0.95)':'rgba(20,20,20,0.9)');
  ctx.fillStyle=bg1; ctx.strokeStyle=can1?'#ffd700':'#444'; ctx.lineWidth=can1?2.5:1;
  ctx.beginPath(); ctx.roundRect(btn1x,boty,btnw,btnh,10); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
  ctx.fillStyle=can1?'#ffe566':'#666'; ctx.font='bold 14px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('[1]  SINGLE  500C',btn1x+btnw/2,boty+18);
  ctx.fillStyle=can1?'#aa8822':'#444'; ctx.font='10px Orbitron,Courier New';
  ctx.fillText('もう1回',btn1x+btnw/2,boty+35);

  const can10=coins>=5000;
  ctx.shadowColor=can10?'#cc88ff':'transparent'; ctx.shadowBlur=can10?18:0;
  const bg2=ctx.createLinearGradient(btn2x,boty,btn2x+btnw,boty+btnh);
  bg2.addColorStop(0,can10?'rgba(90,16,150,0.97)':'rgba(30,30,30,0.9)');
  bg2.addColorStop(1,can10?'rgba(55,9,90,0.95)':'rgba(20,20,20,0.9)');
  ctx.fillStyle=bg2; ctx.strokeStyle=can10?'#cc88ff':'#444'; ctx.lineWidth=can10?2.5:1;
  ctx.beginPath(); ctx.roundRect(btn2x,boty,btnw,btnh,10); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
  ctx.fillStyle=can10?'#dd99ff':'#666'; ctx.font='bold 14px Orbitron,Courier New';
  ctx.fillText('[2]  10×PULL  5000C',btn2x+btnw/2,boty+18);
  ctx.fillStyle=can10?'#9955bb':'#444'; ctx.font='10px Orbitron,Courier New';
  ctx.fillText('10連',btn2x+btnw/2,boty+35);

  if(Math.sin(frameCount*0.1)>0){
    ctx.fillStyle='#333'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('ENTER / ESC  :  ガチャに戻る',W/2,H-8);
  }
  ctx.textAlign='left'; ctx.lineWidth=1;
}

function drawGachaRates(){
  ctx.fillStyle='rgba(0,0,0,0.97)'; ctx.fillRect(0,0,W,H);
  ctx.shadowColor='#cc88ff'; ctx.shadowBlur=20;
  ctx.fillStyle='#cc88ff'; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('排出率 / アイテム詳細',W/2,34); ctx.shadowBlur=0;

  [{r:'SSR',v:'5%'},{r:'SR',v:'15%'},{r:'R',v:'30%'},{r:'N',v:'50%'}].forEach((rt,i)=>{
    const rx=36+i*183,ry=50;
    ctx.fillStyle='rgba(15,15,25,0.8)'; ctx.strokeStyle=RARITY_COLORS[rt.r]; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(rx,ry,173,34,6); ctx.fill(); ctx.stroke();
    ctx.fillStyle=RARITY_COLORS[rt.r]; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`${rt.r}  ${rt.v}`,rx+86,ry+22);
  });
  ctx.fillStyle='#444'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('※ 10連はSR以上1枚確定',W/2,100);

  const sorted=[...ALL_GACHA_POOL].sort((a,b)=>['SSR','SR','R','N'].indexOf(a.rarity)-['SSR','SR','R','N'].indexOf(b.rarity));
  const ih=30, listStartY=108, listEndY=570;
  const half=Math.ceil(sorted.length/2);
  const visibleRows=Math.floor((listEndY-listStartY)/ih);
  const maxScroll=Math.max(0,half-visibleRows);
  gachaRatesScroll=Math.min(gachaRatesScroll,maxScroll);
  ctx.save(); ctx.beginPath(); ctx.rect(0,listStartY,W,listEndY-listStartY); ctx.clip();
  sorted.forEach((item,i)=>{
    const isLeft=i<half;
    const row=isLeft?i:i-half;
    const scrolledRow=row-gachaRatesScroll;
    if(scrolledRow<0||scrolledRow>=visibleRows) return;
    const x=isLeft?10:410, y=listStartY+scrolledRow*ih, iw=390;
    const owned=!!gachaInventory[item.id];
    ctx.fillStyle=owned?'rgba(18,18,36,0.9)':'rgba(8,8,12,0.7)';
    ctx.strokeStyle=owned?RARITY_COLORS[item.rarity]:'#1e1e1e'; ctx.lineWidth=owned?1.5:1;
    ctx.beginPath(); ctx.roundRect(x,y,iw,ih-3,4); ctx.fill(); ctx.stroke();
    ctx.shadowColor=owned?RARITY_COLORS[item.rarity]:'transparent'; ctx.shadowBlur=owned?4:0;
    ctx.fillStyle=RARITY_COLORS[item.rarity]; ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(`[${item.rarity}][${item.type}] ${item.label}`,x+7,y+13); ctx.shadowBlur=0;
    ctx.fillStyle='#555'; ctx.font='8px Orbitron,Courier New';
    ctx.fillText(item.desc,x+7,y+24);
    if(owned){
      const ent=gachaInventory[item.id];
      ctx.fillStyle='#0f0'; ctx.textAlign='right';
      ctx.fillText(`Lv.${ent.level}`,x+iw-6,y+13);
    }
    ctx.textAlign='left';
  });
  ctx.restore();
  if(maxScroll>0){
    ctx.fillStyle='#333'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`↑↓ スクロール  ${gachaRatesScroll+1}/${maxScroll+1}`,W/2,575);
  }
  ctx.fillStyle='#333'; ctx.font='9px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('ESC: 戻る',W/2,590);
  ctx.textAlign='left'; ctx.lineWidth=1;
}

const STARDUST_SHOP_ITEMS=[
  {label:'コイン  +1000',desc:'スターダストをコインに変換',cost:100,color:'#ffd700',action:()=>{coins+=1000;saveCoins();}},
  {label:'コイン  +5000',desc:'まとめて大量変換 お得版',cost:300,color:'#ffd700',action:()=>{coins+=5000;saveCoins();}},
  {label:'SR 確定 単発ガチャ',desc:'SR以上が1枚確定で入手できる',cost:500,color:'#cc88ff',action:()=>{
    gachaResults=[]; gachaNewItems=new Set();
    const item=gachaRollOne(true,false);
    gachaResults.push(item); addGachaItem(item);
    gachaCurrentIdx=0; gachaAnimFrame=0;
    state='gacha_result';
    if(item.rarity==='SSR') playSound('boss_die'); else playSound('powerup');
  }},
];
function applyStardustShop(idx){
  const item=STARDUST_SHOP_ITEMS[idx];
  if(gachaStardust<item.cost) return;
  gachaStardust-=item.cost;
  localStorage.setItem('invader_stardust',gachaStardust);
  item.action();
}
function drawStardustShop(){
  ctx.fillStyle='rgba(0,0,0,0.96)'; ctx.fillRect(0,0,W,H);
  // 背景グロー
  const bg=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,300);
  bg.addColorStop(0,'rgba(80,40,120,0.18)'); bg.addColorStop(1,'transparent');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

  ctx.shadowColor='#ffd700'; ctx.shadowBlur=30;
  ctx.fillStyle='#ffd700'; ctx.font='bold 26px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('✦  STARDUST  SHOP  ✦',W/2,46); ctx.shadowBlur=0;

  // 所持スターダスト
  const dustPulse=0.85+Math.sin(frameCount*0.12)*0.15;
  ctx.shadowColor='#ffd700'; ctx.shadowBlur=16*dustPulse;
  ctx.fillStyle='#ffd700'; ctx.font='bold 22px Orbitron,Courier New';
  ctx.fillText(`✦ ${gachaStardust}  dust`,W/2,82); ctx.shadowBlur=0;
  ctx.fillStyle='#555'; ctx.font='11px Orbitron,Courier New';
  ctx.fillText('ガチャの重複で獲得 / 上限MAX時に変換',W/2,102);

  const itemH=110, startY=124, itemW=600, startX=(W-itemW)/2;
  STARDUST_SHOP_ITEMS.forEach((item,i)=>{
    const y=startY+i*(itemH+10);
    const active=stardustShopCursor===i;
    const canAfford=gachaStardust>=item.cost;
    const col=canAfford?item.color:'#333';

    ctx.shadowColor=active&&canAfford?col:'transparent'; ctx.shadowBlur=active?20:0;
    const bg2=ctx.createLinearGradient(startX,y,startX+itemW,y+itemH);
    bg2.addColorStop(0,active&&canAfford?`rgba(${item.color==='#ffd700'?'80,60,0':'60,10,100'},0.95)`:'rgba(15,15,25,0.9)');
    bg2.addColorStop(1,active&&canAfford?`rgba(${item.color==='#ffd700'?'50,38,0':'40,6,70'},0.9)`:'rgba(10,10,20,0.9)');
    ctx.fillStyle=bg2; ctx.strokeStyle=active&&canAfford?col:'#2a2a2a'; ctx.lineWidth=active?2:1;
    ctx.beginPath(); ctx.roundRect(startX,y,itemW,itemH,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;

    // コストバッジ
    const costCol=canAfford?item.color:'#444';
    ctx.fillStyle=canAfford?`rgba(${item.color==='#ffd700'?'100,75,0':'70,12,120'},0.9)`:'rgba(30,30,30,0.9)';
    ctx.strokeStyle=costCol; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(startX+itemW-130,y+10,120,36,8); ctx.fill(); ctx.stroke();
    ctx.fillStyle=costCol; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`✦ ${item.cost}`,startX+itemW-70,y+33);
    ctx.fillStyle=canAfford?'#888':'#444'; ctx.font='9px Orbitron,Courier New';
    ctx.fillText('dust',startX+itemW-70,y+50);

    // アイテム名・説明
    ctx.textAlign='left';
    ctx.shadowColor=active&&canAfford?col:'transparent'; ctx.shadowBlur=active?8:0;
    ctx.fillStyle=canAfford?(active?col:'#aaa'):'#444'; ctx.font=`bold ${active?18:16}px Orbitron,Courier New`;
    ctx.fillText(item.label,startX+20,y+40); ctx.shadowBlur=0;
    ctx.fillStyle=canAfford?'#778':'#333'; ctx.font='12px Orbitron,Courier New';
    ctx.fillText(item.desc,startX+20,y+62);
    if(!canAfford){
      ctx.fillStyle='#664'; ctx.font='11px Orbitron,Courier New';
      ctx.fillText(`あと ${item.cost-gachaStardust} dust 不足`,startX+20,y+84);
    }

    // 選択中カーソル
    if(active){
      ctx.fillStyle=col; ctx.font='bold 20px Orbitron,Courier New'; ctx.textAlign='right';
      ctx.fillText('▶',startX+itemW-140,y+54);
    }
  });

  if(Math.sin(frameCount*0.1)>0){
    ctx.fillStyle='#333'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('↑↓ 選択  ENTER: 購入 / 戻る  ESC: 戻る',W/2,H-14);
  }
  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== ステージリザルト画面 =====
function drawStageResult(){
  if(!stageResultData) return;
  const d=stageResultData;
  stageResultTimer++;
  const cx=W/2, cy=H/2;

  ctx.fillStyle='rgba(0,0,0,0.92)'; ctx.fillRect(0,0,W,H);

  // Background glow
  const rankColors={S:'#ffdd00',A:'#ff8844',B:'#44aaff',C:'#aaaaaa'};
  const rc=rankColors[d.rank]||'#aaa';
  ctx.save(); ctx.globalAlpha=0.08;
  ctx.fillStyle=rc;
  ctx.beginPath(); ctx.arc(cx,cy-40,220,0,Math.PI*2); ctx.fill();
  ctx.restore();

  // Title
  const titleAlpha=Math.min(1,stageResultTimer/20);
  ctx.save(); ctx.globalAlpha=titleAlpha;
  ctx.fillStyle='#7fff7f'; ctx.font='bold 14px Orbitron,Courier New';
  ctx.textAlign='center'; ctx.shadowColor='#0f0'; ctx.shadowBlur=10;
  ctx.fillText(`STAGE ${d.stage} COMPLETE`,cx,cy-170);
  ctx.shadowBlur=0; ctx.restore();

  // Rank display
  const rankAlpha=Math.min(1,Math.max(0,(stageResultTimer-15)/20));
  const rankScale=rankAlpha<1?0.5+rankAlpha*0.5:1+Math.sin(Math.max(0,stageResultTimer-35)*0.3)*0.04;
  ctx.save(); ctx.globalAlpha=rankAlpha;
  ctx.translate(cx,cy-60); ctx.scale(rankScale,rankScale);
  ctx.fillStyle=rc; ctx.font='bold 100px Orbitron,Courier New';
  ctx.textAlign='center'; ctx.shadowColor=rc; ctx.shadowBlur=30;
  ctx.fillText(d.rank,0,36);
  ctx.shadowBlur=0; ctx.restore();

  // Stats rows
  const stats=[
    {l:'KILLS',  v:d.kills,    c:'#00ff88'},
    {l:'DAMAGE TAKEN',v:d.hits, c:d.hits===0?'#ffdd00':'#ff8888'},
    {l:'MAX COMBO',v:d.maxCombo,c:'#44ddff'},
    {l:'RANK BONUS',v:`+${d.rankBonus} COINS`,c:rc},
  ];
  stats.forEach((s,i)=>{
    const rowAlpha=Math.min(1,Math.max(0,(stageResultTimer-30-i*8)/15));
    const bx=cx-160, by=cy+40+i*44;
    ctx.save(); ctx.globalAlpha=rowAlpha;
    ctx.fillStyle='#111'; ctx.beginPath(); ctx.roundRect(bx,by-22,320,36,6); ctx.fill();
    ctx.strokeStyle='#1a2a1a'; ctx.lineWidth=1; ctx.beginPath(); ctx.roundRect(bx,by-22,320,36,6); ctx.stroke();
    ctx.fillStyle='#556'; ctx.font='11px Orbitron,Courier New'; ctx.textAlign='left';
    ctx.fillText(s.l,bx+14,by-4);
    ctx.fillStyle=s.c; ctx.shadowColor=s.c; ctx.shadowBlur=6;
    ctx.font='bold 14px Orbitron,Courier New'; ctx.textAlign='right';
    ctx.fillText(s.v,bx+306,by-4); ctx.shadowBlur=0;
    ctx.restore();
  });

  // 2択ボタン
  if(stageResultTimer>60){
    const pulse=0.7+Math.sin(stageResultTimer*0.08)*0.3;
    const bw=220, bh=40, gap=16;
    const b1x=cx-bw-gap/2, b2x=cx+gap/2, by=cy+210;

    // NEXT STAGE
    ctx.save(); ctx.globalAlpha=pulse;
    ctx.fillStyle='rgba(0,40,80,0.9)'; ctx.strokeStyle='#0cf'; ctx.lineWidth=2;
    ctx.shadowColor='#0cf'; ctx.shadowBlur=12;
    ctx.beginPath(); ctx.roundRect(b1x,by,bw,bh,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle='#0cf'; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('ENTER  NEXT STAGE',b1x+bw/2,by+26);
    ctx.restore();

    // STAGE SELECT
    ctx.save(); ctx.globalAlpha=pulse*0.85;
    ctx.fillStyle='rgba(20,20,20,0.9)'; ctx.strokeStyle='#556'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.roundRect(b2x,by,bw,bh,8); ctx.fill(); ctx.stroke();
    ctx.fillStyle='#aaa'; ctx.font='bold 13px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText('ESC  STAGE SELECT',b2x+bw/2,by+26);
    ctx.restore();
  }
}

// ===== ショップ画面 =====
const SHOP_ITEM_COLORS=['#00ffcc','#ff4455','#00ff88','#44aaff','#ffdd00','#ff8833'];
const SHOP_ITEM_ICONS=['▲','★','◆','→','◎','⚡'];
function drawShopScreen(){
  const t=frameCount;

  // ── 背景: SF グリッド ──
  ctx.fillStyle='#020408'; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='rgba(0,180,255,0.045)'; ctx.lineWidth=1;
  for(let x=0;x<W;x+=40){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
  for(let y=0;y<H;y+=40){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }
  // コーナー装飾
  [[0,0,1,1],[W,0,-1,1],[0,H,1,-1],[W,H,-1,-1]].forEach(([cx,cy,sx,sy])=>{
    ctx.strokeStyle='rgba(255,140,0,0.5)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(cx+sx*6,cy); ctx.lineTo(cx+sx*36,cy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx,cy+sy*6); ctx.lineTo(cx,cy+sy*36); ctx.stroke();
  });
  // スキャンライン
  const scanY=((t*1.8)%H);
  const scanGrad=ctx.createLinearGradient(0,scanY-40,0,scanY+40);
  scanGrad.addColorStop(0,'rgba(255,140,0,0)');
  scanGrad.addColorStop(0.5,'rgba(255,140,0,0.06)');
  scanGrad.addColorStop(1,'rgba(255,140,0,0)');
  ctx.fillStyle=scanGrad; ctx.fillRect(0,scanY-40,W,80);

  // ── ヘッダー ──
  // 中央タイトル
  ctx.save();
  ctx.shadowColor='#ff8833'; ctx.shadowBlur=40;
  ctx.fillStyle='#ff8833'; ctx.font='bold 30px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('UPGRADE  SHOP',W/2,36); ctx.shadowBlur=0;
  // 左右のデコレーションライン
  ctx.strokeStyle='#ff8833'; ctx.lineWidth=1; ctx.globalAlpha=0.5;
  ctx.beginPath(); ctx.moveTo(30,28); ctx.lineTo(200,28); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(W-30,28); ctx.lineTo(W-200,28); ctx.stroke();
  ctx.globalAlpha=1;
  ctx.restore();

  // ── リソースバー ──
  const resData=[
    {v:`${coins.toLocaleString()}`,icon:'●',col:'#ffdd00',bg:'rgba(60,50,0,0.8)'},
    {v:`${gems}`,icon:'💎',col:'#cc88ff',bg:'rgba(50,0,80,0.8)'},
    {v:`${materials.scrap||0}`,icon:'🔩',col:'#bbbbbb',bg:'rgba(30,30,30,0.8)'},
    {v:`${materials.core||0}`,icon:'⚡',col:'#44ccff',bg:'rgba(0,30,60,0.8)'},
    {v:`${materials.crystal||0}`,icon:'💠',col:'#cc88ff',bg:'rgba(40,0,60,0.8)'},
    {v:`${materials.composite||0}`,icon:'🔷',col:'#ffaa44',bg:'rgba(60,30,0,0.8)'},
  ];
  const rbW=108, rbH=28, rbGap=8, rbStartX=(W-(resData.length*(rbW+rbGap)-rbGap))/2;
  resData.forEach((r,i)=>{
    const rx=rbStartX+i*(rbW+rbGap), ry=48;
    ctx.fillStyle=r.bg; ctx.strokeStyle=r.col+'55'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(rx,ry,rbW,rbH,14); ctx.fill(); ctx.stroke();
    ctx.fillStyle=r.col; ctx.font='bold 12px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`${r.icon} ${r.v}`,rx+rbW/2,ry+19);
  });

  // ── タブ ──
  const tabLabels=['◈  UPGRADE','◆  COMPOSE'];
  tabLabels.forEach((label,i)=>{
    const active=shopTab===i;
    const tx=i===0?30:W/2+4, tw=W/2-34;
    const pulse=active?(0.9+Math.sin(t*0.08)*0.1):1;
    ctx.save();
    if(active){
      ctx.shadowColor=SHOP_ITEM_COLORS[0]; ctx.shadowBlur=16*pulse;
      ctx.fillStyle=`rgba(60,28,0,0.95)`;
    } else {
      ctx.fillStyle='rgba(10,10,18,0.85)';
    }
    ctx.strokeStyle=active?'#ff8833':'#2a2a3a'; ctx.lineWidth=active?2:1;
    ctx.beginPath(); ctx.roundRect(tx,82,tw,26,4); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    // アクティブタブ下ライン
    if(active){
      ctx.strokeStyle='#ff8833'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(tx+8,108); ctx.lineTo(tx+tw-8,108); ctx.stroke();
    }
    ctx.fillStyle=active?'#ff8833':'#444'; ctx.font=`bold ${active?13:11}px Orbitron,Courier New`;
    ctx.textAlign='center'; ctx.fillText(`[ ${i===0?'Q':'E'} ]  ${label}`,tx+tw/2,100);
    ctx.restore();
  });

  if(shopTab===0){
    // ══════════════════════════════════════
    // UPGRADE タブ
    // ══════════════════════════════════════
    SHOP_ITEMS.forEach((item,i)=>{
      const active=shopCursor===i;
      const lv=shopUpgrades[item.id]||0;
      const maxed=lv>=SHOP_MAX_LV;
      const [cost,mats,stReq]=getUpgradeLvCost(lv);
      const locked=highestStage<stReq&&!maxed;
      const affordable=canUpgradeShopItem(item);
      const ic=SHOP_ITEM_COLORS[i];
      const y=116+i*78;
      const cardH=70;

      // カード背景グラデ
      ctx.save();
      const grad=ctx.createLinearGradient(30,y,W-30,y);
      if(active){
        grad.addColorStop(0,`rgba(${hexToRgb(ic)},0.18)`);
        grad.addColorStop(0.35,`rgba(${hexToRgb(ic)},0.09)`);
        grad.addColorStop(1,'rgba(4,6,14,0.95)');
      } else {
        grad.addColorStop(0,'rgba(8,10,20,0.92)');
        grad.addColorStop(1,'rgba(4,6,12,0.88)');
      }
      ctx.fillStyle=grad;
      ctx.strokeStyle=active?ic:(maxed?'#225522':locked?'#2a1a00':'#1a1a2e');
      ctx.lineWidth=active?2:1;
      if(active){ ctx.shadowColor=ic; ctx.shadowBlur=18; }
      ctx.beginPath(); ctx.roundRect(30,y,740,cardH,6); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;

      // 左: アイコン六角形
      const iconX=62, iconY=y+cardH/2;
      ctx.shadowColor=locked?'#333':(maxed?'#00ff88':ic); ctx.shadowBlur=locked?0:12;
      ctx.fillStyle=locked?'#1a1a1a':(maxed?'rgba(0,60,30,0.9)':`rgba(${hexToRgb(ic)},0.15)`);
      ctx.strokeStyle=locked?'#2a2a2a':(maxed?'#00ff88':ic); ctx.lineWidth=1.5;
      drawHexagon(ctx,iconX,iconY,18); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      ctx.fillStyle=locked?'#333':(maxed?'#00ff88':ic);
      ctx.font='bold 14px Orbitron,Courier New'; ctx.textAlign='center';
      ctx.fillText(locked?'🔒':(maxed?'✓':SHOP_ITEM_ICONS[i]),iconX,iconY+5);

      // ラベル & 説明
      ctx.fillStyle=maxed?'#00ff88':locked?'#444':(active?'#fff':'#ccc');
      ctx.font=`bold ${active?15:14}px Orbitron,Courier New`; ctx.textAlign='left';
      ctx.fillText(item.label,90,y+24);
      ctx.fillStyle=locked?'#333':'#445'; ctx.font='10px Orbitron,Courier New';
      ctx.fillText(item.desc,90,y+40);

      // Lvバー (10セグメント)
      const barX=90, barY=y+50, segW=22, segH=8, segGap=3;
      for(let l=0;l<SHOP_MAX_LV;l++){
        let segCol;
        if(l>=lv) segCol='#12121e';
        else if(l<3) segCol='#556688';
        else if(l<6) segCol=ic;
        else if(l<9) segCol='#ff4444';
        else segCol='#ffdd00';
        const pulse2=active&&l===lv-1?(0.7+Math.sin(t*0.15)*0.3):1;
        ctx.globalAlpha=pulse2;
        ctx.fillStyle=segCol;
        if(l<lv){ ctx.shadowColor=segCol; ctx.shadowBlur=l>=6?6:0; }
        ctx.beginPath(); ctx.roundRect(barX+l*(segW+segGap),barY,segW,segH,2); ctx.fill();
        ctx.shadowBlur=0; ctx.globalAlpha=1;
      }
      ctx.fillStyle=locked?'#443':maxed?'#00ff88':'#556';
      ctx.font='bold 9px Orbitron,Courier New'; ctx.textAlign='left';
      ctx.fillText(`Lv ${lv}`,barX+SHOP_MAX_LV*(segW+segGap)+6,barY+8);

      // 右: コスト / MAX / ロック
      ctx.textAlign='right';
      if(maxed){
        ctx.shadowColor='#00ff88'; ctx.shadowBlur=12;
        ctx.fillStyle='#00ff88'; ctx.font='bold 15px Orbitron,Courier New';
        ctx.fillText('✓ MAX',W-38,y+38); ctx.shadowBlur=0;
      } else if(locked){
        ctx.fillStyle='#443'; ctx.font='10px Orbitron,Courier New';
        ctx.fillText(`LOCKED  St.${stReq}+`,W-38,y+38);
      } else {
        // コイン
        const hasCoin=coins>=cost;
        ctx.fillStyle=hasCoin?'#ffdd00':'#554';
        ctx.font='bold 13px Orbitron,Courier New';
        ctx.fillText(`● ${cost.toLocaleString()}`,W-38,y+22);
        // 素材チップ
        let chipX=W-38;
        Object.entries(mats).forEach(([k,v])=>{
          const have=k==='gems'?gems:(materials[k]||0);
          const cc=have>=v?(MAT_COLOR[k]||'#aaa'):'#442';
          const label=k==='gems'?`💎×${v}`:`${({'scrap':'🔩','core':'⚡','crystal':'💠','composite':'🔷'}[k]||k)}×${v}`;
          ctx.fillStyle=cc; ctx.font='11px Orbitron,Courier New';
          ctx.fillText(label,chipX,y+40); chipX-=ctx.measureText(label).width+10;
        });
        // UPGRADE ボタン
        if(active){
          const btnCol=affordable?ic:'#334';
          ctx.shadowColor=affordable?ic:'transparent'; ctx.shadowBlur=affordable?14:0;
          ctx.fillStyle=affordable?`rgba(${hexToRgb(ic)},0.25)`:'rgba(10,10,20,0.7)';
          ctx.strokeStyle=btnCol; ctx.lineWidth=1.5;
          ctx.beginPath(); ctx.roundRect(W-150,y+50,118,16,4); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
          ctx.fillStyle=affordable?ic:'#334'; ctx.font='bold 10px Orbitron,Courier New';
          ctx.textAlign='center';
          ctx.fillText(affordable?'ENTER  ▶  UPGRADE':'素材不足',W-91,y+62);
        }
      }
      ctx.restore();
    });

  } else {
    // ══════════════════════════════════════
    // COMPOSE タブ
    // ══════════════════════════════════════
    ctx.save();
    // 背景パネル
    const panelG=ctx.createLinearGradient(160,120,640,460);
    panelG.addColorStop(0,'rgba(30,18,0,0.95)');
    panelG.addColorStop(1,'rgba(10,8,0,0.95)');
    ctx.fillStyle=panelG; ctx.strokeStyle='#ffaa4488'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.roundRect(160,120,480,340,14); ctx.fill(); ctx.stroke();
    // コーナー
    [[160,120],[640,120],[160,460],[640,460]].forEach(([cx,cy])=>{
      ctx.strokeStyle='#ffaa44'; ctx.lineWidth=2;
      const sx=cx===160?1:-1, sy=cy===120?1:-1;
      ctx.beginPath(); ctx.moveTo(cx,cy+sy*6); ctx.lineTo(cx,cy+sy*20); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cx+sx*6,cy); ctx.lineTo(cx+sx*20,cy); ctx.stroke();
    });

    ctx.textAlign='center';
    // タイトル
    ctx.shadowColor='#ffaa44'; ctx.shadowBlur=20;
    ctx.fillStyle='#ffaa44'; ctx.font='bold 18px Orbitron,Courier New';
    ctx.fillText('◆  COMPOSITE  CORE  SYNTHESIS',W/2,152); ctx.shadowBlur=0;

    // 矢印: 素材 → コア
    const haveScrap=materials.scrap||0, haveCore=materials.core||0;
    const canCompose=haveScrap>=5&&haveCore>=3;

    // 素材カード
    [{mat:'🔩 スクラップ',need:5,have:haveScrap,col:MAT_COLOR.scrap},
     {mat:'⚡ エネルギーコア',need:3,have:haveCore,col:MAT_COLOR.core}].forEach((r,ri)=>{
      const cx=W/2-(ri===0?120:-120), cy=220;
      const enough=r.have>=r.need;
      ctx.shadowColor=enough?r.col:'transparent'; ctx.shadowBlur=enough?10:0;
      ctx.fillStyle=enough?`rgba(${hexToRgb(r.col)},0.15)`:'rgba(15,15,15,0.9)';
      ctx.strokeStyle=enough?r.col:'#333'; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.roundRect(cx-80,cy-30,160,60,8); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
      ctx.fillStyle=enough?r.col:'#443'; ctx.font='bold 13px Orbitron,Courier New';
      ctx.fillText(r.mat,cx,cy-6);
      ctx.fillStyle=enough?'#fff':'#554'; ctx.font='11px Orbitron,Courier New';
      ctx.fillText(`×${r.need}  (所持: ${r.have})`,cx,cy+14);
    });
    // + 記号
    ctx.fillStyle='#665'; ctx.font='bold 24px Orbitron,Courier New';
    ctx.fillText('+',W/2,228);
    // 矢印
    const arrowPulse=canCompose?(0.7+Math.sin(t*0.12)*0.3):0.3;
    ctx.globalAlpha=arrowPulse;
    ctx.fillStyle=canCompose?'#ffaa44':'#333'; ctx.font='28px Orbitron,Courier New';
    ctx.fillText('↓',W/2,278);
    ctx.globalAlpha=1;

    // 出力カード
    const pulse=canCompose?(0.85+Math.sin(t*0.1)*0.15):1;
    ctx.shadowColor=canCompose?'#ffaa44':'transparent'; ctx.shadowBlur=canCompose?20*pulse:0;
    ctx.fillStyle=canCompose?'rgba(70,35,0,0.95)':'rgba(15,12,5,0.9)';
    ctx.strokeStyle=canCompose?'#ffaa44':'#332'; ctx.lineWidth=canCompose?2:1;
    ctx.beginPath(); ctx.roundRect(W/2-90,295,180,70,10); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=canCompose?'#ffaa44':'#443'; ctx.font='bold 15px Orbitron,Courier New';
    ctx.fillText('🔷 コンポジットコア',W/2,323);
    ctx.fillStyle=canCompose?'#cc8833':'#332'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText('× 1  獲得',W/2,344);

    // 合成ボタン
    const btnPulse=canCompose?(0.8+Math.sin(t*0.15)*0.2):1;
    ctx.shadowColor=canCompose?'#ffaa44':'transparent'; ctx.shadowBlur=canCompose?22*btnPulse:0;
    ctx.fillStyle=canCompose?'rgba(90,45,0,0.95)':'rgba(15,15,15,0.8)';
    ctx.strokeStyle=canCompose?'#ffaa44':'#222'; ctx.lineWidth=canCompose?2:1;
    ctx.beginPath(); ctx.roundRect(W/2-110,384,220,44,10); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    ctx.fillStyle=canCompose?'#ffdd88':'#333'; ctx.font=`bold ${canCompose?14:12}px Orbitron,Courier New`;
    ctx.fillText(canCompose?'[ ENTER ]  合成する':'素材不足',W/2,411);

    // 所持数 & 用途
    ctx.fillStyle='#556'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(`現在の 🔷: ${materials.composite||0}個  /  Lv9→10 アップグレードに使用`,W/2,448);
    ctx.restore();
  }

  // フッター
  ctx.fillStyle='rgba(255,140,0,0.12)'; ctx.fillRect(0,H-28,W,28);
  ctx.strokeStyle='rgba(255,140,0,0.2)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(0,H-28); ctx.lineTo(W,H-28); ctx.stroke();
  ctx.fillStyle='#554'; ctx.font='10px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText('[ Q / E ]  TAB    [ ↑↓ ]  SELECT    [ ENTER ]  UPGRADE / COMPOSE    [ ESC ]  BACK',W/2,H-10);
  ctx.textAlign='left'; ctx.lineWidth=1;
}

// ===== ウェーブバナー =====
function drawWaveBanner(){
  if(waveBannerTimer<=0||stageType==='survival'||stageType==='boss_rush') return;
  const alpha=Math.min(1,waveBannerTimer/20)*Math.min(1,(waveBannerTimer)/20);
  ctx.save(); ctx.globalAlpha=alpha;
  const p=getPlanet(stage);
  ctx.shadowColor=p.accent; ctx.shadowBlur=20;
  ctx.fillStyle=p.accent; ctx.font='bold 32px Orbitron,Courier New'; ctx.textAlign='center';
  const maxWave=getWaveCount();
  ctx.fillText(waveNum<maxWave?`WAVE  ${waveNum}  /  ${maxWave}`:`FINAL  WAVE  —  BOSS  INCOMING`,W/2,H/2-60);
  ctx.shadowBlur=0; ctx.restore();
}

// ===== ループ =====
function loop(){ runUpdate(); draw(); requestAnimationFrame(loop); }

const hudEl=document.getElementById('hud');
const hiScoreSpan=document.createElement('span');
hiScoreSpan.innerHTML=`HI: <span id="hiscore">${hiScore}</span>`;
if(hudEl) hudEl.insertBefore(hiScoreSpan,hudEl.firstChild);

initStars();
state='title';
loop();

let missionClaimedSet=new Set();
function initMissions(){
  const pool=[...MISSION_POOL].sort(()=>Math.random()-0.5);
  sessionMissions=pool.slice(0,3);
  sessionProgress={kills:0,maxCombo:0,noDmgStages:0,bossKills:0,stageClears:0,ultimateUses:0,maxWave:0};
  missionClaimedSet=new Set();
}
function checkAndClaimMissions(){
  sessionMissions.forEach((m,i)=>{
    if(missionClaimedSet.has(i)) return;
    if(m.check(sessionProgress)){
      missionClaimedSet.add(i);
      addCoins(m.reward.coins);
      if(m.reward.dust>0){ gachaStardust+=m.reward.dust; saveGachaData(); }
      if(m.reward.gems>0) addGems(m.reward.gems);
      lifeGainDisplay={text:`MISSION: ${m.label}  +${m.reward.coins}C${m.reward.gems?` +${m.reward.gems}💎`:''}`,timer:200,color:'#ff0'};
    }
  });
}


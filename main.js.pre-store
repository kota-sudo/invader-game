function getTheme(){
  const p=getPlanet(stage);
  return {bg:p.bg,accent:p.accent,nebula:p.nebula,ground:p.ground};
}

// ===== 武器（ロードアウト由来の弾薬・WEAPONS 定数は game-data）=====
let weaponIdx=0;
let weaponAmmo={laser:0,homing:0,explosive:0};
function currentWeapon(){ return WEAPONS[weaponIdx]; }
function cycleWeapon(){
  for(let i=1;i<=WEAPONS.length;i++){
    const next=(weaponIdx+i)%WEAPONS.length;
    const w=WEAPONS[next];
    if(w==='normal'||weaponAmmo[w]>0){ weaponIdx=next; return; }
  }
}
function getAvailableWeapons(){ return WEAPONS.filter(w=>w==='normal'||weaponAmmo[w]>0); }

// ===== 音声 =====
let audioCtx = null;
function initAudio(){
  try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){}
}
function beep(freq,type,dur,vol,delay=0){
  if(!audioCtx) return;
  const o=audioCtx.createOscillator(),g=audioCtx.createGain();
  o.connect(g); g.connect(audioCtx.destination);
  o.type=type;
  o.frequency.setValueAtTime(freq, audioCtx.currentTime+delay);
  g.gain.setValueAtTime(vol, audioCtx.currentTime+delay);
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+delay+dur);
  o.start(audioCtx.currentTime+delay);
  o.stop(audioCtx.currentTime+delay+dur+0.01);
}
function noiseSound(dur,vol){
  if(!audioCtx) return;
  const len=Math.floor(audioCtx.sampleRate*dur);
  const buf=audioCtx.createBuffer(1,len,audioCtx.sampleRate);
  const d=buf.getChannelData(0);
  for(let i=0;i<len;i++) d[i]=(Math.random()*2-1);
  const src=audioCtx.createBufferSource(),g=audioCtx.createGain();
  src.buffer=buf; src.connect(g); g.connect(audioCtx.destination);
  g.gain.setValueAtTime(vol,audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);
  src.start(); src.stop(audioCtx.currentTime+dur+0.01);
}
function playSound(type){
  if(!audioCtx) return;
  switch(type){
    case 'shoot':        beep(880,'square',0.07,0.12); break;
    case 'shoot_charge': beep(220,'sawtooth',0.05,0.25); beep(440,'sawtooth',0.08,0.2,0.05); beep(880,'square',0.12,0.25,0.1); break;
    case 'shoot_laser':  beep(1400,'sawtooth',0.12,0.18); beep(900,'sawtooth',0.12,0.1,0.02); break;
    case 'shoot_homing': beep(660,'sine',0.08,0.14); beep(880,'sine',0.08,0.1,0.06); break;
    case 'shoot_expl':   beep(350,'square',0.1,0.18); break;
    case 'explosion':    noiseSound(0.18,0.28); beep(100,'sawtooth',0.18,0.18); break;
    case 'boss_hit':     beep(180,'square',0.08,0.25); noiseSound(0.04,0.08); break;
    case 'boss_die':     noiseSound(0.5,0.4); [100,150,200,260,320,400,500,600].forEach((f,i)=>beep(f,'sawtooth',0.3,0.25,i*0.06)); break;
    case 'powerup':      [440,550,660,880].forEach((f,i)=>beep(f,'sine',0.1,0.2,i*0.08)); break;
    case 'upgrade_pick': [660,880,1100,1320].forEach((f,i)=>beep(f,'sine',0.12,0.22,i*0.07)); break;
    case 'player_hit':   noiseSound(0.25,0.35); beep(130,'sawtooth',0.25,0.28); break;
    case 'stage_clear':  [523,659,784,1047].forEach((f,i)=>beep(f,'sine',0.18,0.3,i*0.13)); break;
    case 'gameover':     [440,370,330,220].forEach((f,i)=>beep(f,'square',0.22,0.28,i*0.16)); break;
    case 'healer_die':   beep(330,'sine',0.08,0.18); beep(440,'sine',0.08,0.18,0.06); break;
    case 'event_start':  beep(440,'square',0.08,0.2); beep(660,'square',0.08,0.2,0.1); break;
    case 'dash':         beep(600,'sine',0.06,0.15); beep(800,'sine',0.04,0.1,0.04); break;
    case 'levelup':      [523,659,784,523,659,784,1047].forEach((f,i)=>beep(f,'sine',0.1,0.25,i*0.07)); break;
    case 'asteroid_hit': noiseSound(0.12,0.2); beep(150,'sawtooth',0.1,0.15); break;
    case 'boss_teleport':beep(800,'sine',0.04,0.2); beep(400,'sine',0.08,0.2,0.04); break;
    case 'boss_shield':  beep(300,'square',0.1,0.2); beep(500,'square',0.1,0.2,0.05); break;
    case 'boss_split':   noiseSound(0.3,0.3); beep(200,'sawtooth',0.3,0.3); break;
    case 'charge_full':  beep(1200,'sine',0.05,0.2); break;
  }
}

// BGM
// BGM: 2フレーズ交互でループ、サイン波・低音量でアンビエント風
let bgmIdx=0,bgmPhraseIdx=0,bgmTimer=null,bgmOn=false;
let bgmBassIdx=0,bgmBassTimer=null;
function startBGM(){
  if(!audioCtx||bgmOn) return;
  bgmOn=true; bgmIdx=0; bgmPhraseIdx=0; bgmBassIdx=0;
  bgmTick(); bgmBassTick();
}
function bgmTick(){
  if(!bgmOn) return;
  const phrase=BGM_PHRASES[bgmPhraseIdx%BGM_PHRASES.length];
  const [f,ms]=phrase[bgmIdx%phrase.length];
  const tempo=Math.max(0.65,1-(stage-1)*0.03);
  const pitch=1+Math.floor((stage-1)/5)*0.25;
  if(f>0) beep(f*pitch,'sine',ms*tempo*0.001*0.75,0.022);
  const nextIdx=bgmIdx+1;
  if(nextIdx>=phrase.length){ bgmIdx=0; bgmPhraseIdx++; }
  else { bgmIdx=nextIdx; }
  bgmTimer=setTimeout(bgmTick,ms*tempo);
}
function bgmBassTick(){
  if(!bgmOn) return;
  const bassLine=BGM_BASS[bgmPhraseIdx%BGM_BASS.length];
  const [f,ms]=bassLine[bgmBassIdx%bassLine.length];
  const tempo=Math.max(0.65,1-(stage-1)*0.03);
  if(f>0) beep(f,'triangle',ms*tempo*0.001*0.7,0.014);
  bgmBassIdx++;
  bgmBassTimer=setTimeout(bgmBassTick,ms*tempo);
}
function stopBGM(){
  bgmOn=false;
  if(bgmTimer){clearTimeout(bgmTimer);bgmTimer=null;}
  if(bgmBassTimer){clearTimeout(bgmBassTimer);bgmBassTimer=null;}
}

let playerUpgrades={speed:0,firerate:0,damage:1,spread:false,invincibleBonus:0,bulletSpd:0};
let upgradeChoices=[];
function isUpgradeMaxed(id){
  switch(id){
    case 'speed':    return playerUpgrades.speed>=4;
    case 'firerate': return playerUpgrades.firerate>=4;
    case 'damage':   return playerUpgrades.damage>=5;
    case 'bulletspd':return playerUpgrades.bulletSpd>=9;
    case 'spread':   return playerUpgrades.spread;
    default:         return false;
  }
}
function pickUpgradeChoices(){
  // 上限済みを除外し、未出現を優先する
  const available=UPGRADE_POOL.filter(u=>!isUpgradeMaxed(u.id));
  const unseen=available.filter(u=>!seenUpgradeIds.has(u.id));
  const seen=available.filter(u=>seenUpgradeIds.has(u.id));
  const pool=[...unseen.sort(()=>Math.random()-0.5),...seen.sort(()=>Math.random()-0.5)];
  // 既出かつ上限未満のものは「強化版」ラベルを付与
  upgradeChoices=pool.slice(0,3).map(u=>{
    if(seenUpgradeIds.has(u.id)&&!isUpgradeMaxed(u.id)){
      return {...u,label:u.label+' ++',enhanced:true};
    }
    return {...u,enhanced:false};
  });
}
function applyUpgrade(idx){
  if(idx>=upgradeChoices.length) return;
  const up=upgradeChoices[idx];
  const mult=up.enhanced?2:1;
  seenUpgradeIds.add(up.id);
  playSound('upgrade_pick');
  switch(up.id){
    case 'speed':      playerUpgrades.speed=Math.min(playerUpgrades.speed+mult,4); break;
    case 'firerate':   playerUpgrades.firerate=Math.min(playerUpgrades.firerate+mult,4); break;
    case 'life':       playerStats.hp=Math.min(playerStats.maxHp,playerStats.hp+30*mult); updateHUD(); break;
    case 'laser':      weaponAmmo.laser+=15*mult; break;
    case 'homing':     weaponAmmo.homing+=8*mult; break;
    case 'explosive':  weaponAmmo.explosive+=8*mult; break;
    case 'damage':     playerUpgrades.damage=Math.min(playerUpgrades.damage+mult,5); break;
    case 'spread':     playerUpgrades.spread=true; break;
    case 'invincible': playerUpgrades.invincibleBonus+=60*mult; break;
    case 'bulletspd':  playerUpgrades.bulletSpd=Math.min(playerUpgrades.bulletSpd+3*mult,9); break;
    case 'shieldUp':   playerShield=true; break;
  }
  genMapRoutes();
  state='map';
}


function saveCoins(){ localStorage.setItem('invader_coins',coins); }
function saveGems(){ localStorage.setItem('invader_gems',String(gems)); }
function addGems(amount){ gems+=amount; saveGems(); updateHUD(); }
function saveGachaData(){
  localStorage.setItem('invader_gacha_inv',JSON.stringify(gachaInventory));
  localStorage.setItem('invader_gacha_mat',JSON.stringify(gachaMaterials));
  localStorage.setItem('invader_stardust',String(gachaStardust));
}
function addCoins(amount){
  const boost=(gachaInventory['passive_coin']?.level>=1?1.25:1)*(getPetEffect('fairy')?1.2:1);
  coins+=Math.floor(amount*boost);
  saveCoins();
  const el=document.getElementById('coins');
  if(el) el.textContent=coins;
}
function gachaRollRarity(forceSR=false, forceSSR=false, forceLR=false){
  if(forceLR) return 'LR';
  if(forceSSR) return 'SSR';
  const r=Math.random();
  if(forceSR) return r<0.25?'SSR':'SR';
  if(r<0.005) return 'LR';
  if(r<0.05)  return 'SSR';
  if(r<0.20)  return 'SR';
  if(r<0.50)  return 'R';
  return 'N';
}
function premiumRollRarity(forceSR=false,forceSSR=false,forceLR=false){
  if(forceLR) return 'LR';
  if(forceSSR) return 'SSR';
  const r=Math.random();
  if(forceSR) return r<0.40?'SSR':'SR';
  if(r<0.015) return 'LR';
  if(r<0.20)  return 'SSR';
  if(r<0.75)  return 'SR';
  return 'R';
}
function gachaRollOne(forceSR=false, forceSSR=false, forceLR=false){
  const rarity=gachaRollRarity(forceSR, forceSSR, forceLR);
  const pool=ALL_GACHA_POOL.filter(i=>i.rarity===rarity);
  return pool[Math.floor(Math.random()*pool.length)]||ALL_GACHA_POOL[0];
}
function premiumRollOne(forceSR=false,forceSSR=false,forceLR=false){
  const rarity=premiumRollRarity(forceSR,forceSSR,forceLR);
  let pool=PREMIUM_POOL.filter(i=>i.rarity===rarity);
  // ピックアップ: 対象レアリティ内で50%確率でフィーチャーアイテム優先
  if(rarity==='SSR'&&Math.random()<0.5){
    const pk=PREMIUM_POOL.find(i=>i.id===currentPickupId&&i.rarity==='SSR');
    if(pk) return pk;
  }
  return pool[Math.floor(Math.random()*pool.length)]||PREMIUM_POOL[0];
}
function doPremiumPull(count){
  const cost=count===1?5:50; // gems
  if(gems<cost) return false;
  gems-=cost; saveGems(); updateHUD();
  gachaResults=[]; gachaNewItems=new Set(); gachaIsPremium=true;
  let hasSR=false;
  for(let i=0;i<count;i++){
    const forcePity=premiumPityCount>=50;
    const forceLRPity=premiumLrPityCount>=100;
    const force10SR=count===10&&i===9&&!hasSR;
    const item=premiumRollOne(force10SR,forcePity&&!forceLRPity,forceLRPity);
    premiumPityCount++;
    premiumLrPityCount++;
    if(item.rarity==='LR'){ premiumPityCount=0; premiumLrPityCount=0; }
    else if(item.rarity==='SSR') premiumPityCount=0;
    if(item.rarity==='LR'||item.rarity==='SSR'||item.rarity==='SR') hasSR=true;
    gachaResults.push(item);
    addGachaItem(item);
  }
  savePremiumPity(); saveLrPity();
  gachaCurrentIdx=0; gachaAnimFrame=0;
  state='gacha_result';
  if(gachaResults.some(r=>r.rarity==='LR')) playSound('boss_die');
  else if(gachaResults.some(r=>r.rarity==='SSR')) playSound('boss_die');
  else playSound('powerup');
  return true;
}
// デイリーガチャ
function canDailyGacha(){
  return localStorage.getItem('invader_daily_gacha')!==new Date().toISOString().split('T')[0];
}
function doDailyGacha(){
  if(!canDailyGacha()) return;
  // N〜R限定
  const pool=ALL_GACHA_POOL.filter(i=>i.rarity==='R'||i.rarity==='N');
  if(!pool.length) return;
  localStorage.setItem('invader_daily_gacha',new Date().toISOString().split('T')[0]);
  const item=pool[Math.floor(Math.random()*pool.length)];
  gachaResults=[item]; gachaNewItems=new Set(); gachaIsPremium=false;
  addGachaItem(item);
  gachaCurrentIdx=0; gachaAnimFrame=0;
  state='gacha_result';
  playSound('powerup');
}
function addGachaItem(item){
  if(!item||!item.id||!item.rarity) return;
  const isNew=!gachaInventory[item.id];
  if(isNew){
    gachaInventory[item.id]={level:1,mat:0};
    gachaNewItems.add(item.id);
  } else if(gachaInventory[item.id].level<30){
    gachaInventory[item.id].mat=(gachaInventory[item.id].mat||0)+1;
    gachaMaterials[item.rarity]=(gachaMaterials[item.rarity]||0)+1;
  } else {
    gachaStardust+={LR:200,SSR:50,SR:20,R:10,N:5}[item.rarity]||5;
  }
  saveGachaData();
}
function getLevelUpCost(item){
  const inv=gachaInventory[item.id]; if(!inv) return null;
  const lv=inv.level||1;
  if(lv>=30) return null;
  const dustCost={LR:50,SSR:20,SR:10,R:5,N:2}[item.rarity]*(1+Math.floor(lv/5));
  const coinCost=200*(1+Math.floor(lv/10));
  return {dust:dustCost,coins:coinCost};
}
function tryLevelUpItem(item){
  if(!item||!gachaInventory[item.id]) return;
  const cost=getLevelUpCost(item);
  if(!cost) return;
  if(gachaStardust<cost.dust||coins<cost.coins) return;
  gachaStardust-=cost.dust; coins-=cost.coins; saveCoins();
  gachaInventory[item.id].level++;
  saveGachaData(); updateHUD();
}
function getItemLevelBonus(itemId){
  const inv=gachaInventory[itemId]; if(!inv) return 0;
  return (inv.level-1)*0.01; // +1% per level over 1
}
function doGachaPull(count){
  const cost=count===1?500:5000;
  if(coins<cost) return false;
  coins-=cost; saveCoins();
  const el=document.getElementById('coins');
  if(el) el.textContent=coins;
  gachaResults=[]; gachaNewItems=new Set();
  let hasSR=false;
  for(let i=0;i<count;i++){
    const forcePity=gachaPityCount>=79;
    const forceLRPity=lrPityCount>=199;
    const force10SR=count===10&&i===9&&!hasSR;
    const item=gachaRollOne(force10SR, forcePity&&!forceLRPity, forceLRPity);
    gachaPityCount++;
    lrPityCount++;
    if(item.rarity==='LR'){ gachaPityCount=0; lrPityCount=0; }
    else if(item.rarity==='SSR'){ gachaPityCount=0; }
    if(item.rarity==='LR'||item.rarity==='SSR'||item.rarity==='SR') hasSR=true;
    gachaResults.push(item);
    addGachaItem(item);
  }
  savePity(); saveLrPity();
  gachaCurrentIdx=0; gachaAnimFrame=0;
  state='gacha_result';
  if(gachaResults.some(r=>r.rarity==='LR')) playSound('boss_die');
  else if(gachaResults.some(r=>r.rarity==='SSR')) playSound('boss_die');
  else playSound('powerup');
  return true;
}

// ===== EXP / レベル =====
let exp=0, playerLevel=1;
let levelUpDisplay=null;
function addExp(amount){
  const expBoost=(gachaInventory['passive_exp']?.level>=1?1.2:1)*(getPetEffect('exp')?1.15:1);
  exp+=Math.floor(amount*expBoost);
  const nextThreshold=EXP_TABLE[Math.min(playerLevel,EXP_TABLE.length-1)];
  if(exp>=nextThreshold && playerLevel<10){
    exp-=nextThreshold;
    playerLevel++;
    const bonus=LEVEL_BONUSES[(playerLevel-2)%LEVEL_BONUSES.length];
    // 3択スキル選択を表示
    showSkillChoice();
    triggerFlash(255,220,0,0.25);
    playSound('levelup');
  }
}

// ===== スキル選択システム =====
const SKILL_POOL=[
  {id:'firerate', label:'RAPID FIRE',    desc:'連射速度 +1',       color:'#ff8844', apply:()=>{ playerUpgrades.firerate=Math.min(playerUpgrades.firerate+1,6); }},
  {id:'speed',    label:'ENGINE BOOST',  desc:'移動速度 +1',       color:'#00ffcc', apply:()=>{ playerUpgrades.speed=Math.min(playerUpgrades.speed+1,6); }},
  {id:'damage',   label:'ATK UP',        desc:'攻撃力 +10%',       color:'#ff4444', apply:()=>{ playerUpgrades.damage=Math.min(playerUpgrades.damage+1,8); }},
  {id:'heal',     label:'HULL REPAIR',   desc:'HP +25 回復',       color:'#00ff88', apply:()=>{ playerStats.hp=Math.min(playerStats.maxHp,playerStats.hp+25); updateHUD(); }},
  {id:'bulletspd',label:'RAILGUN MOD',   desc:'弾速 +2',           color:'#44aaff', apply:()=>{ playerUpgrades.bulletSpd=Math.min(playerUpgrades.bulletSpd+2,10); }},
  {id:'spread',   label:'SPREAD SHOT',   desc:'拡散弾を解放',       color:'#ffdd00', apply:()=>{ playerUpgrades.spread=true; }},
  {id:'maxhp',    label:'HULL EXPAND',   desc:'最大HP +20',        color:'#00ff88', apply:()=>{ playerStats.maxHp+=20; playerStats.hp+=20; updateHUD(); }},
  {id:'crit',     label:'TARGETING AI',  desc:'CRIT率 +5%',        color:'#ffdd00', apply:()=>{ playerStats.crit=Math.min(playerStats.crit+5,50); }},
  {id:'shield',   label:'BARRIER',       desc:'バリア 1回付与',     color:'#44aaff', apply:()=>{ playerShield=true; }},
  {id:'magnet',   label:'COIN MAGNET',   desc:'コイン自動吸引',     color:'#ffd700', apply:()=>{ playerUpgrades.magnet=true; }},
];
let skillChoices=null;
function showSkillChoice(){
  const shuffled=[...SKILL_POOL].sort(()=>Math.random()-0.5);
  skillChoices=shuffled.slice(0,3);
}
function applySkill(idx){
  if(!skillChoices||idx<0||idx>=skillChoices.length) return;
  skillChoices[idx].apply();
  levelUpDisplay={text:`LV.${playerLevel}  ${skillChoices[idx].label}`,timer:180,color:'#ff0'};
  skillChoices=null;
}
function drawSkillChoice(){
  if(!skillChoices) return;
  ctx.fillStyle='rgba(0,0,0,0.72)'; ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#ffdd00'; ctx.shadowColor='#ffdd00'; ctx.shadowBlur=20;
  ctx.font='bold 18px Orbitron,Courier New'; ctx.textAlign='center';
  ctx.fillText(`LEVEL UP!  LV.${playerLevel}  —  スキルを選択`,W/2,H/2-120); ctx.shadowBlur=0;
  skillChoices.forEach((sk,i)=>{
    const bx=W/2-310+i*212, by=H/2-90, bw=200, bh=200;
    ctx.fillStyle='rgba(8,8,20,0.95)'; ctx.strokeStyle=sk.color; ctx.lineWidth=2;
    ctx.shadowColor=sk.color; ctx.shadowBlur=16;
    ctx.beginPath(); ctx.roundRect(bx,by,bw,bh,12); ctx.fill(); ctx.stroke(); ctx.shadowBlur=0;
    // キー番号
    ctx.fillStyle=sk.color; ctx.font='bold 28px Orbitron,Courier New'; ctx.textAlign='center';
    ctx.fillText(`[${i+1}]`,bx+bw/2,by+36);
    // アイコン風グロー
    ctx.save(); ctx.globalAlpha=0.18; ctx.fillStyle=sk.color;
    ctx.beginPath(); ctx.arc(bx+bw/2,by+90,44,0,Math.PI*2); ctx.fill(); ctx.restore();
    ctx.fillStyle=sk.color; ctx.shadowColor=sk.color; ctx.shadowBlur=10;
    ctx.font='bold 14px Orbitron,Courier New'; ctx.fillText(sk.label,bx+bw/2,by+106); ctx.shadowBlur=0;
    ctx.fillStyle='#aaa'; ctx.font='11px Orbitron,Courier New';
    ctx.fillText(sk.desc,bx+bw/2,by+130);
    // パルス枠
    const pulse=0.7+Math.sin(frameCount*0.1+i)*0.3;
    ctx.save(); ctx.globalAlpha=pulse*0.4; ctx.strokeStyle=sk.color; ctx.lineWidth=1;
    ctx.beginPath(); ctx.roundRect(bx+4,by+4,bw-8,bh-8,10); ctx.stroke(); ctx.restore();
  });
  ctx.textAlign='left';
}
